{
  "version": "1.0",
  "defaultProvider": "unpkg",
  "libraries": [
    {
      "library": "@microsoft/signalr@latest",
      "destination": "wwwroot/js/signalr/",
      "files": [
        "dist/browser/signalr.js",
        "dist/browser/signalr.min.js"
      ]
    },
    {
      "provider": "cdnjs",
      "library": "jqueryui@1.12.1",
      "destination": "wwwroot/lib/jqueryui/"
    },
    {
      "provider": "cdnjs",
      "library": "elfinder@2.1.57",
      "destination": "wwwroot/lib/elfinder/"
    },
    {
      "provider": "cdnjs",
      "library": "summernote@0.9.0",
      "destination": "wwwroot/lib/summernote/"
    },
    {
      "provider": "cdnjs",
      "library": "jquery-easing@1.4.1",
      "destination": "wwwroot/lib/jquery-easing"
    },
    {
      "provider": "cdnjs",
      "library": "font-awesome@5.2.0",
      "destination": "wwwroot/lib/font-awesome"
    },
    {
      "provider": "cdnjs",
      "library": "multiple-select@1.2.3",
      "destination": "wwwroot/lib/multiple-select/"
    },
    {
      "provider": "cdnjs",
      "library": "clockpicker@0.0.7",
      "destination": "wwwroot/lib/clockpicker/"
    }
  ]
}