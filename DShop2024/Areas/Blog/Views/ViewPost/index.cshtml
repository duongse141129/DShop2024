@model List<PostViewModel>
@using DShop2024.Components
@using DShop2024.ViewModels
@{
    List<SubjectModel> subjects = ViewBag.subjects as List<SubjectModel>;
    SubjectModel subject = ViewBag.Subject as SubjectModel;
    ViewData["Title"] = (subject != null) ? subject.Title : "Post";
    Layout = "~/Areas/Blog/Views/ViewPost/_LayoutBlog.cshtml";
}
                <h1 class="text-primary">@ViewData["Title"]</h1>

                @if(subject != null){
                    <p>@Html.Raw(subject.SubjectContent)</p>
                }
                else
                {
                    <p>List posts in subjects</p>
                }
                <hr/>

                <div id="post-section-container">
                    	<partial name="_PostListPartial" model="Model" />               
                </div>

         
                @section Sidebar{
                   @await Component.InvokeAsync("DShop2024.Components.SubjectSidebar",
                            new SubjectSidebar.SubjectSidebarData{
                                    Subjects =subjects,
                                    level= 0,
                                    subjectSlug= ViewBag.subjectSlug
                   })
                }


@section Scripts {
    <script>
		$(document).on("click", "#post-section-container .ajax-pagination a", function (e) {
			e.preventDefault();
			var url = $(this).attr("href");
			if (!url || url === "#") return;
			$.ajax({
				url: url,
				type: 'GET',
				headers: { "X-Requested-With": "XMLHttpRequest" },
				success: function (data) {
					$('#post-section-container').html(data);
				},
				error: function () {
					Swal.fire({
						icon: "error",
						title: "Error",
						text: "Could not load feedback. Please try again."
					});
				}
			});
		});
	</script>
}











