@model PostModel
@using DShop2024.Components
@using DShop2024.Models.Blog

@{
    List<SubjectModel> subjects = ViewBag.subjects as List<SubjectModel>;
    SubjectModel subject = ViewBag.Subject as SubjectModel;
    ViewData["Title"] = "Detail blog";
    Layout = "~/Areas/Blog/Views/ViewPost/_LayoutBlog.cshtml";

    IQueryable<PostModel> otherPosts = ViewBag.otherPosts as IQueryable<PostModel>;

}



<div class="detailpost">
    <h1>@Model.Title</h1>
    <div>
        <img class="card-img-top w-100" height="500" src="~/media/post/@Model.Image" alt="...">
    </div>
    <div>
        Subject:   @string.Join(", ", Model.PostSubjects.Select(pc => pc.Subject.Title))
    </div>
    <div>
        @Model.ShortDescription
    </div>
    <div>
        <i>Update date: @Model.DateUpdated</i> /
        Create by: <strong>@Model.CreateBy.UserName</strong>
    </div>
    <hr />

    @Html.Raw(Model.PostContent)

</div>



@section Sidebar{
   @await Component.InvokeAsync("DShop2024.Components.SubjectSidebar",
            new SubjectSidebar.SubjectSidebarData{
                    Subjects =subjects,
                    level= 0,
                    subjectSlug= subject.Slug
   })

}