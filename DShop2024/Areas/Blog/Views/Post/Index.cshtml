@model IEnumerable<PostViewModel>

@{
    ViewData["Title"] = "Manage post";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var currentUrl = Url.ActionContext.HttpContext.Request.Path;
}

<h1 class="text-primary">@ViewData["title"]</h1>


<div class="card">

    <div class="card-title px-3">
        <a asp-action="SeedLike" class="btn btn-primary btn-md text-white">Seed like</a>
        @if (User.IsInRole(RoleName.Administrator))
        {
            <a asp-action="SeedComment" class="btn btn-primary btn-md text-white">Seed comment</a>
            <a asp-action="DeleteOrderNoDetail" class="btn btn-primary btn-md text-white">Delete order no detail</a>
            <a asp-action="SeedDescritp" class="btn btn-primary btn-md text-white">Seed Des</a>
            <a asp-action="Create" class="btn btn-primary btn-md text-white">Create post</a>
            <a asp-action="SendPromotionToNewCustomer" class="btn btn-primary btn-md text-white">send coupon  </a>
            <a asp-action="SeedOrder" class="btn btn-primary btn-md text-white">SeedOrder</a>
            <a asp-action="SeedMonth12" class="btn btn-danger btn-md text-white">Remove Order 12  </a>
            <a asp-action="SeedSegment" class="btn btn-primary btn-md text-white">SeedSegment</a>
            <a asp-action="SeedDataStock" class="btn btn-primary btn-md text-white">SeedStock</a>
            <a asp-action="SeedDataAssignment" class="btn btn-primary btn-md text-white">SeedAssign</a>
        }
        <h4>Total posts: @ViewBag.totalPosts</h4>
    </div>

    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                    <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <button type="submit" class="btn btn-search pe-1" id="btnSearch">
                                    <i class="fa fa-search search-icon"></i>
                                </button>
                            </div>
                            <input id="searchInput" type="text" placeholder="Search" class="form-control" name="search" value="@( ViewBag.search != "" ? ViewBag.search  : "" )" />
                        </div>
                    </nav>
 

            </div>
            <div class="col-md-9">
                <div class="form-group pull-right">
                    <label>Subject </label>
                    <select id="subject_by" class="form-control" asp-items="ViewBag.subjects">
                        <option value=""></option>
                    </select>
                </div>
            </div>
        </div>

        <div id ="postRowContainer">
            <partial name="_PostListPartial" model="Model" />
        </div>
    </div>
</div>


@section Scripts{

    <script>
        $(document).ready(function () {
            function loadData(page = 1) {
                var search = $('#searchInput').val();
                var subject = $('#subject_by').val();

                $.ajax({
                    url: '@Url.Action("Index", "Post")',
                    type: 'GET',
                    data: {
                        p: page,
                        search: search,
                        subject_by: subject
                    },
                    success: function (result) {
                        $('#postRowContainer').html(result);
                    }
                });
            }

            $('#subject_by').on('change', function () {
                loadData(1);
            });

            $('#btnSearch').on('click', function () {
                loadData(1);
            });

            $(document).on('click', '#postRowContainer .pagination a', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                var page = new URLSearchParams(url.split('?')[1]).get('p');
                loadData(page);
            });
        });
    </script>

}

