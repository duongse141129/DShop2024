@model DShop2024.Models.Blog.PostModel

@{
    ViewData["Title"] = "Detail post";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="col-md-8">
    <div class="card">
        <div class="card-body">
            <div class="card card-post card-round post-item">
                <img class="card-img-top w-100" src="~/media/post/@Model.Image"  height="500" alt="Card image cap">
                <a asp-action="PinPostDetail" asp-area="Blog" asp-controller="Post" asp-route-id="@Model.Id" class="btn-pin @( Model.IsPin == true ? "bg-warning text-white" : "")">
                    <i class="fas fa-thumbtack"></i>
                </a>
                <div class="card-body">
                    <div class="d-flex">
                        <div class="avatar">
                            <img src="~/media/avatar/@Model.CreateBy.Avatar" alt="avatar" class="avatar-img rounded-circle">
                        </div>
                        <div class="info-post ms-2">
                            <p class="username">@Model.CreateBy.UserName</p>
                            <p class="date text-muted">Create @Model.DateCreated.ToString("MM/dd/yyyy h:mm tt")</p>
                            <p class="date text-muted">Update @Model.DateUpdated.ToString("MM/dd/yyyy h:mm tt")</p>
                        </div>
                    </div>
                    <div class="separator-solid"></div>
                    <p class="card-category text-info mb-1">
                        @string.Join(", ", Model.PostSubjects.Select(pc => pc.Subject.Title))
                    </p>
                    <h3 class="card-title">
                       @Model.Title
                    </h3>
                    <p class="card-text">
                        @Model.ShortDescription
                    </p>
                    <div>
                        @Html.Raw(Model.PostContent)
                    </div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-rounded btn-md pull-right ">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-rounded btn-md pull-right confirmDeletion">Delete</a>

                </div>
            </div>
        </div>
    </div>
    <a asp-action="Index">Back to list post</a>
</div>




