@model PostDetailViewModel

@{
    ViewData["Title"] = "Detail post";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="col-md-8">
    <div class="card">
        <div class="card-body">
            <div class="card card-post card-round post-item">
                @if (Model.PostDetail.Image != null)
                {
                    <img class="card-img-top w-100" src="~/media/post/@Model.PostDetail.Image" height="500" alt="Card image cap">
                }
                <a asp-action="PinPostDetail" asp-area="Blog" asp-controller="Post" asp-route-id="@Model.PostDetail.Id" class="btn-pin @( Model.PostDetail.IsPin == true ? "bg-warning text-white" : "")">
                    <i class="fas fa-thumbtack"></i>
                </a>
                <div class="card-body">
                    <div class="d-flex">
                        <div class="avatar">
                            <img src="~/media/avatar/@Model.PostDetail.Author.Avatar" alt="avatar" class="avatar-img rounded-circle">
                        </div>
                        <div class="info-post ms-2">
                            <p class="username">@Model.PostDetail.Author.UserName</p>
                            <p class="date text-muted">Create @Model.PostDetail.DateCreated.ToString("MM/dd/yyyy h:mm tt")</p>
                            <p class="date text-muted">Update @Model.PostDetail.DateUpdated.ToString("MM/dd/yyyy h:mm tt")</p>
                        </div>
                    </div>
                    <div class="separator-solid"></div>
                    <p class="card-category text-info mb-1">
                        @Model.PostDetail.Subjects
                    </p>
                    <h3 class="card-title">
                        @Model.PostDetail.Title
                    </h3>
                    <p class="card-text">
                        @Model.PostDetail.ShortDescription
                    </p>
                    <div>
                        @Html.Raw(Model.PostDetail.PostContent)
                    </div>
                    <a asp-action="Edit" asp-route-id="@Model.PostDetail.Id" class="btn btn-warning btn-rounded btn-md pull-right ">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.PostDetail.Id" class="btn btn-danger btn-rounded btn-md pull-right confirmDeletion">Delete</a>


                    <div class="row pt-2">
                        <div class="col-md-2">
                            <a class="btn @( Model.Liked == true ? "liked" : "unlike")" id="likeunlikepost" data-post_id="@Model.PostDetail.Id">
                                <i class="fas fa-thumbs-up fa-3x"></i>
                                <span id="liked-count">@Model.PostDetail.CountLikes </span>

                            </a>
                        </div>
                        <div class="col-md-4">
                            <p>
                                <a class="btn btn-primary" data-bs-toggle="collapse" href="#collapseExample" role="button" aria-expanded="false" aria-controls="collapseExample">
                                    Comment
                                </a>
                            </p>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="collapse" id="collapseExample">
                                <div class="card card-body">
                                    <form id="commentForm">
                                        <input type="hidden" name="postId" value="@Model.PostDetail.Id" />
                                        <div class="form-group">
                                            <label class="control-label">Content</label>
                                            <textarea id="commentContent" rows="5" name="content" class="form-control"></textarea>
                                        </div>
                                        <div class="form-group mt-2">
                                            <button type="button" id="btnSubmitComment" class="btn btn-primary btn-lg">Save</button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row pt-3">
                        <div class="col-md-10">
                            <div id="comment-section-container">
                                <partial name="_CommentListPartial" model="Model" />
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <a asp-action="Index">Back to list post</a>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="mainModal">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/custom/js/popup.js"></script>
    <script>
        $(document).ready(function () {
            $('#likeunlikepost').click(function () {
                var postId = $(this).data("post_id");
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("LikeOrUnlikePost", "ViewPost")",
                    data: { postId: postId },
                    success: function (result) {
                        if (result.success) {
                            if(result.message == "liked" ) {
                                $('#likeunlikepost').removeClass("unlike");
                                $('#likeunlikepost').addClass('liked');
                            }
                            else if(result.message == "unlike" ) {
                                $('#likeunlikepost').removeClass("liked");
                                $('#likeunlikepost').addClass('unlike');
                            }
                            $('#liked-count').text(result.count);
                        }
                        else {
                            Swal.fire({
                              icon: "error",
                              title: "Like Unlike fail",
                              text: result.message
                            });
                        }

                    }
                });
            });
        });
    </script>


    <script>
        $(document).on("click", "#comment-section-container .ajax-pagination a", function (e) {
            e.preventDefault();
            var url = $(this).attr("href");
            if (!url || url === "#") return;
            $.ajax({
                url: url,
                type: 'GET',
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function (data) {
                    $('#comment-section-container').html(data);
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Could not load feedback. Please try again."
                    });
                }
            });
        });
    </script>

    <script>
        $('#btnSubmitComment').click(function () {
            var formData = $('#commentForm').serialize();

            $.ajax({
                url: '@Url.Action("CommentPost", "ViewPost")',
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#commentContent').val('');
                        loadComments();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message
                        });
                    }
                }
            });
        });

        function loadComments() {
            $.ajax({
                url: '@Url.Action("Detail", "ViewPost", new { postslug = Model.PostDetail.Slug })',
                type: 'GET',
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function (data) {
                    $('#comment-section-container').html(data);
                }
            });
        }
    </script>


    <script>
        $(document).on('click', '.delete-comment', function () {
            var commentId = $(this).data('id');
            var btn = $(this);

            Swal.fire({
                title: 'Are you sure you want to delete?',
                text: "This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteComment", "Post")',
                        type: 'POST',
                        data: { Id: commentId },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Deleted', response.message, 'success');
                                loadComments();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        }
                    });
                }
            });
        });
    </script>
}
