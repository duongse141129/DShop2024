@model DShop2024.Models.Blog.SubjectModel
@{
    ViewData["Title"] = "Edit subject";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ParentSubjectId" class="control-label"></label>
                <select asp-for="ParentSubjectId" class="form-control" asp-items="ViewBag.ParentSubjectId"></select>
                <span asp-validation-for="ParentSubjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SubjectContent" class="control-label"></label>
                <textarea rows="5" asp-for="SubjectContent" class="form-control"></textarea>
                <span asp-validation-for="SubjectContent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Slug" class="control-label"></label>
                <input asp-for="Slug" class="form-control" readonly />
            </div>
            <input type="hidden" asp-for="Status" />
            <div class="form-group">
                <input type="submit" value="Edit" class="btn btn-primary btn-lg" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">List subject</a>
</div>



@section Scripts {
    @{
        var summernote = new DShop2024.Models.Summernote("#SubjectContent");
        @await Html.PartialAsync("_SummernotePartial", summernote);
    }

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


