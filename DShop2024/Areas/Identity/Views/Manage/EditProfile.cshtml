@using DShop2024.EnumData
@model EditExtraProfileModel
@{
    ViewData["Title"] = "Profile";
}


<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <h4>@ViewData["Title"]</h4>
            <div class="row">
                <div class="col-md-6">
                    <form id="profile-form" method="post"  enctype="multipart/form-data">
                        @if (!String.IsNullOrEmpty(Model.RoleName))
                        {
                            <h2>@Model.RoleName</h2>
                        }

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="UserName"></label>
                            <input asp-for="UserName" class="form-control" disabled />
                        </div>
                        <div class="form-group">
                            <label asp-for="UserEmail"></label>
                            <input asp-for="UserEmail" class="form-control" disabled />
                        </div>

                        <div class="form-group">
                            <label asp-for="PhoneNumber"></label>
                            <input asp-for="PhoneNumber" class="form-control"/>
                        </div>
                        <div class="form-group">
                            <label asp-for="BirthDate"></label>
                            <input asp-for="BirthDate" type="date" class="form-control" />
                            <span asp-validation-for="BirthDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Occupation"></label>
                            <input asp-for="Occupation" class="form-control" />
                            <span asp-validation-for="Occupation" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <inputRadioGroup id="Gender" name="Gender">
                                <label>Male</label>
                                <input id="Gender" name="Gender" value="True"  type="radio" @(Model.Gender == true ? "checked" : "")>
                                <label>Female</label>
                                <input id="Gender" name="Gender" value="False" type="radio" @(Model.Gender == false ? "checked" : "")>
                            </inputRadioGroup>
               
                        </div>


                        <div class="form-group">
                            <label>Image</label>
                            <input asp-for="AvatarUpload" class="form-control" />
                            <span asp-validation-for="AvatarUpload" class="text-danger" />
                            <img src="~/media/avatar/@Model.Avatar" width="120" height="100" />
                        </div>
       

                        <button id="update-profile-button" type="submit" class="btn btn-primary">Save</button>
                    </form>
                    @if (Model.LoginType == UserEnumData.LOGIN_WEBSITE)
                    {
                        <a asp-controller="Manage" asp-action="ChangePassword">Change Password</a>
                    }
        
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



