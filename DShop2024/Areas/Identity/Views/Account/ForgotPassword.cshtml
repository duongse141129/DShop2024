@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Fotgot password?";
}


<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="card o-hidden border-0 shadow-lg my-5">
                <div class="card-body p-0">
                    <!-- Nested Row within Card Body -->
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="p-5">
                                <div class="text-center">
                                    <h1 class="h4 text-gray-900 mb-2">Fotgot password?</h1>
                                    <p class="mb-4">
                                        Please enter your account email address to retrieve your password.
                                    </p>
                                </div>
                                <form method="post" class="user">
                                    <div asp-validation-summary="All" class="text-danger"></div>

                                    <div class="form-group">
                                        <input asp-for="Email" class="form-control form-control-user" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-user btn-block">Send</button>
                                </form>


                                <hr>

                                <div class="text-center">
                                    <a class="small" asp-action="ForgotPassword">Fotgot password?</a>
                                </div>
                                <div class="text-center">
                                    <a class="small" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]">Register</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
