@{
    ViewData["Title"] = "Confirm reset password";
}

<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <h1>@ViewData["Title"].</h1>

            <p>The reset password code has been sent to your mailbox</p>

            <form asp-asp-area="Identity" asp-controller="Account" asp-action="ForgotPasswordConfirmation" method="post">
                <input type="hidden" name="userId" value="@Model.Id" />
                <input type="text" name="codeResetPasswordl" value="" />
                <input type="submit" value="Confirm" />
                <a asp-area="Identity" asp-controller="Account" asp-action="SendOtpResetPaswordAgain" asp-route-userId="@Model.Id">SendOTP again</a>
            </form>
        </div>
    </div>
</div>