@{
    ViewData["Title"] = "Notification of password reset";
}

<h1>@ViewData["Title"].</h1>

<p>The reset password code has been sent to your mailbox</p>

<form asp-asp-area="Identity" asp-controller="Account" asp-action="ForgotPasswordConfirmation" method="post">
    <input type="hidden" name="userId" value="@Model.Id" />
    <input type="text" name="codeResetPasswordl" value="" />
    <input type="submit" value="Confirm" />
    <a asp-area="Identity" asp-controller="Account" asp-action="SendOtpResetPassword" asp-route-userId="@Model.Id">SendOTP again</a>
</form>