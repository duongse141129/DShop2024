@model ExternalLoginConfirmationViewModel
@{
    ViewData["Title"] = "Register external service";
}

<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <h1>@ViewData["Title"].</h1>
            <h3>Link account with  @ViewData["ProviderDisplayName"].</h3>

            <form asp-controller="Account" asp-action="ExternalLoginConfirmation" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="form-horizontal" role="form">
                <h4>Link information</h4>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <p>
                    You have authenticated the link with <strong>@ViewData["ProviderDisplayName"]</strong>
                </p>
                <div class="form-group">
                    <label asp-for="Email" class="col-md-2 control-label"></label>
                    <div class="col-md-10">
                        <input asp-for="Email" class="form-control" readonly />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button type="submit" class="btn btn-default">Register</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
