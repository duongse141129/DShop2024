@model IEnumerable<BranchModel>

@{
    ViewData["Title"] = "Manage Branches";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h1 class="text-primary">@ViewData["title"]</h1>

@if (User.IsInRole(RoleName.Administrator))
{
    <div class="col-sm-4">
        <a class="btn btn-primary" asp-action="Create">Create Branch</a>
    </div>
}
<table class="table table-striped table-hover" id="myTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Latitude)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Longitude)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Latitude)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Longitude)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                    @if (User.IsInRole(RoleName.Administrator))
                    {
                        <div class="btn-group-2">
                            <a class="btn btn-sm-2 btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
                            <a class="btn btn-sm-2 btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm-2 btn-danger confirmDeletion" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </div>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
