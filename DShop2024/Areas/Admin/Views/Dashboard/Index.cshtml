﻿@{
    ViewData["Title"] = "Dashboard";
}
<div class="row">
    <div class="container-fluid">
        <div class="col-md-12">
            <h5>Thống kê số lượng</h5>
            <ul>
                <li>Tổng đơn hàng : @ViewBag.CountProduct</li>
                <li>Tổng sản phẩm : @ViewBag.CountProduct</li>
                <li>Tổng danh mục sản phẩm : @ViewBag.CountCategory</li>
                <li>Tổng nhãn hàng sản phẩm : @ViewBag.Brand</li>
                <li>Tổng khách hàng : @ViewBag.CountUser</li>
            </ul>
        </div>
        <div class="col-md-12">

            <h5>Thống kê bán hàng</h5>
            <div class="row">
                <div class="col-md-4">
                    <p>Lọc theo ngày tháng</p>
                    <form>
                        Ngày:
                 @*        <input type="date"  class="form-control" id="datepicker"> *@
                        <label>From: </label>
                        <input type="date" name="dateStart" class="form-control" id="dateStart">
                        <label>To: </label>
                        <input type="date" name="dateEnd" class="form-control" id="dateEnd">
                        <button type="button" class="btn btn-primary btn-filter-date">Lọc theo ngày</button>
                    </form>
                </div>
                <div class="col-md-4">
                    <p>Lọc theo</p>
                    <p>
                        <select class="form-control filter-date">
                            <option value="last_month">Tháng trước</option>
                            <option value="this_month">Tháng này</option>
                            <option selected value="this_year">Năm nay</option>
                            <option value="last_year">Năm trước</option>
                        </select>
                    </p>
                </div>
            </div>
            <div id="myfirstchart" style="height: 350px;"></div>
            <div class="row">
                <h1>Donut Chart of the number of products sold by brand </h1>
                <div id="graphBrand" style="width: 350px;"> </div>
                <h1>Donut Chart of the number of products sold by category</h1>
                <div id="graphCategories" style="width: 350px;"> </div>

                <div class="col-md-12">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Name</th>
                                <th scope="col">Original Price</th>
                                <th scope="col">Price</th>
                                <th scope="col">Quantity Sold</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.bestSaleProducts)
                            {
                                <tr>
                                    <th>@item.Id</th>
                                    <th>
                                        <img src="~/media/products/@item.Image" width="120" height="100" />
                                        @item.ProductName
                                    </th>
                                    <th>@item.OriginalPrice</th>
                                    <th>@item.Price</th>
                                    <th>@item.QuantitySold</th>
                                </tr>
                            }
   
                        
                        </tbody>
                    </table>
                </div>
            </div>

            <h1>Area charts behaving like line charts</h1>
            <div id="graphArenaT"></div>
           
        </div>
    </div>
</div>
@section Scripts {

    <script src="//cdnjs.cloudflare.com/ajax/libs/raphael/2.1.0/raphael-min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.js"></script>

    <script>

        $(document).ready(function () {
            var chartData = [];
            var chart = new Morris.Line({
                element: 'myfirstchart',
                parseTime: false,
                data: chartData,
                xkey: 'date',

                ykeys: ['revenue', 'profit', 'orders', 'quantitysold'],

                labels: ['Doanh thu','lợi nhuận' ,'Đơn hàng', 'Số lượng bán ra']
            });
            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartData", "Dashboard")",
                success: function (data) {
                    chart.setData(data);
                }
            });

            //submit filter date in chart
            $(".filter-date").change(function () {
                var filterdate = $(this).val();
                // alert(filterdate);

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SelectFilterDate", "Dashboard")",
                    data: { filterdate: filterdate },
                    success: function (data) {
                        chart.setData(data);
                    }
                });
            })

            //select option filter data
            // $(".btn-filter-date").click(function () {
            //     var filterdate = $("#datepicker").val();
            //     $.ajax({
            //         type: "POST",
            //         url: "@Url.Action("SubmitFilterDate", "Dashboard")",
            //         data: { filterdate: filterdate },
            //         success: function (data) {
            //             chart.setData(data);
            //         }
            //     });
            // })

            $(".btn-filter-date").click(function () {
                var dateStart = $("#dateStart").val();
                var dateEnd = $("#dateEnd").val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SubmitFilterDate", "Dashboard")",
                    data: { dateStart: dateStart, dateEnd: dateEnd },
                    success: function (data) {
                        chart.setData(data);
                        // if (data != null) {
                        //     chart.setData(data);
                        // } else {
                        //     Swal.fire("Date start must <= date end");
                        // }
                        
                    }
                });
            })

        });

    </script>
    <script>
        $(document).ready(function () {
            var chartData = [];
            var chartB = new Morris.Donut({
                element: 'graphBrand',
                data: [0, 0],
                backgroundColor: '#ccc',
                labelColor: '#060',
                colors: ['Maroon', 'Navy', 'Yellow', 'Olive', 'Red', 'Maroon', 'Fuchsia', 'Purple', 'Teal', 'Aqua', 'Silver', 'Gray'],
                formatter: function (x) { return x + "%" }
            }).on('click', function (i, row) {
                console.log(i, row);
            });
            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartBrand", "Dashboard")",
                success: function (data) {
                    chartB.setData(data);
                }
            });
        });

        $(document).ready(function () {
            var chartData = [];
            var chartB = new Morris.Donut({
                element: 'graphCategories',
                data: [0, 0],
                backgroundColor: '#ccc',
                labelColor: '#060',
                colors: ['Yellow', 'Olive', 'Red', 'Maroon','Fuchsia', 'Purple', 'Teal', 'Aqua', 'Silver', 'Gray', 'Maroon', 'Navy'],
                formatter: function (x) { return x + "%" }
            }).on('click', function (i, row) {
                console.log(i, row);
            });
            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartCategories", "Dashboard")",
                success: function (data) {
                    chartB.setData(data);
                }
            });

        });
        Morris.Area({
            element: 'graphArenaT',
            behaveLikeLine: true,
            data: [
                { x: '2011 Q1', y: 3, z: 3 },
                { x: '2011 Q2', y: 2, z: 1 },
                { x: '2011 Q3', y: 2, z: 4 },
                { x: '2011 Q4', y: 3, z: 3 }
            ],
            xkey: 'x',
            ykeys: ['y', 'z'],
            labels: ['Y', 'Z']
        });
    </script>
