﻿@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="fw-bold text-primary">@ViewData["title"]</h1>
<div class="page-inner">

    <div class="row">
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-primary bubble-shadow-small">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Users</p>
                                <h4 class="card-title">@ViewBag.CountUser</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-info bubble-shadow-small">                             
                                <i class="fas fa-boxes"></i>                              
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Available Products</p>
                                <h4 class="card-title">@ViewBag.CountProduct</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-success bubble-shadow-small">
                                <i class="fas fa-luggage-cart"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Total Orders</p>
                                <h4 class="card-title">@ViewBag.CountOrder</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-secondary bubble-shadow-small">
                                <i class="far fa-check-circle"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Completed Orders</p>
                                <h4 class="card-title">@ViewBag.CountCompletedOrder</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row">
                        <div class="card-title">Sales statistics</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                            <p>Filter by date</p>
                                <label for="from">From</label>
                                <input autocomplete="off" class="form-control" type="text" id="dateStart" name="dateStart">
                                <label for="to">to</label>
                                <input autocomplete="off" class="form-control" type="text" id="dateEnd" name="dateEnd">
                                <br/>
                                <button type="button" class="btn btn-info btn-filter-date">Filter</button>
                        </div>
                        <div class="col-sm-4">
                            <p>Filter by month or year</p>
                            <p>
                                <select class="form-control filter-date">
                                    <option value="last_month">Last month</option>
                                    <option value="this_month">This month</option>
                                    <option selected value="this_year">This year</option>
                                    <option value="last_year">Last year</option>
                                </select>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                   <div class="chart-container" style="min-height: 550px">
                        <div id="myfirstchart" style="height: 550px;"></div>                 
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row">
                        <div class="card-title">Best Selling in brands by percentage</div>
                    </div>
                </div>
                <div class="card-body pb-0">                 
                     <div class="mb-4 mt-2">
                        <div id="graphBrand" style="width: 275px;"> </div>
                    </div>
                </div>
            </div>
            <div class="card card-round">
                <div class="card-body pb-0">
                    <h4 class="mb-2">Best Selling in categories by percentage</h4>
                    <div class="pull-in sparkline-fix">
                        <div id="graphCategories" style="width: 275px;"> </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <h4 class="card-title">Import-Export Group Chart</h4>
                        <div class="card-tools">
                            <select class="form-control filter-barchart">
                                <option selected value="this_year">This year</option>
                                <option value="last_year">Last year</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="min-height: 550px">
                        <div id="mybarchart" style="height: 500px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-10">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <div class="card-title">Best selling products</div>
                        <div class="card-tools">
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <!-- Projects table -->
                        <table class="table align-items-center mb-0 table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th scope="col">Id</th>
                                    <th scope="col">Name</th>
                                    <th scope="col" class="text-end">Original Price</th>
                                    <th scope="col" class="text-end">Price</th>
                                    <th scope="col" class="text-end">Quantity Sold</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ViewBag.bestSaleProducts)
                                {
                                    <tr>
                                        <th>@item.Id</th>
                                        <th>
                                            <div class="col-md-12">
                                                <a asp-area="Admin" asp-action="Detail" asp-controller="ProductManage" asp-route-id="@item.Id">
                                                    @item.ProductName
                                                </a>
                                            </div>
                                            <div class="col-md-12">
                                                <img src="~/media/products/@item.Image" width="120" height="100" />
                                            </div>
                                        </th>
                                        <th class="text-end">@item.OriginalPrice.ToString("#,##0 VND")</th>
                                        <th class="text-end">@item.Price.ToString("#,##0 VND")</th>
                                        <th class="text-end">@item.QuantitySold</th>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="//cdnjs.cloudflare.com/ajax/libs/raphael/2.1.0/raphael-min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.min.js"></script>

    <script src="~/lib/jqueryui/jquery-ui.min.js"></script>
    <script src="~/lib/jqueryui/jquery-ui.js"></script>

    <script>
        $(function () {
            var dateFormat = "mm/dd/yy",
                from = $("#dateStart")
                    .datepicker({
                        defaultDate: "+1w",
                        changeMonth: true
                    })
                    .on("change", function () {
                        to.datepicker("option", "minDate", getDate(this));
                    }),
                    to = $("#dateEnd").datepicker({
                        defaultDate: "+1w",
                        changeMonth: true
                    })
                    .on("change", function () {
                        from.datepicker("option", "maxDate", getDate(this));
                    });

            function getDate(element) {
                var date;
                try {
                    date = $.datepicker.parseDate(dateFormat, element.value);
                } catch (error) {
                    date = null;
                }
                return date;
            }
        });
    </script>
    <script>
        $(document).ready(function () {
            var chartData = [];
            var chart = new Morris.Line({
                element: 'myfirstchart',
                parseTime: false,
                data: chartData,
                xkey: 'date',
                xLabels: 'month',
                ykeys: ['revenue', 'profit', 'orders', 'quantitysold'],
                labels: ['Revenue', 'Profit', 'Orders', 'Quantity Sold']
            });
            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartData", "Dashboard")",
                success: function (data) {
                    chart.setData(data);
                }
            });

            //submit filter date in chart
            $(".filter-date").change(function () {
                var filterdate = $(this).val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SelectFilterDate", "Dashboard")",
                    data: { filterdate: filterdate },
                    success: function (data) {
                        chart.setData(data);
                    }
                });
            })

            $(".btn-filter-date").click(function () {
                var dateStart = $("#dateStart").val();
                var dateEnd = $("#dateEnd").val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SubmitFilterDate", "Dashboard")",
                    data: { dateStart: dateStart, dateEnd: dateEnd },
                    success: function (data) {
                        if (data != null) {
                            chart.setData(data);
                        } else {
                            Swal.fire("Date start must <= date end");
                        }
                        
                    }
                });
            })

        });

    </script>
    <script>
        $(document).ready(function () {
            var chartData = [];
            var chartB = new Morris.Donut({
                element: 'graphBrand',
                data: [0, 0],
                backgroundColor: '#ccc',
                labelColor: '#060',
                colors: ['Maroon', 'Navy', 'Yellow', 'Olive', 'Red', 'Maroon', 'Fuchsia', 'Purple', 'Teal', 'Aqua', 'Silver', 'Gray'],
                formatter: function (x) { return x + "%" }
            }).on('click', function (i, row) {
                console.log(i, row);
            });
            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartBrand", "Dashboard")",
                success: function (data) {
                    chartB.setData(data);
                }
            });
        });

        $(document).ready(function () {
            var chartData = [];
            var chartB = new Morris.Donut({
                element: 'graphCategories',
                data: [0, 0],
                backgroundColor: '#ccc',
                labelColor: '#060',
                colors: ['Teal', 'Gray', 'Maroon', 'Navy', 'Yellow', 'Olive', 'Silver', 'Red', 'Maroon', 'Fuchsia', 'Purple','Aqua'],
                formatter: function (x) { return x + "%" }
            }).on('click', function (i, row) {
                console.log(i, row);
            });
            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartCategories", "Dashboard")",
                success: function (data) {
                    chartB.setData(data);
                }
            });

        });

    </script>

    <script>
        $(document).ready(function () {
            var chartData = [];
            var chart = new Morris.Bar({
                element: 'mybarchart',
                data: chartData,
                xkey: 'month',
                ykeys: ['stockIn', 'stockOut'],
                labels: ['Import', 'Export'],
                barColors: ['#1fbba6', '#f8aa33', '#4da74d', '#afd8f8', '#edc240', '#cb4b4b', '#9440ed'],
                gridTextColor: '#666',
                grid: true,
                barOpacity: 0.8
            });




            //filter all data chart
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartStock", "Dashboard")",
                success: function (data) {
                    chart.setData(data);
                }
            });


            // var browsersChart = chart;

            // // Legend for Bar chart
            // browsersChart.options.labels.forEach(function (label, i) {
            //     var legendItem = $('<span class="legend-item"></span>').text(label).prepend('<span class="legend-color">&nbsp;</span>');
            //     legendItem.find('span')
            //         .css('backgroundColor', browsersChart.options.barColors[i]);
            //     $('#visitor_legend').append(legendItem)
            // });

            //submit filter date in chart
            $(".filter-barchart").change(function () {
                var filterbarchart = $(this).val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetChartStockFilter", "Dashboard")",
                    data: { filterbarchart: filterbarchart },
                    success: function (data) {
                        chart.setData(data);
                    }
                });
            })



        });

    </script>

}
