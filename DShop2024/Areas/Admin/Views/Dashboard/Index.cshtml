@using DShop2024.ViewModels
@model DataDashboardViewModel
﻿@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="fw-bold text-primary">@ViewData["title"]</h1>
<div class="page-inner">
    <div class="row">
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-primary bubble-shadow-small">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Users</p>
                                <h4 class="card-title">@Model.CountUser</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-info bubble-shadow-small">                             
                                <i class="fas fa-boxes"></i>                              
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Available Products</p>
                                <h4 class="card-title">@Model.CountProduct</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-success bubble-shadow-small">
                                <i class="fas fa-luggage-cart"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Total Orders</p>
                                <h4 class="card-title">@Model.CountOrder</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-secondary bubble-shadow-small">
                                <i class="fas fa-redo"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Returned Quantities</p>
                                <h4 class="card-title">@Model.CountQuantityReturn</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="card card-round">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Sales Statistics</h5>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-lg-8">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-3">Filter by Date</h6>

                                <div class="row g-3 align-items-end">
                                    <div class="col-md-5">
                                        <label for="dateStart" class="form-label">From</label>
                                        <input autocomplete="off" type="text" class="form-control" id="dateStart" name="dateStart">
                                    </div>
                                    <div class="col-md-5">
                                        <label for="dateEnd" class="form-label">To</label>
                                        <input autocomplete="off" type="text" class="form-control" id="dateEnd" name="dateEnd">
                                    </div>
                                    <div class="col-md-2 d-grid">
                                        <button type="button" class="btn btn-primary btn-filter-date">
                                            Filter
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-3">Filter by Month / Year</h6>
                                <label class="form-label">Select</label>
                                <select class="form-select filter-date"
                                        asp-items="ViewBag.StatisticFilterOptions">
                                </select>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-body">
                   <div class="chart-container" style="min-height: 545px;">
                        <div id="myfirstchart" style="height: 625px;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">

            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row">
                        <div class="card-title">Quantity of Products Sold by Brand</div>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="row">
                        <div class="col-sm-7">
                            <div id="graphBrand" style="width: 275px;"> </div>
                        </div>
                        <div class="col-sm-5 d-flex align-items-center">
                            <div id="brandchart" class="donutlegendbrand donut-legend"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row">
                        <div class="card-title">Quantity of Products Sold by Category</div>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="row">
                        <div class="col-sm-7">
                            <div id="graphCategories" style="width: 275px;"> </div>
                        </div>
                        <div class="col-sm-5 d-flex align-items-center">
                            <div id="categorychart" class="donut-legend"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <h4 class="card-title">Import-Export Group Chart</h4>
                        <div class="card-tools">
                            <select class="form-control filter-barchart" asp-items="ViewBag.ImportExportFilterOptions">
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="min-height: 550px">
                        <div id="mybarchart" style="height: 500px;"></div>
                        <div id="visitor_legend" class="bar-chart-legend"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-8">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <div class="card-title">Best selling products</div>
                        <div class="card-tools">
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <!-- Projects table -->
                        <table class="table align-items-center mb-0 table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th scope="col">Id</th>
                                    <th scope="col">Name</th>
                                    <th scope="col" class="text-end">Original Price</th>
                                    <th scope="col" class="text-end">Price</th>
                                    <th scope="col" class="text-end">Quantity Sold</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.BestSaleProducts)
                                {
                                    <tr>
                                        <th>@item.Id</th>
                                        <th>
                                            <div class="col-md-12">
                                                <a asp-area="Admin" asp-action="Detail" asp-controller="ProductManage" asp-route-id="@item.Id">
                                                    @item.ProductName
                                                </a>
                                            </div>
                                            <div class="col-md-12">
                                                <img src="~/media/products/@item.MainImage" width="120" height="100" />
                                            </div>
                                        </th>
                                        <th class="text-end">@item.OriginalPrice.ToString("#,##0 VND")</th>
                                        <th class="text-end">
                                            @if (item.IsOnSale)
                                            {
                                                <span class="original-price" style="text-decoration: line-through;">@item.Price.ToString("#,##0")</span>
                                                <span class="badge badge-danger text-white bg-danger">@item.DiscountPercent% off</span>
                                                <div class="price text-danger">@item.SalePrice?.ToString("#,##0 VND")</div>
                                            }
                                            else
                                            {
                                                <span class="price">@item.Price.ToString("#,##0 VND")</span>
                                            }
                                        </th>
                                        <th class="text-end">@item.QuantitySold</th>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="col-md-12">
                <div class="card card-round">
                    <div class="card-body">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title">Customers</div>
                        </div>
                        <div class="card-list py-4">
                            <div class="scrollCustomer">


                            @foreach (var item in Model.ListCustomer)
                            {
                                <div class="item-list">
                                    <div class="avatar" >
                                        <img src="~/media/avatar/@item.Avatar" alt="..." class="avatar-img rounded-circle">
                                    </div>
                                    <div class="info-user ms-3">
                                        <div class="username">@item.UserName</div>
                                    </div>
                                    <a class="btn btn-icon btn-link op-8 me-1" asp-area="Admin" asp-controller="Chat" asp-action="ChatWithCustomer" asp-route-customerId="@item.Id"> 
                                        <i class="far fa-envelope"></i>
                                    </a>
                                </div>
                            }
                            </div>
                        </div>
                    </div>
                </div>
            </div>       
        </div>
    </div>
    <div class="row">
        <div class="col-sm-5">
            <div class="card">
                <div class="card-header">
                    <div class="card-head-row">
                        <div class="card-title">Contacts</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="scrollContact">
                    @foreach (var item in Model.ListContact)
                    {
                        <div class="d-flex">
                            <div class="avatar">
                                <img src="~/media/avatar/@item.User.Avatar" alt="..." class="avatar-img rounded-circle">
                            </div>
                            <div class="flex-1 ms-3 pt-1">
                                <h6 class="text-uppercase fw-bold mb-1">
                                    @item.User.UserName
                                    @if(item.Status == 2)
                                    {
                                        <span class="text-success ps-3">Completed</span>
                                    }
                                    else if (item.Status == 1)
                                    {
                                        <span class="text-warning ps-3">Pending</span>
                                    }
                         
                                </h6>
                                <span class="text-muted">
                                    Subject: @item.Subject
                                </span>
                            </div>
                            <div class="float-end pt-1">
                                <small class="text-muted">@item.DateSent.ToString("MM/dd/yyyy h:mm tt")</small>
                                @if(item.Status == 1)
                                {
                                    <a class="btn btn-icon btn-link op-8 me-1" asp-area="Admin" asp-action="Reply" asp-controller="Contact" asp-route-id="@item.Id">
                                        <i class="fa fa-reply"></i>
                                    </a>
                                }
                            </div>
                        </div>
                        <div class="separator-dashed"></div>
                    }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-2">
            <div class="card">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <div class="card-title">Total Order: @Model.CountOrder</div>
                    </div>
                </div>
                <div class="card-body">
                    <ol class="activity-feed">
                        @for (int i = 0; i < OrderEnumData.StatusOrderCount; i++)
                        {
                            <li class="feed-item feed-item-@( (OrderEnumData.SpanStatusOrder) i )">
                                <time class="date" datetime="9-18"> <i class="@OrderEnumData.IconStatusOrder[i]"></i> @((OrderEnumData.StatusOrder)i)</time>
                                <span class="text">                          
                                    @if (i == 0)
                                    {
                                        @Model.CountCancelOrder
                                    }
                                    @if (i == 1)
                                    {
                                        @Model.CountNewOrder
                                    }
                                    @if (i == 2)
                                    {
                                        @Model.CountAcceptedOrder
                                    }
                                    @if (i == 3)
                                    {
                                        @Model.CountDeliveryOrder
                                    }
                                    @if (i == 4)
                                    {
                                        @Model.CountCompletedOrder
                                    }
                                </span>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        </div>
        <div class="col-sm-5">
            <div class="card card-round">
                <div class="card-header">
                    <div class="card-head-row card-tools-still-right">
                        <div class="card-title">Available Coupons</div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="scrollCoupon">
                    <div class="table-responsive">
                        <!-- Projects table -->
                        <table class="table align-items-center mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th scope="col">Coupon Code</th>
                                    <th scope="col" class="text-end">Date &amp; Time</th>
                                    <th scope="col" class="text-end">Amount</th>
                                    <th scope="col" class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ListAvailableCouponVM )
                                {
                                        <tr>
                                            <th scope="row">
                                                @item.CouponCode
                                            </th>
                                            <td class="text-end">@item.DaysLeft</td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td class="text-end">
                                                <span class="badge @(item.Status == 2 ? "badge-success" : "badge-info") ">@((CouponEnumData.StatusCoupon)item.Status)</span>
                                            </td>
                                        </tr>
                                }
                             
                            </tbody>
                        </table>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="//cdnjs.cloudflare.com/ajax/libs/raphael/2.1.0/raphael-min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.min.js"></script>

    <script src="~/lib/jqueryui/jquery-ui.min.js"></script>

    <script>
         $(function () {
            const dateFormat = "mm/dd/yy";

            const from = $("#dateStart").datepicker({
                dateFormat: dateFormat,
                changeMonth: true,
                changeYear: true
            }).on("change", function () {
                to.datepicker("option", "minDate", getDate(this));
            });

            const to = $("#dateEnd").datepicker({
                dateFormat: dateFormat,
                changeMonth: true,
                changeYear: true
            }).on("change", function () {
                from.datepicker("option", "maxDate", getDate(this));
            });

            function getDate(element) {
                try {
                    return $.datepicker.parseDate(dateFormat, element.value);
                }
                catch {
                    return null;
                }
            }

        });
    </script>
    <script>
        $(document).ready(function () {
            var chartData = [];
            var chart = new Morris.Line({
                element: 'myfirstchart',
                parseTime: false,
                data: chartData,
                xkey: 'date',
                xLabels: 'month',
                ykeys: ['revenue', 'profit', 'orders', 'quantitysold'],
                labels: ['Revenue', 'Profit', 'Orders', 'Quantity Sold'],
                resize: true
            });

            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartData", "Dashboard")",
                success: function (data) {
                    chart.setData(data);
                }
            });


            $(".filter-date").change(function () {
                var filterdate = $(this).val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SelectFilterDate", "Dashboard")",
                    data: { filterdate: filterdate },
                    success: function (data) {
                        chart.setData(data);
                    }
                });
            })

            $(".btn-filter-date").click(function () {
            const dateStart = $("#dateStart").val();
            const dateEnd = $("#dateEnd").val();

            if (!dateStart || !dateEnd) {
                Swal.fire({
                    icon: "warning",
                    title: "Please select both dates."
                });
                return;
            }
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SubmitFilterDate", "Dashboard")",
                    data: {
                        dateStart: dateStart,
                        dateEnd: dateEnd
                    },
                    success: function (result) {

                        if (result.success) {
                            chart.setData(result.data);
                        }
                        else{
                              Swal.fire('Error', result.message, 'error');
                        }
                    }
                });
            });



        });

    </script>
    <script>
        $(document).ready(function () {
            var color_array = ['#03658C', '#7CA69E', '#F2594A', '#F28C4B', '#7E6F6A', '#36AFB2', '#9c6db2', '#d24a67', '#89a958', '#00739a', '#BDBDBD'];
            var chartB = new Morris.Donut({
                element: 'graphBrand',
                data: [0, 0],
                backgroundColor: '#ccc',
                labelColor: '#060',
                colors: color_array,
                resize: true,
                formatter: function (x) { return x  }
            });

            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartBrand", "Dashboard")",
                success: function (data) {
                    chartB.setData(data);
                    var i = 0;
                    data.forEach(function (label) {

                        var legendItem = `
                            <div class="legend-item">
                                <div class="legend-left">
                                    <span class="legend-color"
                                          style="background:${color_array[i]}"></span>

                                    <span class="legend-name">${label.label}</span>
                                </div>

                                <span class="legend-value">${label.value}</span>
                            </div>
                        `;

                        $('#brandchart').append(legendItem);


                        i++;
                    });
                }
            });
        });

        $(document).ready(function () {
            var color_array = ['Teal', 'Gray', 'Maroon', 'Navy', 'Yellow', 'Olive', 'Silver', 'Red', 'Maroon', 'Fuchsia', 'Purple', 'Aqua'];
            var chartC = new Morris.Donut({
                element: 'graphCategories',
                data: [0, 0],
                backgroundColor: '#ccc',
                labelColor: '#060',
                colors: color_array,
                resize: true,
                formatter: function (x) { return x  }
            })
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartCategories", "Dashboard")",
                success: function (data) {
                    chartC.setData(data);
                    var i = 0;
                    data.forEach(function (label) {

                        var legendItem = `
                            <div class="legend-item">
                                <div class="legend-left">
                                    <span class="legend-color"
                                          style="background:${color_array[i]}"></span>

                                    <span class="legend-name">${label.label}</span>
                                </div>

                                <span class="legend-value">${label.value}</span>
                            </div>
                        `;

                        $('#categorychart').append(legendItem);


                        i++;
                    });
                }
            });

        });

    </script>

    <script>
        $(document).ready(function () {
            var chartData = [];
            var chart = new Morris.Bar({
                element: 'mybarchart',
                data: chartData,
                xkey: 'month',
                ykeys: ['stockIn', 'stockOut'],
                labels: ['Import', 'Export'],
                barColors: ['#1fbba6', '#f8aa33', '#4da74d', '#afd8f8', '#edc240', '#cb4b4b', '#9440ed'],
                gridTextColor: '#666',
                grid: true,
                barOpacity: 0.8,
                resize: true
            });


            $.ajax({
                type: "POST",
                url: "@Url.Action("GetChartStock", "Dashboard")",
                success: function (data) {
                    chart.setData(data);
                }
            });

            var browsersChart = chart;
            browsersChart.options.labels.forEach(function (label, i) {
                var legendItem = $('<span class="legend-item"></span>').text(label).prepend('<span class="legend-color">&nbsp;</span>');
                legendItem.find('span')
                    .css('backgroundColor', browsersChart.options.barColors[i]);
                $('#visitor_legend').append(legendItem)
            });


            $(".filter-barchart").change(function () {
                var filterbarchart = $(this).val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetChartStockFilter", "Dashboard")",
                    data: { filterbarchart: filterbarchart },
                    success: function (data) {
                        chart.setData(data);
                    }
                });
            })

        });

    </script>

}
