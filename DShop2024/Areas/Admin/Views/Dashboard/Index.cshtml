        Morris.Donut({
            element: 'graphCategories',
            data: [
                { value: 70, label: 'office' },
                { value: 15, label: 'handshake' },
                { value: 10, label: 'gaming' },
                { value: 5, label: 'travel' }
            ],
            colors: ['Silver', 'Gray', 'Maroon', 'Navy'],
            resize: true,
            formatter: function (x) { return x + "%" }
