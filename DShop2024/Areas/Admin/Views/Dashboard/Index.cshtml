        //         { value: 10, label: 'mark' },
        //         { value: 5, label: 'asus' }
        //     ],
        //     colors: ['red', 'blue', 'yellow', 'green'],
        //     resize: true,
        //     formatter: function (x) { return x + "%" }
        // }).on('click', function (i, row) {
        //     console.log(i, row);
