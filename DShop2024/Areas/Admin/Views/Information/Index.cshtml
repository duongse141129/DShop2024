@model InformationShopModel
@{
	ViewData["title"] = " Infomation shop";
	Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>@ViewData["title"]</h1>


<table class="table table-bordered table-striped">
	<thead class="thead-dark">
		<tr>
			<th scope="col"></th>
			<th scope="col">Product</th>
		</tr>
	</thead>
	<tbody>
		<tr>
			<th>Name</th>
			<td>@Model.ShopName</td>
		</tr>
		<tr>
			<th>Description</th>
			<td>@Html.Raw(@Model.Description)</td>
		</tr>
		<tr>
			<th>Address</th>
			<td>
				@Html.Raw(@Model.Address)
			</td>
		</tr>
		<tr>
			<th>Map</th>
			<td>
				@Html.Raw(@Model.Map)
			</td>
		</tr>
		<tr>
			<th>Logo</th>
			<td><img src="~/media/Logo/@Model.LogoImg" width="120" height="120" /></td>
		</tr>
		<tr>
			<th>Phone</th>
			<td>@Model.Phone</td>
		</tr>
		<tr>
			<th>Email</th>
			<td>@Model.Email</td>
		</tr>
		<tr>
			<th>Youtube</th>
			<td>@Html.Raw(Model.PluginYoutube)</td>
		</tr>
		<tr>
			<th>Facebook</th>
			<td>@Html.Raw(@Model.PluginFacebook)</td>
		</tr>
		<tr>
			<th>Action</th>
			<td><a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Information" asp-route-Id="@Model.Id">Edit</a></td>
		</tr>
	</tbody>
</table>

@section Scripts {
	<script src="https://apis.google.com/js/platform.js"></script>
}