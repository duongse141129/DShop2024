@model InformationShopModel
@{
    ViewData["title"] = " Info shop";
}
<h4>Contact Admin</h4>

<table class="table" id="myTable">
    <thead>
        <tr>

            <th>Name</th>
            <th>Description</th>
            <th>Map</th>
            <th>Logo</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Action</th>

        </tr>
    </thead>
    <tbody>
            <tr>
                <td>@Model.ShopName</td>
                <td>@Html.Raw(Model.Description)</td>
                <td>@Html.Raw(@Model.Map)</td>
                <td><img src="~/media/Logo/@Model.LogoImg" width="120" height="120" /></td>             
                <td>@Model.Phone</td>
                <td>@Model.Email</td>
                <td>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Contact" asp-route-Id="@Model.Id">Edit</a>
                </td>
            </tr>
    </tbody>



</table>

