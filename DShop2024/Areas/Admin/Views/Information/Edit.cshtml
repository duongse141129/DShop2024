@model InformationShopModel
@{
    ViewData["title"] = "Edit Information Shop";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="col-md-9">
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Shop Name</label>
            <input asp-for="ShopName" class="form-control" />
            <span asp-validation-for="ShopName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Shop email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Hotline</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Youtube</label>
            <input asp-for="PluginYoutube" class="form-control" />
            <span asp-validation-for="PluginYoutube" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Facebook</label>
            <input asp-for="PluginFacebook" class="form-control" />
            <span asp-validation-for="PluginFacebook" class="text-danger"></span>
        </div>



        <div class="form-group">
            <label>Image</label>
            <input asp-for="ImageUpload" class="form-control" />
            <span asp-validation-for="ImageUpload" class="text-danger"></span>
            <img src="~/media/Logo/@Model.LogoImg" width="120" height="100" />
        </div>
        <div>
            <img id="imgpreview" class="pt-2" />
        </div>
        <div class="form-group">
            <button class="btn btn-primary">Edit</button>
        </div>
    </form>
    <a asp-action="Index">Back to information shop</a>
</div>

@section Scripts {
    <script>
        $("#ImageUpload").change(function () {
            readURL(this);
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
