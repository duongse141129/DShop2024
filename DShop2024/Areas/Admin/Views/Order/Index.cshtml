@model ManageOrderViewModel

@{
    ViewData["Title"] = "Manage order";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="row row-card-no-pd">
    @for (int i = 0; i < OrderEnumData.StatusOrderCount; i++)
    {
        <div class="col-sm-6 col-md-2">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row">
                        <div class="col-5">
                            <div class="icon-big text-center">
                                <i class="@OrderEnumData.IconStatusOrder[i] text-@((OrderEnumData.SpanStatusOrder)i)"></i>
                            </div>
                        </div>
                        <div class="col-7 col-stats">
                            <div class="numbers">
                                <p class="card-category">@((OrderEnumData.StatusOrder)i)</p>
                                <h4 class="card-title">
                                    @if (i == 0)
                                    {
                                        @Model.CountCancelOrder
                                    }
                                    @if (i == 1)
                                    {
                                        @Model.CountNewOrder
                                    }
                                    @if (i == 2)
                                    {
                                        @Model.CountAcceptedOrder
                                    }
                                    @if (i == 3)
                                    {
                                        @Model.CountDeliveryOrder
                                    }
                                    @if (i == 4)
                                    {
                                        @Model.CountCompletedOrder
                                    }
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="col-sm-6 col-md-2">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center">
                            <i class="fas fa-luggage-cart text-secondary"></i>
                        </div>
                    </div>
                    <div class="col-7 col-stats">
                        <div class="numbers">
                            <p class="card-category">Total Order</p>
                            <h4 class="card-title">@Model.CountTotalOrder</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row py-5">
    <div class="col-md-8"></div>
    <div class="col-md-4 ">
        <form asp-action="Index" asp-controller="Order">
            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search Order Code" class="form-control" name="searchOrderCode" value="@Model.SearchOrderCode">
                </div>
            </nav>
        </form>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>Created Date</th>
            <th>OrderCode</th>
            <th>Customer Name</th>
            <th>Payment Status</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListOrder)
        {
            <tr>
                <td>
                    @item.CreatedDate.ToString("MM/dd/yyyy h:mm tt")
                </td>
                <td>
                    @item.OrderCode
                </td>
                <td>
                    @item.CustomerName
                </td>
                <td>
                    <span class="payment-status-@((OrderEnumData.PaymentStatusOrder)item.PaymentStatus)">
                        @((OrderEnumData.PaymentStatusOrder)item.PaymentStatus)
                    </span>
                </td>
                <td>
                    @if (item.IsReturn)
                    {
                        @if (item.IsFullReturn)
                        {
                            <span class="order-fullly-returned">@OrderEnumData.FULLY_RETURNED</span>
                        }
                        else
                        {
                            <span class="order-partially-returned">@OrderEnumData.PARTIALLY_RETURNED</span>
                        }
                    }
                    else
                    {
                        <span class="text status-order-@((OrderEnumData.StatusOrder)item.Status)"> @((OrderEnumData.StatusOrder)item.Status) </span>
                    }

                </td>
                <td>
                    <a class="btn btn-info" asp-action="ViewOrder" asp-route-Id="@item.Id">ViewOrder</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_PagingPartial" model="@Model.Paging" />







