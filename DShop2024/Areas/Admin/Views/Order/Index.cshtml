@model IEnumerable<DShop2024.Models.OrderModel>

@{
    ViewData["Title"] = "Manage order";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="row row-card-no-pd">
    @for (int i = 0; i < OrderEnumData.StatusOrderCount; i++)
    {
        <div class="col-sm-6 col-md-2">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row">
                        <div class="col-5">
                            <div class="icon-big text-center">
                                <i class="@OrderEnumData.IconStatusOrder[i] text-@((OrderEnumData.SpanStatusOrder) i)"></i>
                            </div>
                        </div>
                        <div class="col-7 col-stats">
                            <div class="numbers">
                                <p class="card-category">@((OrderEnumData.StatusOrder)i)</p>
                                <h4 class="card-title">
                                @if(i == 0)
                                {
                                        @ViewBag.countCancelOrder
                                }
                                @if (i == 1)
                                {
                                        @ViewBag.countNewOrder
                                }
                                @if (i == 2)
                                {
                                        @ViewBag.countAcceptedOrder
                                }
                                @if (i == 3)
                                {
                                        @ViewBag.countDeliveryOrder
                                }
                                @if (i == 4)
                                {
                                        @ViewBag.countCompletedOrder
                                }
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="col-sm-6 col-md-2">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row">
                    <div class="col-5">
                        <div class="icon-big text-center">
                            <i class="fas fa-luggage-cart text-secondary"></i>
                        </div>
                    </div>
                    <div class="col-7 col-stats">
                        <div class="numbers">
                            <p class="card-category">Total Order</p>
                            <h4 class="card-title">@ViewBag.totalOrder</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row py-5">
    <div class="col-md-8"></div>
    <div class="col-md-4 ">
        <form asp-action="Index" asp-controller="Order">
            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search Order Code" class="form-control" name="searchOrderCode" value="@( ViewBag.searchOrderCode != "" ? ViewBag.searchOrderCode  : "" )">
                </div>
            </nav>
        </form>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User.UserName)
            </th>
          
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OrderCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User.UserName)
                </td>
 
                <td>
                    <span class="text text-@((OrderEnumData.SpanStatusOrder)item.Status)"> @((OrderEnumData.StatusOrder)item.Status) </span>
                </td>
                <td>
                    <a class="btn btn-info" asp-action="ViewOrder" asp-route-Id="@item.Id">ViewOrder</a>
                    @if(item.Status != 4)
                    {
                        <a asp-action="CancelOrder" class="btn btn-danger confirmDeletion" asp-controller="Order" asp-route-orderId="@item.Id">Cancel</a>
                    }            
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />

