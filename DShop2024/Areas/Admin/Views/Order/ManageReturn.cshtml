@model ManageReturnViewModel

@{
    ViewData["Title"] = "Manage return";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="row py-3">
    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row">
                    <div class="col-5">
                        <div class="text-center icon-return-page">
                            <i class="far fa-times-circle text-danger "></i>
                        </div>
                    </div>
                    <div class="col-7 col-stats">
                        <div class="numbers">
                            <p class="card-category">Rejected returned</p>
                            <h4 class="card-title">@Model.CountRejectedReturned</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row">
                    <div class="col-5">
                        <div class="text-center icon-return-page">
                            <i class="fas fa-chart-pie icon-part-return icon-return-page"></i>
                        </div>
                    </div>
                    <div class="col-7 col-stats">
                        <div class="numbers">
                            <p class="card-category">Partially Returned</p>
                            <h4 class="card-title">@Model.CountPartlyReturned</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row">
                    <div class="col-5">
                        <div class="text-center icon-return-page">
                            <i class="fas fa-check-circle icon-full-return icon-return-page"></i>
                        </div>
                    </div>
                    <div class="col-7 col-stats">
                        <div class="numbers">
                            <p class="card-category">Fully Returned</p>
                            <h4 class="card-title">@Model.CountFullyReturned</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="row">
                    <div class="col-5">
                        <div class="text-center icon-return-page">
                            <i class="fas fa-dolly text-primary icon-return-page"></i>
                        </div>
                    </div>
                    <div class="col-7 col-stats">
                        <div class="numbers">
                            <p class="card-category">Total quantity returned</p>
                            <h4 class="card-title">@Model.CountQuantityReturned</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row py-3">
    <div class="col-md-8"></div>
    <div class="col-md-4 ">
        <form asp-area="Admin" asp-action="ManageReturn" asp-controller="Order">
            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search ordercode, description, reason, customer name" class="form-control" name="search" value="@Model.Search">
                </div>
            </nav>
        </form>
    </div>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Order Code</th>
            <th>ReturnDate</th>
            <th>Total Refund Amount</th>
            <th>Shipping Cost</th>
            <th>User Name</th>
            <th>Return</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListReturn)
        {
            <tr>
                <td>
                    @if (String.IsNullOrEmpty(item.Reason))
                    {
                        <a asp-action="DetailPartReturn" asp-route-id="@item.Id">@item.OrderCode</a>
                    }
                    else
                    {
                        <a asp-action="DetailFullReturn" asp-route-id="@item.Id">@item.OrderCode</a>
                    }

                </td>
                <td>@item.ReturnDate.ToString("dd-MM-yyyy")</td>
                <td>@item.TotalRefundAmount.ToString("#,##0 VND")</td>
                <td>@item.ShippingCost.ToString("#,##0 VND")</td>
                <td>
                    @item.CustomerName
                </td>
                <td>
                    @if (item.IsFullReturn)
                    {
                        <span class="order-fullly-returned">@OrderEnumData.FULLY_RETURNED</span>
                    }
                    else
                    {
                        <span class="order-partially-returned">@OrderEnumData.PARTIALLY_RETURNED</span>
                    }
                </td>
                <td>
                    @((OrderEnumData.StatusReturn)item.Status)
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_PagingPartial" model="@Model.Paging" />


