@model ReturnViewModel

@{
    ViewData["Title"] = "Detail return";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="card">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8 col-xxl-7">
            <h2 class="text-uppercase mt-2">Invoice: @Model.OrderCode</h2>
            <div class="row gy-3 mb-3">
                <div class="col-md-12">
                    @if(Model.Status!= 1)
                    {
                        <div>
                            <h4 class="text-warning">Return has been updated by @Model.UpdateByName</h4>
                            <div class="avatar avatar-md">
                                <img src="~/media/avatar/@Model.UpdateByAvatar" class="avatar-img rounded">
                            </div>
                            <span> @Model.UpdateDate.ToString("MM/dd/yyyy h:mm tt")</span>
                        </div>
                    }
                    <div class="track">
                        @if(Model.Status == 0)
                        {
                            <h4 class="text-danger fw-bold">The order was refused for return.</h4>
                        }
                        else
                        {
                            <div class="step @(Model.Status >= 1 ? "active" : "")"> <span class="icon"> <i class="fa fa-check"></i> </span> <span class="text">Pending</span> </div>
                            <div class="step @(Model.Status >= 2 ? "active" : "")"> <span class="icon"> <i class="fa fa-user"></i> </span> <span class="text">Approved</span> </div>
                            <div class="step @(Model.Status >= 3 ? "active" : "")"> <span class="icon"> <i class="fa fa-truck"></i> </span> <span class="text">Refunded</span> </div>
                        }
                    </div>
                    <hr>
                </div>
            </div>
            <div class="row mb-3">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">
                            <span>FUll RETURN PRODUCT</span>
                        </h5>
                    </div>
                    <div class="modal-body">
                        <h3>Reason: @Model.Reason</h3>
                        @foreach (var img in Model.Images)
                        {
                            <img src="~/@img"
                                 class="thumb-preview" />
                        }
                        <p>
                            @Model.Description
                        </p>
                        <div class="fw-bold">Total Refund Amount @Model.TotalRefundAmount.ToString("#,##0 VND")</div>
                        <div class="fw-bold">Shipping Cost @Model.ShippingCost.ToString("#,##0 VND")</div>
                        @foreach (var item in Model.ReturnDetails)
                        {
                            <div class="product-row">
                                <div class="d-flex align-items-start mb-3">
                                    <img src="~/media/products/@item.ProductImage"
                                         class="product-return-img me-3" />

                                    <div>
                                        <div class="fw-semibold">@item.ProductName</div>
                                        <div class="fw-bold">@item.PricePerUnit.ToString("#,##0 VND")</div>
                                        <div class="fw-normal">Quantity @item.Quantity</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Chat" asp-action="ChatWithCustomer" asp-route-customerId="@Model.UserId">Inbox with customer</a>
                        @if (Model.Status != 0)
                        {
                            @if (Model.Status == 1)
                            {
                               
                                <a class="btn btn-info" asp-action="AcceptedReturnStatus" asp-route-Id="@Model.Id">Accept</a>
                                <a class="btn btn-danger" asp-action="RejectReturnStatus" asp-route-Id="@Model.Id">Reject</a>
                            }
                            @if (Model.Status == 2)
                            {
                                <button class="btn btn-info pull-right"
                                        onclick="openModal('/Admin/Order/GetPopUpRefundReturn?Id=@Model.Id')">
                                    <i class="fas fa-trash-alt"></i>
                                    Refund
                                </button>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="mt-3">
    <a asp-action="ManageReturn">Back to List</a>
</div>

<div class="modal fade" id="mainModal">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/custom/js/popup.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

