@model DShop2024.Models.OrderModel

@{
    ViewData["title"] = "Invoice";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<hr>
<section class="py-3 py-md-5 ">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-8 col-xxl-7">
                <div class="row gy-3 mb-3">
                    <div class="col-md-12">
                        <h2 class="text-uppercase text-endx m-0">Invoice: @Model.OrderCode</h2>
                    </div>
                    <div class="col-md-12">
                        @if(Model.Status == 0)
                        {
                            <h4>Invoice has been cancelled</h4>
                        }
                        else
                        {
                            <div class="track">
                                <div class="step @(Model.Status >= 1 ? "active" : "")"> <span class="icon"> <i class="fa fa-check"></i> </span> <span class="text">Order confirmed</span> </div>
                                <div class="step @(Model.Status >= 2 ? "active" : "")"> <span class="icon"> <i class="fa fa-user"></i> </span> <span class="text"> Picked by courier</span> </div>
                                <div class="step @(Model.Status >= 3 ? "active" : "")"> <span class="icon"> <i class="fa fa-truck"></i> </span> <span class="text"> On the way </span> </div>
                                <div class="step @(Model.Status == 4 ? "active" : "")"> <span class="icon"> <i class="fa fa-box"></i> </span> <span class="text">Ready for pickup</span> </div>
                            </div>
                        }
                        
                        <hr>
                    </div>
                    <div class="col-md-12">
        
                        <address>
                            <strong>@Model.CreatedDate.ToLongDateString()</strong><br>
                            @Model.CreatedDate.ToLongTimeString()<br>
                            Payment method: @Model.PaymentMethod<br>
                          
                        </address>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12 col-sm-6 col-md-8">
                        <h4>Bill To</h4>
                        <address>
                            <strong>@Model.User.UserName</strong><br>
                            Email: @Model.User.Email<br>
                            Consignee: @Model.Consignee<br>
                            Address: @Model.AddressDelivery<br>
                            Phone: @Model.PhoneDelivery
                        </address>
                    </div>
                </div>
                @if (Model.OrderCoupons.Count > 0)
                {
                    <div class="row mb-3">
                        <div class="col-12 col-sm-6 col-md-8">
                            <h4>Coupon Apply</h4>
                            <address>
                                @foreach (var coupon in Model.OrderCoupons)
                                {
                                    <strong>@coupon.Coupon.CouponCode</strong>

                                    <br>
                                    <span>Coupon Name: @coupon.Coupon.CouponName</span>

                                    <br>
                                    <span>Description: @coupon.Coupon.Description</span>

                                    <br>
                                    <br />
                                }
                            </address>
                        </div>
                    </div>
                }
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-uppercase">Stt</th>
                                        <th scope="col" class="text-uppercase">ProductId</th>
                                        <th scope="col" class="text-uppercase">Product Name</th>
                                        <th scope="col" class="text-uppercase">Quantity</th>
                                        <th scope="col" class="text-uppercase text-end">Unit Price</th>
                                        <th scope="col" class="text-uppercase text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    @{ int i = 1;}
                                    @foreach (var item in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td scope="row">@i</td>
                                            <td>@item.ProductId</td>
                                            <td>
                                                <p>@item.Product.ProductName</p>
                                                
                                                <img src="~/media/products/@item.Product.Image" width="120" height="100" />
                                            </td>
                                            <td>@item.Quantity</td>
                                            <td class="text-end">@item.Price</td>
                 
                                            <td class="text-end">@(item.Quantity * item.Price)</td>
                                        </tr>
                                        i++;
                                    }
                                    <tr >
                                         <td></td>
                                        <td></td>
                                        <td colspan="3" class="text-end">Subtotal</td>
                                        <td class="text-end">@Model.OrderDetails.Sum(od => od.Quantity * od.Price)</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td colspan="3" class="text-end">coupon</td>
                                        <td class="text-end">-@Model.ValueCoupon</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td colspan="3" class="text-end">Shipping Cost</td>
                                        <td class="text-end">+@Model.ShippingCost</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <th scope="row" colspan="3" class="text-uppercase text-end">Total</th>
                                        <td class="text-end">@Model.TotalPrice</td>
                                    </tr>

                                </tbody>


                            </table>
                        </div>
                    </div>
                </div>
                @if (Model.Status != 4 && Model.Status != 0)
                {
                    <div class="row">
                        <div class="col-12 text-end">
                            <a asp-action="UpdateStatusOrder" class="btn btn-primary mb-3" asp-controller="Order" asp-route-orderId="@Model.Id">Update status</a>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-12 text-end">
                            <a asp-action="CancelOrder" class="btn btn-danger mb-3 confirmDeletion" asp-controller="Order" asp-route-orderId="@Model.Id">Cancel invoice</a>
                        </div>
                    </div>
                }             
             
            </div>
        </div>
        </div>
</section>
<hr>
<a asp-action="Index">Back to List Order</a>