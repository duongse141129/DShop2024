@model OrderViewModel

@{
    ViewData["title"] = "Invoice";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<hr>
<section class="py-3 py-md-5 ">
    <div class="container ">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-8 col-xxl-7 card">
                <div class="row gy-3 my-3 ">
                    <div class="col-md-12">
                        <h2 class="text-uppercase text-endx m-0">Invoice: @Model.OrderCode</h2>
                    </div>
                    <div class="col-md-12">
                        @if(Model.IsReturn)
                        {
                            @if (Model.IsFullReturn)
                            {
                                <h3 class="text-warning">
                                    The order has been returned.
                                    <a class="link" asp-area="Admin" asp-controller="Order" asp-action="DetailFullReturn" asp-route-Id="@Model?.Return.Id"> See details here</a>
                                </h3>
                            }
                        }
                        else
                        {
                            @if (Model.Status == 0)
                            {
                                <div>
                                    <h4 class="text-danger">Invoice has been cancelled by @Model.UpdateByName</h4>
                                    <div class="avatar avatar-md">
                                        <img src="~/media/avatar/@Model.UpdateByAvatar" class="avatar-img rounded">
                                    </div>
                                    <span> @Model.DateUpdate.ToString("MM/dd/yyyy h:mm tt")</span>
                                </div>
                            }
                            else
                            {
                                <div class="track">
                                    <div class="step @(Model.Status >= 1 ? "active" : "")"> <span class="icon"> <i class="fa fa-check"></i> </span> <span class="text">Order confirmed</span> </div>
                                    <div class="step @(Model.Status >= 2 ? "active" : "")"> <span class="icon"> <i class="fa fa-user"></i> </span> <span class="text"> Picked by courier</span> </div>
                                    <div class="step @(Model.Status >= 3 ? "active" : "")"> <span class="icon"> <i class="fa fa-truck"></i> </span> <span class="text"> On the way </span> </div>
                                    <div class="step @(Model.Status == 4 ? "active" : "")"> <span class="icon"> <i class="fa fa-box"></i> </span> <span class="text">Ready for pickup</span> </div>
                                </div>
                                <div>
                                    <h4 class="text-info">Update by @Model.UpdateByName</h4>
                                    <div class="avatar avatar-md">
                                        <img src="~/media/avatar/@Model.UpdateByAvatar" class="avatar-img rounded">
                                    </div>
                                    <span> @Model.DateUpdate.ToString("MM/dd/yyyy h:mm tt")</span>
                                </div>
                            }
                           
                        }
                        <hr>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-6">
                        <address>
                            <strong>@Model.CreatedDate.ToLongDateString()</strong><br>
                            @Model.CreatedDate.ToLongTimeString()<br>
                            Payment method: @Model.PaymentName -                     
                            <span class="payment-status-@((OrderEnumData.PaymentStatusOrder)Model.PaymentStatus)">
                                @((OrderEnumData.PaymentStatusOrder)Model.PaymentStatus)
                            </span>
                            <br>
                        </address>
                        <h4>Bill To</h4>
                        <address>
                            <strong>@Model.CustomerName</strong><br>
                            Email: @Model.CustomerEmail<br>
                            Consignee: @Model.Consignee<br>
                            Address: @Model.AddressDelivery<br>
                            Phone: @Model.PhoneDelivery
                        </address>
                    </div>
                    <div class="col-sm-6">
                        <h4>Coupon Apply</h4>
                        @if (Model.OrderCoupons.Count > 0)
                        {
                            @foreach (var coupon in Model.OrderCoupons)
                            {
                                <b>@coupon.Coupon.CouponCode</b>
                            }
                        }
                    </div>
                </div>
               
                <div class="row mb-3">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-uppercase">Stt</th>
                                        <th scope="col" class="text-uppercase">Product Name</th>
                                        <th scope="col" class="text-uppercase">Quantity</th>
                                        <th scope="col" class="text-uppercase text-end">Price</th>
                                        <th scope="col" class="text-uppercase text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody class="table-group-divider">
                                    @{ int i = 1;}
                                    @foreach (var item in Model.OrderDetails)
                                    {
                                        <tr>
                                            <td scope="row">@i</td>
                                            <td>
                                                <a asp-area="Admin" asp-controller="ProductManage" asp-action="Detail" asp-route-Id="@item.ProductId">@item.ProductName</a>
                                                <img src="~/media/products/@item.MainImage" width="120" height="100" />
                                            </td>
                                            <td>@item.Quantity</td>
                                            <td class="text-end">@item.Price.ToString("#,##0 VND")</td>                             
                                            @{
                                                var subsum = item.Quantity * item.Price;
                                            }
                                            <td class="text-end">@subsum.ToString("#,##0 VND")</td>
                                        </tr>
                                        i++;
                                    }
                                    <tr >
                                        <td></td>
                                        <td colspan="3" class="text-end">Subtotal</td>
                                        <td class="text-end">@Model.OrderDetails.Sum(od => od.Quantity * od.Price).ToString("#,##0 VND")</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td colspan="3" class="text-end">coupon</td>
                                        <td class="text-end">-@Model.ValueCoupon.ToString("#,##0 VND")</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td colspan="3" class="text-end">Shipping Cost</td>
                                        <td class="text-end">+@Model.ShippingCost.ToString("#,##0 VND")</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <th scope="row" colspan="3" class="text-uppercase text-end">Total</th>
                                        <td class="text-end">@Model.GrandTotal.ToString("#,##0 VND")</td>
                                    </tr>

                                </tbody>


                            </table>
                        </div>
                    </div>
                </div>
                @if (Model.Status != 4 && Model.Status != 0)
                {
                    <div class="row">
                        <div class="col-12 text-end">
                            <a asp-action="UpdateStatusOrder" class="btn btn-primary mb-3" asp-controller="Order" asp-route-orderId="@Model.Id">Update status</a>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-12 text-end">
                            <a asp-action="CancelOrder" class="btn btn-danger mb-3 confirmDeletion" asp-controller="Order" asp-route-orderId="@Model.Id">Cancel invoice</a>
                        </div>
                    </div>
                }             
             
            </div>
        </div>
        </div>
</section>
<hr>
<a asp-action="Index">Back to List Order</a>