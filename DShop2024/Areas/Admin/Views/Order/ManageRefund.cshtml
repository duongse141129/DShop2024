@model IEnumerable<RefundModel>
@{
    ViewData["Title"] = "Manage refund";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<div class="row py-5">
    <div class="col-md-8"></div>
    <div class="col-md-4 ">
        <form asp-area="Admin" asp-action="ManageRefund" asp-controller="Order">
            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search ordercode, transaction, reason" class="form-control" name="search" value="@( ViewBag.search != "" ? ViewBag.search  : "" )">
                </div>
            </nav>
        </form>
    </div>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Create Date</th>
            <th>Order Code</th>
            <th>Total Refund Amount</th>
            <th>Reason</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CreateDate.ToString("dd-MM-yyyy")</td>
                <td>
                    @item.OrderCode
                </td>
                <td>@item.Amount.ToString("#,##0 VND")</td>
                <td>@item.Reason</td>
                <td>

                    <span class="text status-refund-@((OrderEnumData.StatusRefund)item.Status)">@((OrderEnumData.StatusRefund)item.Status)</span>
                </td>
                <td>
                    <a class="btn btn-info" asp-area="Admin" asp-controller="Order" asp-action="ViewRefund" asp-route-Id="@item.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
