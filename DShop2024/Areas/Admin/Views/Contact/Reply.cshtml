@model DShop2024.Models.ContactModel

@{
    ViewData["Title"] = "Reply email contact";
	Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="replay-box">
	<div class="row">
		<div class="col-sm-4">

			<h4>@Model.User.UserName</h4>
			<img src="~/media/avatar/@Model.User.Avatar" width="150" height="150" alt="">
			<p>@Model.User.Email</p>
			<p>@Model.DateSent</p>
			<p><strong>Subject:</strong> @Model.Subject</p>
			<p>@Model.Message</p>
		</div>
		<div class="col-sm-8">
			<h2>Leave a replay</h2>
			<form asp-action="Reply" method="post" asp-controller="Contact">
				<input type="hidden" name="IdContact" value="@Model.Id" />
				<div class="text-area">
					<div class="blank-arrow">
						<label>Reply Message</label>
					</div>
					<span>*</span>
					<textarea name="replyMessage" class="col-sm-12" rows="11"></textarea>
				</div>
				<input class="btn btn-primary" type="submit" value="REPLY" />
			</form>
		</div>
	</div>
</div><!--/Repaly Box-->

<div>
	<a asp-action="Index">Back to List</a>
</div>

