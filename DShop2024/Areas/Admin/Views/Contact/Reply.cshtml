@model DShop2024.Models.ContactModel

@{
    ViewData["Title"] = "Reply Contact";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">
            <i class="bi bi-reply-fill me-2"></i>Reply Contact
        </h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        Customer Information
                    </h5>
                </div>
                <div class="card-body text-center">
                    <img src="~/media/avatar/@Model.User.Avatar" class="rounded-circle border shadow-sm mb-3"  
                    width="140" height="140" style="object-fit:cover;" alt="Avatar">

                    <h5 class="fw-bold mb-1">
                        @Model.User.UserName
                    </h5>
                    <p class="text-muted mb-4">
                        @Model.User.Email
                    </p>
                    <hr />
                    <div class="text-start">
                        <p class="mb-2">
                            <strong>Date:</strong><br />
                            @Model.DateSent
                        </p>
                        <p class="mb-2">
                            <strong>Subject:</strong><br />
                            @Model.Subject
                        </p>
                        <div class="mt-3">
                            <strong>Customer Message</strong>
                            <div class="border rounded p-3 bg-light mt-2">
                                @Model.Message
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning">
                    <h5 class="mb-0 text-dark">
                        Write a Reply
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Reply" method="post" asp-controller="Contact">
                        <input type="hidden" name="IdContact" value="@Model.Id" />

                        <div class="mb-3">
                            <label for="replyMessageCus" class="form-label fw-semibold">
                                Reply Message
                            </label>
                            <textarea id="replyMessageCus" name="replyMessage" class="form-control" style="min-height:450px;" rows="30"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send-fill me-2"></i>
                                Send Reply
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {

    @{
        var summernote = new DShop2024.Models.Summernote("#replyMessageCus");
        @await Html.PartialAsync("_SummernotePartial", summernote)
    }

}


