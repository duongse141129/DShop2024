@model DShop2024.Models.ContactModel

@{
    ViewData["Title"] = "Reply email";
}

<h1>Send email</h1>

<div>
    <hr />
    <div class="row">

       <h4>@Model.User.UserName</h4>
        <p>@Model.User.Email</p>
        <p>@Model.DateSent</p>
        <p>@Model.Subject</p>
        <p>@Model.Message</p>

        <form asp-action="Reply" asp-controller="Contact" method="post" >
            <input type="hidden" value="@Model.Id" name="IdContact"/>
            <textarea name="replyMessage" ></textarea>
            <input type="submit" value="Reply" />
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>

