@model DShop2024.Models.ContactModel

@{
    ViewData["Title"] = "Reply email contact";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div>
	<div class="row">
		<div class="col-md-4">

			<h4>@Model.User.UserName</h4>
			<img src="~/media/avatar/@Model.User.Avatar" width="150" height="150" alt="">
			<p>@Model.User.Email</p>
			<p>@Model.DateSent</p>
			<p><strong>Subject:</strong> @Model.Subject</p>
			<p>@Model.Message</p>
		</div>
		<div class="col-md-8">
			<h2 class="text-warning">Leave a replay</h2>
			<form asp-action="Reply" method="post" asp-controller="Contact">
				<input type="hidden" name="IdContact" value="@Model.Id" />
				<label for="replyMessageCus">Reply Message</label>
				<textarea id="replyMessageCus" name="replyMessage" class="bg-white" rows="30"></textarea>
				<input class="btn btn-primary btn-lg" type="submit" value="Reply Contact" />
			</form>
		</div>
	</div>
</div><!--/Repaly Box-->

<div>
	<a asp-action="Index">Back to List</a>
</div>

@section Scripts {

    @{
		var summernote = new DShop2024.Models.Summernote("#replyMessageCus");
        @await Html.PartialAsync("_SummernotePartial", summernote);
    }


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
