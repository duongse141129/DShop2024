@model IEnumerable<ContactModel>
@{
    ViewData["title"] = "List contact";
}
<h4>Contact Admin</h4>

<table class="table table-striped" id="myTable">
    <thead>
        <tr>
 
            <th>User Name</th>
            <th>Email</th>
            <th>Date</th>
            <th>Subject</th>
            <th>Message</th>
            <th></th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User.UserName</td>
                <td>@item.User.Email</td>
                <td>@item.DateSent.ToShortDateString()</td>
                <td>@item.Subject</td>
                <td>@item.Message</td>
                <td>
                    <a asp-action="Reply" class="btn btn-primary btn-sm" asp-controller="Contact" asp-route-Id="@item.Id">Reply</a>
                    <a asp-action="Remove" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Contact" asp-route-Id="@item.Id">Remove</a>
                </td>

            </tr>
        }
    </tbody>
</table>

