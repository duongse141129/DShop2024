@model IEnumerable<ProductModel>

@{
    var keyword = ViewBag.Keyword as string ?? "";
}

@if (!Model.Any())
{
    <div class="search-empty">No product found</div>
}
else
{
    <ul class="list-group">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <input type="checkbox"
                           class="form-check-input product-check me-2"
                           data-id="@item.Id"
                           data-name="@item.ProductName"
                           data-image="@item.MainImage"
                           data-originalprice="@item.OriginalPrice"
                           data-price="@item.Price" />

                    @Html.Raw(Highlight(item.ProductName,keyword))
                    @item.Price.ToString("#,##0 VND")
                </div>
            </li>
        }
    </ul>

    <div class="mt-3 text-end">
        <button class="btn btn-primary" id="btnSelectProducts">
            Select products
        </button>
    </div>
}
@functions {
    string Highlight(string text, string keyword)
    {
        if (string.IsNullOrWhiteSpace(keyword)) return text;

        return System.Text.RegularExpressions.Regex.Replace(
            text,
            System.Text.RegularExpressions.Regex.Escape(keyword),
            m => $"<mark>{m.Value}</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );
    }
}