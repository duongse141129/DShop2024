@model IEnumerable<SaleViewModel>

@{
    ViewData["Title"] = "Manage Sales";
}

<h1 class="text-primary">@ViewData["title"]</h1>




<div class="row py-5">
    <div class="col-md-8">
        <div class="col-sm-4">
            <a class="btn btn-primary" asp-action="Create">Create sale</a>
        </div>
    </div>
    <div class="col-md-4 ">
        <form asp-area="Admin" asp-action="Index" asp-controller="Sale" method="post">
            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search Product Name" class="form-control" name="search" value="@( ViewBag.search != "" ? ViewBag.search : "" )" />
                </div>
            </nav>
        </form>
    </div>
</div>



<table class="table table-striped table-hover" >
    <thead>
        <tr>
            <th>
                Product
            </th>
            <th>
                Original Price
            </th>
            <th>
                Price
            </th>
            <th>
                Start date
            </th>
            <th>
                End date
            </th>
            <th>
                Status
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="d-flex flex-column align-items-start">
                        ID: @item.Product.Id
                        <a asp-area="Admin" asp-action="Detail" asp-controller="ProductManage" asp-route-id="@item.Product.Id">
                            @item.Product.ProductName
                        </a>
                        <img src="~/media/products/@item.Product.MainImage" width="125" height="150" />
                    </div>
                </td>
                <td>
                    @item.Product.OriginalPrice.ToString("#,##0 VND")
                </td>
                <td>
                    <span class="old-price">  @item.Product.Price.ToString("#,##0 VND")</span>
                    <span class="sale-price text-danger">  @item.SalePrice.ToString("#,##0 VND")</span>
                </td>
                <td>
                    @item.SaleStartDate.ToString("HH:mm MM-dd-yyyy")
                </td>
                <td>
                    @item.SaleEndDate.ToString("HH:mm MM-dd-yyyy")
                </td>
                <td>
                    <span class="text status-sale-@item.Status">@item.Status</span>
                </td>
                <td>
                    @if (User.IsInRole(RoleName.Administrator))
                    {
                        <div class="btn-group-2">
                            <button class="btn  btn-sm-2  btn-warning"
                                    onclick="openModal('/Admin/Sale/Edit?Id=@item.Id')">
                                Edit
                            </button>
                            <a class="btn btn-sm-2 btn-danger delete-sale" data-id="@item.Id">Delete</a>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_PagingPartial" model="@ViewBag.pagingModel" />

<div class="modal fade" id="mainModal">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/custom/js/popup.js"></script>
    <script>
        $(document).on('click', '.delete-sale', function () {
            var saleId = $(this).data('id');
            Swal.fire({
                title: 'Are you sure you want to delete?',
                text: "This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Delete'
            }).then((rs) => {
                if (rs.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Sale")',
                        type: 'POST',
                        data: { Id: saleId },
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            } else {
                                Swal.fire('Error', result.message, 'error');
                            }
                        }
                    });
                }
            });
        });
    </script>
}