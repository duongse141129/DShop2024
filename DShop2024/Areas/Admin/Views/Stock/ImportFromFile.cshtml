@using DShop2024.ViewModels
@model List<NameAndValueVM>

@{
    ViewData["Title"] = "Import products from file ";
    int num = 1;
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="row pt-2">
    <div class="col-md-12 py-2">
        <a asp-area="Admin" asp-action="Index" asp-controller="Stock">Back to stock in</a>
    </div>
</div>

<div class="row py-3">
    <div class="col-md-4">
        <form asp-area="Admin" asp-action="ImportFromFile" asp-controller="Stock" method="post" enctype="multipart/form-data">
            <div class="row">
                <label>Select file</label>
                <input type="file" name="file" />
            </div>
        
                <input type="submit" class="btn btn-primary" value="Read Excel file" />

        </form>
    </div>


    @if (Model != null && Model.Count() > 0)
    {
        <form asp-area="Admin" asp-action="Save" asp-controller="Stock" method="post">
        <div class="col-md-12 pt-2">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Stt</th>
                        <th scope="col">ProductName</th>
                        <th scope="col">Quantity</th>
                    </tr>
                </thead>
                <tbody>

                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>@num</td>
                                <td>@Model[i].label</td>
                                <td>@Model[i].value</td>
                                @Html.HiddenFor(m => m[i].label)
                                @Html.HiddenFor(m => m[i].value)
                            </tr>
                            {
                                num++;
                            }
                        }
                </tbody>
            </table>
        </div>
        <br/>
            <div class="col-md-12">
                <button type="submit" class="btn btn-success">Save</button>
            </div>
        </form> 
    }

</div>