    <script type="text/javascript">
        $(document).ready(function () {
            $('#PromotionId').on('change', function () {
                var promation = $("#PromotionId option:selected").text();
                if (promation == "FREE SHIPPING") {
                    $('#valuecoupon').val("50000");
                    $('#valuecoupon').attr('readonly', "");
                    $('#labelValue').text("Value");
                }
                else if (promation == "PERCENTAGE DISCOUNT") {
                    $('#valuecoupon').removeAttr('readonly');
                    $('#valuecoupon').attr('min', "1");
                    $('#valuecoupon').attr('max', "100");
                    $('#valuecoupon').attr('step', "1");
                    $('#valuecoupon').val("");
                    $('#labelValue').text("Value (%)");
                    
                }
                else if (promation == "SUB SUMTOTAL DISCOUNT") {
                    $('#valuecoupon').removeAttr('readonly');
                    $('#valuecoupon').attr('min', "1000");
                    $('#valuecoupon').attr('step', "1000");
                    $('#valuecoupon').val("");
                    $('#labelValue').text("Value VND");
                }
                return false;
            });
        });
    </script>
}