@model IEnumerable<CouponModel>

@{
    ViewData["Title"] = "Manage coupon";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>@ViewData["title"]</h1>
<hr />

<div class="container">
    <div class="col-md-5">
        <form asp-action="Index" asp-controller="Coupon">
            <div class="search_box pull-right">
                <input type="text" placeholder="search" name="search" value="@( ViewBag.search != "" ? ViewBag.search : "" )" />
                <button class="btn btn-warning btn-locgia" type="submit">Search</button>
            </div>
        </form>
        <a class="btn btn-info" asp-action="Create">Create New Coupon</a>
    </div>
    <div class="col-md-9">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Coupon Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Date Start</th>
                    <th>Date Expired</th>
                    <th>Quantity</th>
                    <th>Promotion</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CouponCode</td>
                        <td>@item.CouponName</td>
                        <td>@item.Description</td>
                        <td>@item.DateStart.ToString("dd-MM-yyyy")</td>
                        <td>@item.DateExpired.ToString("dd-MM-yyyy")</td>
                        <td>@item.Quantity</td>
                        <td>@item.Promotion.CategoryCouponName</td>
                        <td>

                            <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-route-id="@item.Id">Delete</a>
                        </td>
                        <td>

                            @if ( item.DateExpired.Date < DateTime.Today.Date)
                            {
                                <span class="text text-danger" >Expired</span>
                            }
                            else
                            {
                                TimeSpan remaingTime = item.DateExpired.Date - DateTime.Today.Date;
                                int daysRemaining = remaingTime.Days + 1;
                                @if(daysRemaining == 1)
                                {
                                    <span class="text text-success">Today</span>
                                }
                                else @if (daysRemaining > 1)
                                {
                                    <span class="text text-success">@daysRemaining days left</span>
                                }
                            }


                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
