@model IEnumerable<CouponModel>

@{
    ViewData["Title"] = "list coupon";
}


<hr />
<div class="row">
    <p>
        <a class="btn btn-primary" asp-action="Create">Create New Coupon</a>
    </p>
    <div class="col-md-9">
    <h5>List coupon</h5>
        <table class="table" id="myTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Date Start</th>
                    <th>Date Expired</th>
                    <th>Quantity</th>
                    <th>Promotion</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CouponName</td>
                        <td>@item.Description</td>
                        <td>@item.DateStart.ToString("dd-MM-yyyy")</td>
                        <td>@item.DateExpired.ToString("dd-MM-yyyy")</td>
                        <td>@item.Quantity</td>
                        <td>@item.Promotion.CategoryCouponName</td>
                        <td>
                            @* @if(item.Status == 1)
                            {
                                <select asp-for="Status" class="form-control">
                                    <option selected value="1"> Enable</option>
                                    <option value="-1"> Disable</option>
                                </select>
                            }
                            @if (item.Status == -1)
                            {
                                <select asp-for="Status" class="form-control">
                                    <option  value="1"> Enable</option>
                                    <option  selected value="-1"> Disable</option>
                                </select>
                            } *@
                            <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-route-id="@item.Id">Delete</a>
                        </td>
                        <td>
                            @* @if (item.DateExpired.Day < DateTime.Now.Day && item.DateExpired < DateTime.Now)
                            {
                                <span class="text text-danger" >Expired</span>
                            }
                            else
                            {
                                TimeSpan remaingTime = item.DateExpired - DateTime.Now;
                                int daysRemaining = remaingTime.Days;
                                @if(daysRemaining == 0)
                                {
                                    <span class="text text-danger">Today</span>
                                }
                                else
                                {
                                    <span class="text text-success">@daysRemaining days left</span>
                                }
                            } *@

                            @if ( item.DateExpired.Date < DateTime.Today.Date)
                            {
                                <span class="text text-danger" >Expired</span>
                            }
                            else
                            {
                                TimeSpan remaingTime = item.DateExpired.Date - DateTime.Today.Date;
                                int daysRemaining = remaingTime.Days + 1;
                                @if(daysRemaining == 1)
                                {
                                    <span class="text text-success">Today</span>
                                }
                                else @if (daysRemaining > 1)
                                {
                                    <span class="text text-success">@daysRemaining days left</span>
                                }
                            }


                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
