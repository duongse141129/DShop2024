@using DShop2024.ViewModels
@model IEnumerable<CouponViewModel>

@{
    ViewData["Title"] = "Manage coupon";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1 class="text-primary">@ViewData["title"]</h1>
<hr />

<div class="container">
    <div class="row py-5">
        <div class="col-md-8">
            @if (User.IsInRole(RoleName.Administrator))
            {
                <a class="btn btn-primary" asp-action="Create">Create New Coupon</a>
            }   
        </div>
        <div class="col-md-4 ">
            <form asp-action="Index" asp-controller="Coupon">
                <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <button type="submit" class="btn btn-search pe-1">
                                <i class="fa fa-search search-icon"></i>
                            </button>
                        </div>
                        <input type="text" placeholder="search" name="search" class="form-control" value="@( ViewBag.search != "" ? ViewBag.search : "" )" />
                    </div>
                </nav>
            </form>
        </div>
    </div>

    <div class="col-md-12">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Coupon Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Date Start</th>
                    <th>Date Expired</th>
                    <th>Quantity</th>
                    <th>Promotion</th>
                    <th>Status</th>
                    <th></th>
                    <th>Remaing Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CouponCode</td>
                        <td>@item.CouponName</td>
                        <td>@item.Description</td>
                        <td>@item.DateStart.ToString("dd-MM-yyyy")</td>
                        <td>@item.DateExpired.ToString("dd-MM-yyyy")</td>
                        <td>@item.Quantity</td>
                        <td>@item.CategoryCouponName</td>
                        <td>
                            @((CouponEnumData.StatusCoupon)item.Status)
                        </td>
                        <td>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                @if (item.Status == 1 && item.Quantity > 0 && item.DaysLeft != CouponEnumData.COUPON_EXPIRED)
                                {
                                    <a asp-action="ShowCoupon" class="btn btn-success btn-sm" asp-route-id="@item.Id">Show</a>
                                }
                                @if (item.Status == 2)
                                {
                                    <a asp-action="HideCoupon" class="btn btn-warning btn-sm" asp-route-id="@item.Id">Hide</a>
                                }
                                <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-route-id="@item.Id">Delete</a>
                            }
                        </td>
                        <td>
                            @if(item.DaysLeft == CouponEnumData.COUPON_EXPIRED)
                            {
                                <span class="text text-danger">@item.DaysLeft</span>
                            }
                            else
                            {
                                <span class="text text-success">@item.DaysLeft</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
