@model IEnumerable<DShop2024.Models.CategoryModel>

@{
    ViewData["Title"] = "Manage Category ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1 class="text-primary">@ViewData["title"]</h1>
@if (User.IsInRole(RoleName.Administrator))
{
    <div class="col-sm-4">
        <a class="btn btn-primary" asp-action="Create">Create New Category</a>
    </div>
}

<table class="table table-striped table-hover" id="myTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slug)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
                <td><img src="~/media/categories/@item.Image" width="120" height="100" /></td>
            <td>
                @Html.Raw(@item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Slug)
            </td>

            <td>
                    @if (User.IsInRole(RoleName.Administrator))
                    {
                        <div class="btn-group">
                            <a class="btn btn-sm-2 btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-sm-2 btn-danger confirmDeletion" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </div>
                    }
                             
            </td>
        </tr>
}
    </tbody>
</table>
 
