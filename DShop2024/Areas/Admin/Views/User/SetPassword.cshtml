@using DShop2024.Areas.Admin.Models.User
@model SetPasswordUserRequest
@{
    ViewData["Title"] = "Set password";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"] for: @ViewBag.userName</h1>


<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" asp-action="SetPassword" asp-controller="User" asp-area="Admin" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="id" value="@ViewBag.id" class="form-control" /> 
            <div class="form-group">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Set password</button>
    
        </form>
    </div>
    <div class="pt-5">
        <a asp-action="Index">Back to list</a>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
 