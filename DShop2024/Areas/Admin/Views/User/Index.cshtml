@using DShop2024.Areas.Admin.Models.User
@model IEnumerable<UserWithRoleViewModel>
@{
    ViewData["title"] = "List User";
}

<p>
    <a class="btn btn-warning btn-sm" asp-action="Create" asp-controller="User">Create New User</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Role</th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var userWithRoles in Model)
        {
            <tr>
                <td class="bg-primary" >@userWithRoles.User.Id</td>
                <td>@userWithRoles.User.UserName</td>
                <td>@userWithRoles.User.Email</td>
                <td>@userWithRoles.User.PhoneNumber</td>
                <td>
                    @if (userWithRoles.RoleName == null)
                    {
                        <a asp-action="SetRole" asp-controller="User" asp-route-id="@userWithRoles.User.Id">+ Add Role</a>
                    }
                    else if (userWithRoles.RoleName == RoleName.Administrator)
                    {
                        <p>@userWithRoles.RoleName</p>
                    }
                    else 
                    {
                        <a asp-action="SetRole" asp-controller="User" asp-route-id="@userWithRoles.User.Id">@userWithRoles.RoleName</a>
                    }
                   

                </td>
   
                <td>
                    @if (userWithRoles.RoleName != RoleName.Administrator)
                    {
                        <a class="btn btn-info btn-sm" asp-action="SetPassword" asp-controller="User" asp-route-id="@userWithRoles.User.Id">Change Password</a>
                        @if (userWithRoles.User.Status == 1)
                        {
                            <a class="btn btn-danger btn-sm confirmDeletion" asp-action="Delete" asp-controller="User" asp-route-id="@userWithRoles.User.Id">Remove</a>
                        }
                        @if (userWithRoles.User.Status == 0)
                        {
                            <a class="btn btn-success btn-sm confirmDeletion" asp-action="RecoverAccount" asp-controller="User" asp-route-id="@userWithRoles.User.Id">Recover account</a>
                        }
                    }
                    

                   
                </td>
            </tr>
        }
    </tbody>
</table>


