@using DShop2024.Areas.Admin.Models.User
@model IEnumerable<UserWithRoleViewModel>
@{
    ViewData["title"] = "Manage User";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="row">
    <div class="col-sm-12">
        <a class="btn btn-primary btn-md" asp-action="Create" asp-controller="User">Create New User</a>
    </div>
</div>
<div class="row py-3">
    <div class="col-md-3">

            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1" id="btnSearch">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input id="searchInput" type="text" placeholder="Search user name or email" class="form-control" name="search" value="@( ViewBag.search != "" ? ViewBag.search  : "" )" />
                </div>
            </nav>

    </div>
    <div class="col-md-9">
        <select id="roleFilter" class="form-control" asp-items="ViewBag.roles" style="width:200px;">
            <option value="">All Roles</option>
        </select>
    </div>
</div>

<div id="userTableContainer">
    <partial name="_UserListPartial" model="Model" />
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function loadData(page = 1) {
                var search = $('#searchInput').val();
                var role = $('#roleFilter').val();

                $.ajax({
                    url: '@Url.Action("Index", "User")',
                    type: 'GET',
                    data: {
                        p: page,
                        search: search,
                        roleName: role
                    },
                    success: function (result) {
                        $('#userTableContainer').html(result);
                    }
                });
            }

            $('#roleFilter').on('change', function () {
                loadData(1);
            });

            $('#btnSearch').on('click', function () {
                loadData(1);
            });

            $(document).on('click', '#userTableContainer .pagination a', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                var page = new URLSearchParams(url.split('?')[1]).get('p');
                loadData(page);
            });
        });
    </script>
}