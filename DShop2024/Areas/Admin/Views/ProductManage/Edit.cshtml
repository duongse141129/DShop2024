@using DShop2024.Areas.Admin.Models.Product
@model UpdateProductRequest
@{
    ViewData["title"] = "Edit Product";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="col-md-9">
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id"/>
        <div class="form-group">
            <label>Product Name</label>
            <input asp-for="ProductName" class="form-control" />
            <span asp-validation-for="ProductName" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea rows="15" asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Original Price (VND)</label>
            <input asp-for="OriginalPrice" class="form-control" />
            <span asp-validation-for="OriginalPrice" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Price (VND)</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Capacity (L)</label>
            <input asp-for="Capacity" class="form-control"  />
            <span asp-validation-for="Capacity" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Weight (KG)</label>
            <input asp-for="Weight" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Main pocket</label>
            <input asp-for="MainPocket" class="form-control" />
            <span asp-validation-for="MainPocket" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Dimension (CM)</label>
            <input asp-for="Dimension" class="form-control" />
            <span asp-validation-for="Dimension" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Material</label>
            <input asp-for="Material" class="form-control" />
            <span asp-validation-for="Material" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Laptop pocket (INCH)</label>
            <select asp-for="LaptopPocket" class="form-control" name="LaptopPocket" asp-items="ViewBag.laptopPocket">
            </select>
        </div>


        <div class="form-group">
            <label>Water Resistance</label>
            <input type="checkbox" asp-for="WaterResistance" class="form-check-input form-control-lg" />
            <span asp-validation-for="WaterResistance" class="text-danger" />
        </div>
        <div class="form-group">
            <label>USB Chargin gPort</label>
            <input type="checkbox" asp-for="USBChargingPort" class="form-check-input form-control-lg" />
            <span asp-validation-for="USBChargingPort" class="text-danger" />
        </div>

        <div class="form-group">
            <label>Category</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                <option>--Choose a category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Brand</label>
            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
                <option>--Choose a brand</option>
            </select>
            <span asp-validation-for="BrandId" class="text-danger" />
        </div>
        <div class="form-group">
            <label>Image</label>
            <input asp-for="ImageUpload" class="form-control" accept=".jpg,.png,.jpeg" />
            <span asp-validation-for="ImageUpload" class="text-danger" />
            <img src="~/media/products/@Model.MainImage" width="120" height="100" />
        </div>
        <div class="form-group">
            <img id="imgpreview" />
        </div>

        <div class="form-group">
            <button class="btn btn-primary btn-lg">Edit</button>
        </div>
    </form>

    <div class="col-md-6">
        <div class="card mt-3">
            <div class="card-header">
                <div class="card-title">Product's images </div>
            </div>
            <div class="card-body">
                @if (Model.ExistingImages.Count > 0)
                {
                    <table class="table table-head-bg-primary mt-4">
                        <thead>
                            <tr>
                                <th scope="col">Image</th>
                                <th scope="col">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ExistingImages)
                            {
                                <tr>
                                    <td> <img src="~/@item.ImagePath" width="120" height="100" /> </td>
                                    <td> <a asp-action="DeleteImage" class="btn btn-danger btn-md confirmDeletion" asp-controller="ProductManage" asp-route-Id="@item.Id">Delete</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <form asp-action="AddImages" method="post" enctype="multipart/form-data">
                    <div class="container">
                        <h2>Add more images</h2>
                        <input type="hidden" name="productId" value="@Model.Id" multiple class="form-control" />
                        <input type="file" asp-for="ImageFiles" id="file-input" multiple class="form-control" accept=".jpg,.png,.jpeg" onchange="preview()">
                        <span asp-validation-for="ImageFiles" class="text-danger" />
                        <label for="file-input" id="lbfile" class="text-white">
                            <i class="fas fa-upload"></i> &nbsp; Choose A Photo
                        </label>
                        <p id="num-of-files" style="display: none;">No Files Chosen</p>
                        <div id="previewImages"></div>
                    </div>
                    <input type="submit" class="btn btn-primary btn-md" value="AddImages">
                </form>

            </div>
        </div>
    </div>
    

    <a asp-action="Index">Back to list product  </a>
</div>


@section Scripts {
  
    @{
        var summernote = new DShop2024.Models.Summernote("#Description");
        @await Html.PartialAsync("_SummernotePartial", summernote);
    }

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#ImageUpload").change(function () {
            readURL(this);
        });
    </script>
}
