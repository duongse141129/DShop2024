@model IEnumerable<ProductViewModel>
@{
    ViewData["title"] = "View Products";
}
<h1 class="text-primary">@ViewData["title"]</h1>
<a asp-action="Index" asp-controller="Rating" asp-area="Admin" class="btn btn-success btn-md" id="btnModalPopup">Feedback</a> 
<div class="table-responsive">
<table class="table table-striped" id="myTable">
    <thead>
        <tr>
            <th scope="col">Stt</th>
            <th scope="col">Image</th>
            <th scope="col">ID</th>
            <th scope="col">Product Name</th>
            <th scope="col">Original Price</th>
            <th scope="col">Price</th>
            <th scope="col">Stock</th>
            <th scope="col">Category</th>
            <th scope="col">Brand</th>

        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@i</th>
                <td>
                        <img src="~/media/products/@item.MainImage"
                             class="rounded shadow-sm border"
                             width="100"
                             height="80"
                             style="object-fit:cover;">
                </td>
                <td>
                        <small class="text-muted">
                            @item.Id
                        </small>
                </td>
                <td>
                        <a class="fw-bold fs-5" asp-action="Detail" asp-controller="ProductManage" asp-route-Id="@item.Id">@item.ProductName</a>
                </td>
                    <td>@item.OriginalPrice.ToString("#,##0 VND")</td>
                <td>
                    @if (item.IsOnSale)
                    {
                        <span class="original-price" style="text-decoration: line-through;">@item.Price.ToString("#,##0")</span>
                        <span class="badge badge-danger text-white bg-danger">@item.DiscountPercent% off</span>
                        <div class="price text-danger">@item.SalePrice?.ToString("#,##0 VND")</div>
                    }
                    else
                    {
                        <span class="price">@item.Price.ToString("#,##0 VND")</span>
                    }
                </td>
                <td>
                        @if (item.Stock == 0)
                        {
                            <span class="badge bg-danger fs-6 px-3 py-2">
                                Out of stock
                            </span>
                        }
                        else if (item.Stock < 10)
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                @item.Stock items
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6 px-3 py-2">
                                @item.Stock items
                            </span>
                        }
                        <br />
                        <a asp-action="AddQuantity" asp-controller="ProductManage" asp-route-Id="@item.Id"><i class="fa fa-plus"></i> Add</a>
                </td>
                <td>@item.CategoryName</td>
                <td>@item.BrandName</td>

            </tr>
            i++;
        }

    </tbody>
</table>

</div>