@model DShop2024.Models.ReceivingStockModel

@{
    ViewData["Title"] = "Add quantity product ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var stt = 1;
}

<h1 class="text-primary">@ViewData["title"]</h1>

<div class="row">
    <div class="col-md-2">
        <h2>@ViewBag.product.ProductName</h2>
        <img src="~/media/products/@ViewBag.product.Image" class="img-fluid rounded" width="300" height="350" alt="">
        <form asp-action="StoreProductQuantity" asp-controller="ProductManage" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="ProductId" value="@ViewBag.product.Id" />
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input min="1" value="1" step="1" asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Add" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<h3>Receiving quantity product</h3>
<table class="table" id="myTable">
    <thead>
        <tr>
            <th>
                Stt
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateReceive)
            </th>
            <th>
                Name of person adding product quantity
            </th>
        </tr>
    </thead>
    <tbody>
        
        @foreach (var item in ViewBag.receivingStockList)
        {
            
            <tr>
                <td>
                    @stt
                </td>
                <td>
                    @item.Quantity
                </td>
                <td>
                    @item.DateReceive
                </td>
                <td>@item.User.UserName</td>
            </tr>
            stt++;
        }
         
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td>
                <div class="col-md-12">
                    <b>Total Quantities : @ViewBag.totalQuantity </b>
                </div>
                    <b>
                        Total Price : @ViewBag.totalOriginalPrice.ToString("#,##0 VND")
                    </b>
                </div>
            </td>
        </tr>
    </tbody>
</table>


<div>
    <a asp-action="Index">Back to List Product</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
