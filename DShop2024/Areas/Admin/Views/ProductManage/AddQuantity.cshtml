@model ReceivingStockModel

@{
    ViewData["Title"] = "Add quantity product ";
    var stt = 1;
}

<h1 class="text-primary">@ViewData["title"]</h1>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                    <img src="~/media/products/@ViewBag.product.MainImage" class="img-fluid rounded-3 product-image" alt="@ViewBag.product.ProductName">
                </div>
                <div class="col-md-7">
                    <div class="card-body p-4">
                        <h2 class="fw-bold mb-3"> @ViewBag.product.ProductName </h2>
                        <div class="mb-4">
                            <span class="fs-5 px-3 py-2">Original Price: @ViewBag.product.OriginalPrice.ToString("#,##0 VND")</span>
                        </div>

                        <form asp-action="StoreProductQuantity" asp-controller="ProductManage" >
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <input type="hidden" name="ProductId" value="@ViewBag.product.Id" />
                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                                <input min="1" value="1" step="1" asp-for="Quantity" class="form-control form-control-lg" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            <button type="submit"  class="btn btn-primary btn-lg w-100"> 
                                <i class="fas fa-plus-circle me-2"></i>
                                Add To Warehouse
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<h3>Receiving quantity product</h3>
<table class="table" id="myTable">
    <thead>
        <tr>
            <th>
                Stt
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateReceive)
            </th>
            <th>
                Name of person adding product quantity
            </th>
        </tr>
    </thead>
    <tbody>
        
        @foreach (var item in ViewBag.receivingStockList)
        {
            
            <tr>
                <td>
                    @stt
                </td>
                <td>
                    @item.Quantity
                </td>
                <td>
                    @item.DateReceive
                </td>
                <td>@item.User.UserName</td>
            </tr>
            stt++;
        }
         
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td>
                <div class="col-md-12">
                    <b>Total Quantities : @ViewBag.totalQuantity </b>
                </div>
                    <b>
                        Total Price : @ViewBag.totalOriginalPrice.ToString("#,##0 VND")
                    </b>
            </td>
        </tr>
    </tbody>
</table>


<div>
    <a asp-action="Index">Back to List Product</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
