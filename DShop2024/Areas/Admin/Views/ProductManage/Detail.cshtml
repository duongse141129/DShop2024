@model DShop2024.ViewModels.ProductDetailViewModel

@{
	ViewData["Title"] = "Details";
	Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div>
	<a asp-action="Edit" asp-route-id="@Model.ProductDetail?.Id">Edit</a> |
	<a asp-action="Index">Back to List</a>
</div>

<section>
	<div class="container">
		<div class="row">
			<div class="col-sm-9">
				<div class="blog-post-area">
					<h2 class="title text-center">Detail Product</h2>
					<div class="single-blog-post">
						<h3>@Model.ProductDetail.ProductName</h3>
						<div class="post-meta">
							<ul>
								<li><i class="fa fa-user"></i> Mac Doe</li>
								<li><i class="fa fa-clock-o"></i> 1:33 pm</li>
								<li><i class="fa fa-calendar"></i> DEC 5, 2013</li>
							</ul>
							<span>
								<i class="fa fa-star"></i>
								<i class="fa fa-star"></i>
								<i class="fa fa-star"></i>
								<i class="fa fa-star"></i>
								<i class="fa fa-star-half-o"></i>
							</span>
						</div>
						<a href="">
							<img src="~/media/products/@Model.ProductDetail.Image" alt="">
						</a>
						<dl class="row">
							<dd class="col-sm-10">
								@Html.Raw(@Model.ProductDetail.Description)
							</dd>
						</dl>
						<table class="table table-bordered table-striped">
							<thead class="thead-dark">
								<tr>
									<th scope="col"></th>
									<th scope="col">Product</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<th>Slug</th>
									<td>@Model.ProductDetail.Slug</td>
								</tr>
								<tr>
									<th>Original price (VND)</th>
									<td>@Model.ProductDetail.OriginalPrice</td>
								</tr>
								<tr>
									<th>Price</th>
									<td>@Model.ProductDetail.Price</td>
								</tr>
								<tr>
									<th>Brand</th>
									<td>@Model.ProductDetail.Brand.BrandName</td>
								</tr>
								<tr>
									<th>Category</th>
									<td>@Model.ProductDetail.Category.CategoryName</td>
								</tr>
								<tr>
									<th>Capacity (L)</th>
									<td>@Model.ProductDetail.Capacity</td>
								</tr>
								<tr>
									<th>Dimension (CM)</th>
									<td>@Model.ProductDetail.Dimension</td>
								</tr>
								<tr>
									<th>Weight (KG)</th>
									<td>@Model.ProductDetail.Weight</td>
								</tr>
								<tr>
									<th>Material</th>
									<td>@Model.ProductDetail.Material</td>
								</tr>
								<tr>
									<th>Compartment</th>
									<td>@Model.ProductDetail.Compartment</td>
								</tr>
								<tr>
									<th>Laptop pocket (INCH)</th>
									<td>@(Model.ProductDetail.LaptopPocket != null ? Model.ProductDetail.LaptopPocket : "No")</td>
								</tr>
								<tr>
									<th>WaterResistance</th>
									<td>@(Model.ProductDetail.WaterResistance == true ? "Yes" : "No")</td>
								</tr>
								<tr>
									<th>USBChargingPort</th>
									<td>@(Model.ProductDetail.USBChargingPort == true ? "Yes" : "No")</td>
								</tr>
						
							</tbody>
						</table>
						
					</div>
				</div><!--/blog-post-area-->

				<div class="rating-area">
					<ul class="ratings">
						<li class="rate-this">Rate this item:</li>
						<li>
							<i class="fa fa-star color"></i>
							<i class="fa fa-star color"></i>
							<i class="fa fa-star color"></i>
							<i class="fa fa-star"></i>
							<i class="fa fa-star"></i>
						</li>
						<li class="color">(@Model.listRating.Count() votes)</li>
					</ul>
					<p>
						Average point: @Model.Point
					</p>
				</div><!--/rating-area-->

				<div class="response-area">
					<h2>FEEDBACK</h2>
					<ul class="media-list">
						@foreach (var item in Model.listRating)
						{
							<li class="media">
								<a class="pull-left" href="#">
									<img class="media-object" src="~/media/avatar/imagesdefault.png" alt="">
								</a>
								<div class="media-body">
									<ul class="sinlge-post-meta">
										<li><i class="fa fa-user"></i>@item.User.UserName</li>
										<li><i class="fa fa-clock-o"></i>@item.RatingDateTime?.ToShortTimeString()</li>
										<li><i class="fa fa-calendar"></i>@item.RatingDateTime?.ToShortDateString()</li>
									</ul>
									<p>@item.Star</p>
									<p>@item.Comment</p>
								</div>
							</li>
						}

					</ul>
				</div><!--/Response-area-->
			</div>
		</div>
	</div>
</section>