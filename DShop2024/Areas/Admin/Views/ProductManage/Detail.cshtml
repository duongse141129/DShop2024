@model DShop2024.ViewModels.ProductDetailManageViewModel

@{
	ViewData["Title"] = "Details Product";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div>
	@if (User.IsInRole(RoleName.Administrator)){
		<a asp-action="Edit" asp-route-id="@Model.ProductDetail?.Id">Edit</a> 
	}
	|
	<a asp-action="Index">Back to List</a>
</div>

<section>
	<div class="container">
		<div class="row">
			<div class="col-sm-12">
				<div class="blog-post-area">
					<h2 class="title text-center">@Model.ProductDetail.ProductName</h2>
					<div class="single-blog-post pt-3">			
						<div class="row">
							<div class="col-lg-12">
								<img src="~/media/products/@Model.ProductDetail.MainImage" width="500" height="500" alt="">

								<div class="card mt-5">
									<div class="card-header">
										<div class="card-title">Images product</div>
									</div>
									<div class="card-body">
										<div class="row">
											@foreach (var item in Model.ExistingImages)
											{
												<div class="col-6 col-sm-2">
													<label class="imagecheck mb-4">
															<img src="~/@item" width="100" height="150" class="img-fluid rounded">
													</label>
												</div>
											}						
										</div>
									</div>
								</div>
								
							</div>
						</div>
						<h2 class="title text-center">Description Product</h2>
						<div class="card">
							
							<div class="card-body">
								<div class="col-md-12">
									@Html.Raw(Model.ProductDetail.Description)
								</div>
							</div>
						</div>


						<h2 class="title text-center">Item specifics</h2>
						<table class="table table-bordered table-striped">
							<thead class="thead-dark">
								<tr>
									<th scope="col"></th>
									<th scope="col">Product</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<th>Slug</th>
									<td>@Model.ProductDetail.Slug</td>
								</tr>
								<tr>
									<th>Original price (VND)</th>
									<td>@Model.ProductDetail.OriginalPrice.ToString("#,##0 VND")</td>
								</tr>
								<tr>
									<th>Price</th>
									<td>
										@if (User.IsInRole(RoleName.Administrator))
										{
											<a class="btn-link" onclick="openModal('/Admin/ProductManage/GetPopUpChangeSale?productId=@Model.ProductDetail.Id')">
												@if (Model.IsOnSale)
												{
													<div class="row">
														<div class="col-sm-12">
															<span style="text-decoration: line-through;">@Model.ProductDetail.Price.ToString("#,##0")</span>
															<span class="badge badge-danger text-white bg-secondary">@Model.DiscountPercent% off</span>
															<div class="fw-bold">@Model.SalePrice?.ToString("#,##0 VND")</div>
														</div>
													</div>
												}
												else
												{
													<span>@Model.ProductDetail.Price.ToString("#,##0 VND")</span>
												}
											</a>
										}
										else
										{
											@if (Model.IsOnSale)
											{
												<div class="row">
													<div class="col-sm-12">
														<span style="text-decoration: line-through;">@Model.ProductDetail.Price.ToString("#,##0")</span>
														<span class="badge badge-danger text-white bg-secondary">@Model.DiscountPercent% off</span>
														<div class="fw-bold">@Model.SalePrice?.ToString("#,##0 VND")</div>
													</div>
												</div>
											}
											else
											{
												<span>@Model.ProductDetail.Price.ToString("#,##0 VND")</span>
											}
										}

									</td>
								</tr>
								<tr>
									<th>Brand</th>
									<td>@Model.ProductDetail.Brand.BrandName</td>
								</tr>
								<tr>
									<th>Category</th>
									<td>@Model.ProductDetail.Category.CategoryName</td>
								</tr>
								<tr>
									<th>Capacity (L)</th>
									<td>@Model.ProductDetail.Capacity</td>
								</tr>
								<tr>
									<th>Dimension (CM)</th>
									<td>@Model.ProductDetail.Dimension</td>
								</tr>
								<tr>
									<th>Weight (KG)</th>
									<td>@Model.ProductDetail.Weight</td>
								</tr>
								<tr>
									<th>Material</th>
									<td>@Model.ProductDetail.Material</td>
								</tr>
								<tr>
									<th>Main Pockets</th>
									<td>@Model.ProductDetail.MainPocket</td>
								</tr>
								<tr>
									<th>Laptop pocket (INCH)</th>
									<td>@(Model.ProductDetail.LaptopPocket != null ? Model.ProductDetail.LaptopPocket : "No")</td>
								</tr>
								<tr>
									<th>WaterResistance</th>
									<td>@(Model.ProductDetail.WaterResistance == true ? "Yes" : "No")</td>
								</tr>
								<tr>
									<th>USBChargingPort</th>
									<td>@(Model.ProductDetail.USBChargingPort == true ? "Yes" : "No")</td>
								</tr>
								<tr>
									<th>Create at</th>
									<td>@Model.ProductDetail.CreateDate.ToString("MM/dd/yyyy h:mm tt")</td>
								</tr>


							</tbody>
						</table>
						
					</div>
				</div><!--/blog-post-area-->

				<div class="d-flex flex-wrap align-items-center gap-3 mb-4">

					<div>
						<span class="text-muted">Average Rating</span>
						<div class="fs-3 fw-bold text-warning">
							@Model.Point.ToString("0.00")
							<span class="fs-6 text-muted">/ 5</span>
						</div>
					</div>

					<div class="d-flex align-items-center">
						<div class="me-2 fs-5">
							<i class="fa fa-star @(Model.Point >= 1 ? "text-warning" : "")"></i>
							<i class="fa fa-star @(Model.Point >= 2 ? "text-warning" : "")"></i>
							<i class="fa fa-star @(Model.Point >= 3 ? "text-warning" : "")"></i>
							<i class="fa fa-star @(Model.Point >= 4 ? "text-warning" : "")"></i>
							<i class="fa fa-star @(Model.Point >= 5 ? "text-warning" : "")"></i>
						</div>
						<span class="badge bg-light text-dark border fs-5">
							@Model.ConutTotalFeedBack Reviews
						</span>
					</div>
				</div>


				<div id="feedback-section-container">
					<partial name="_FeedbackListAdminPartial" model="Model" />
				</div>

		</div>
	</div>
	</div>
</section>

<!-- Bootstrap Modal -->
<div class="modal fade" id="mainModal">
	<div class="modal-dialog">
		<div class="modal-content">
		</div>
	</div>
</div>
@section Scripts {
	<script src="~/custom/js/popup.js"></script>
	<script>
		$(document).on("click", "#feedback-section-container .ajax-pagination a", function (e) {
			e.preventDefault();
			var url = $(this).attr("href");
			if (!url || url === "#") return;
			$.ajax({
				url: url,
				type: 'GET',
				headers: { "X-Requested-With": "XMLHttpRequest" },
				success: function (data) {
					$('#feedback-section-container').html(data);
				},
				error: function () {
					Swal.fire({
						icon: "error",
						title: "Error",
						text: "Could not load feedback. Please try again."
					});
				}
			});
		});
	</script>
}
