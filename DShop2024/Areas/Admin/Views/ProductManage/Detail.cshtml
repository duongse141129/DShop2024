@model DShop2024.ViewModels.ProductDetailViewModel

@{
	ViewData["Title"] = "Details Product";
	Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div>
	<a asp-action="Edit" asp-route-id="@Model.ProductDetail?.Id">Edit</a> |
	<a asp-action="Index">Back to List</a>
</div>

<section>
	<div class="container">
		<div class="row">
			<div class="col-sm-12">
				<div class="blog-post-area">
					<h2 class="title text-center">@Model.ProductDetail.ProductName</h2>
					<div class="single-blog-post pt-3">			
						<div class="row">
							<div class="col-lg-12">
								<img src="~/media/products/@Model.ProductDetail.Image" width="500" height="500" alt="">

								<div class="card mt-5">
									<div class="card-header">
										<div class="card-title">Images product</div>
									</div>
									<div class="card-body">
										<div class="row">
											@foreach (var item in Model.ExistingImages)
											{
												<div class="col-6 col-sm-2">
													<label class="imagecheck mb-4">
															<img src="~/@item" width="100" height="150" class="img-fluid rounded">
													</label>
												</div>
											}						
										</div>
									</div>
								</div>
								
							</div>
						</div>
						<h2 class="title text-center">Description Product</h2>
						<div class="card">
							
							<div class="card-body">
								<div class="col-md-12">
									@Html.Raw(@Model.ProductDetail.Description)
								</div>
							</div>
						</div>

						<h2 class="title text-center">Item specifics</h2>
						<table class="table table-bordered table-striped">
							<thead class="thead-dark">
								<tr>
									<th scope="col"></th>
									<th scope="col">Product</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<th>Slug</th>
									<td>@Model.ProductDetail.Slug</td>
								</tr>
								<tr>
									<th>Original price (VND)</th>
									<td>@Model.ProductDetail.OriginalPrice</td>
								</tr>
								<tr>
									<th>Price</th>
									<td>@Model.ProductDetail.Price</td>
								</tr>
								<tr>
									<th>Brand</th>
									<td>@Model.ProductDetail.Brand.BrandName</td>
								</tr>
								<tr>
									<th>Category</th>
									<td>@Model.ProductDetail.Category.CategoryName</td>
								</tr>
								<tr>
									<th>Capacity (L)</th>
									<td>@Model.ProductDetail.Capacity</td>
								</tr>
								<tr>
									<th>Dimension (CM)</th>
									<td>@Model.ProductDetail.Dimension</td>
								</tr>
								<tr>
									<th>Weight (KG)</th>
									<td>@Model.ProductDetail.Weight</td>
								</tr>
								<tr>
									<th>Material</th>
									<td>@Model.ProductDetail.Material</td>
								</tr>
								<tr>
									<th>Main Pockets</th>
									<td>@Model.ProductDetail.MainPocket</td>
								</tr>
								<tr>
									<th>Laptop pocket (INCH)</th>
									<td>@(Model.ProductDetail.LaptopPocket != null ? Model.ProductDetail.LaptopPocket : "No")</td>
								</tr>
								<tr>
									<th>WaterResistance</th>
									<td>@(Model.ProductDetail.WaterResistance == true ? "Yes" : "No")</td>
								</tr>
								<tr>
									<th>USBChargingPort</th>
									<td>@(Model.ProductDetail.USBChargingPort == true ? "Yes" : "No")</td>
								</tr>
						
							</tbody>
						</table>
						
					</div>
				</div><!--/blog-post-area-->

				<p>
					Average point: @Model.Point.ToString("#.##")
				</p>
				<div class="rating-area">
					<ul class="ratings">
						<li class="rate-this">Rate this item:</li>
						<li>
							<i class="fa fa-star @( Model.Point >= 1 ? "color" : "")"></i>
							<i class="fa fa-star @( Model.Point >= 2 ? "color" : "")"></i>
							<i class="fa fa-star @( Model.Point >= 3 ? "color" : "")"></i>
							<i class="fa fa-star @( Model.Point >= 4 ? "color" : "")"></i>
							<i class="fa fa-star @( Model.Point >= 5 ? "color" : "")"></i>
						</li>
						<li class="color">(@Model.listRating.Count() votes)</li>
					</ul>

				</div><!--/rating-area-->

				<h2 class="title text-center">FEEDBACK</h2>
				<div class="response-area">					
					<div class="media-list">
						@foreach (var item in Model.listRating)
						{
							<div class="row pb-2">
								<div class="col-sm-2 ps-5">
									<img class="avatar-img rounded" src="~/media/avatar/@item.User.Avatar" width="120" height="120" alt="">
								</div>
								<div class="col-md-10">
									<ul class="sinlge-post-meta">
										<li><i class="fa fa-user"></i>@item.User.UserName</li>
										<li><i class="far fa-clock"></i>@item.RatingDateTime?.ToShortTimeString()</li>
										<li><i class="fa fa-calendar"></i>@item.RatingDateTime?.ToShortDateString()</li>
									</ul>
									<span>Point: @item.Star</span>
									<div class="d-fex ">
										<i class="fa fa-star @( item.Star >= 1 ? "text-warning" : "")"></i>
										<i class="fa fa-star @( item.Star >= 2 ? "text-warning" : "")"></i>
										<i class="fa fa-star @( item.Star >= 3 ? "text-warning" : "")"></i>
										<i class="fa fa-star @( item.Star >= 4 ? "text-warning" : "")"></i>
										<i class="fa fa-star @( item.Star >= 5 ? "text-warning" : "")"></i>
									</div>
									<p>@item.Comment</p>
								</div>
							</div>
						}
					</div> 


				</div><!--/Response-area-->
				@if (ViewBag.pagingmodel != null)
				{
					<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
				}
				
			</div>
		</div>
	</div>
</section>