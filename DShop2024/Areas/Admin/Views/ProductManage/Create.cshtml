@using DShop2024.Areas.Admin.Models.Product
@model CreateProductRequest
@{
    ViewData["title"] = "Create Product";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="col-md-9">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Product Name</label>
            <input asp-for="ProductName" class="form-control"/>
            <span asp-validation-for="ProductName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea rows="15" asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Original Price (VND)</label>
            <input asp-for="OriginalPrice" pattern="[0-9.,]+" class="form-control typing-originalPrice" />
            <span id="originalPrice-convert"></span>
            <span asp-validation-for="OriginalPrice" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Price (VND)</label>
            <input asp-for="Price" pattern="[0-9.,]+" class="form-control typing-price" />
            <span id="price-convert"></span>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Capacity (L)</label>
            <input asp-for="Capacity" class="form-control" />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Weight (KG)</label>
            <input asp-for="Weight" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Main pocket</label>
            <input asp-for="MainPocket" class="form-control" />
            <span asp-validation-for="MainPocket" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Dimension (CM)</label>
            <input asp-for="Dimension" class="form-control" />
            <span asp-validation-for="Dimension" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Material</label>
            <input asp-for="Material" class="form-control" />
            <span asp-validation-for="Material" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Laptop pocket (INCH)</label>
            <select asp-for="LaptopPocket" class="form-control" name="LaptopPocket" asp-items="ViewBag.laptopPocket">
            </select>
        </div>

      
        <div class="form-group">
            <label>Water Resistance</label>
            <input type="checkbox" asp-for="WaterResistance" class="form-check-input form-control-lg" />
            <span asp-validation-for="WaterResistance" class="text-danger"></span>
        </div>
        <div class="form-group col-2">
            <label>USB Charging Port</label>
            <input type="checkbox" asp-for="USBChargingPort" class="form-check-input form-control-lg" />
            <span asp-validation-for="USBChargingPort" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Category</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                <option>--Choose a category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Brand</label>
            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
                <option>--Choose a brand</option>
            </select>
            <span asp-validation-for="BrandId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Image</label>
            <input asp-for="ImageUpload" type="file" class="form-control" />
            <span asp-validation-for="ImageUpload" class="text-danger"></span>
        </div>
        <div>
            <img id="imgpreview" class="pt-2" />
        </div>
        <div class="form-group">
                <h2>Add more images</h2>
                <input type="file" asp-for="ImageFiles" id="file-input" multiple class="form-control" accept=".jpg,.png,.jpeg"   onchange="preview()">
                <span asp-validation-for="ImageFiles" class="text-danger" ></span>
                <label for="file-input" id="lbfile" class="text-white">
                    <i class="fas fa-upload"></i> &nbsp; Choose A Photo
                </label>
                <p id="num-of-files" style="display: none;">No Files Chosen</p>
                <div id="previewImages"></div>
        </div>


        <div class="form-group">
            <button class="btn btn-primary btn-lg">Create</button>
        </div>
    </form>
    <a asp-action="Index">Back to list product  </a>
</div>



@section Scripts {
    <link href="~/custom/Css/previewMultiImage.css" rel="stylesheet">
    <script src="~/custom/js/previewMultiImage.js"></script>

    @{
        var summernote = new DShop2024.Models.Summernote("#Description");
        @await Html.PartialAsync("_SummernotePartial", summernote);
    }
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");        
    }
    <script>
        $("#ImageUpload").change(function () {
            readURL(this);
        });
    </script>


    <script>
        $(".typing-price").on("keyup", function () {
            var currency_input = $(this).val();
            $("#price-convert").html(
                new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' }).format(currency_input)
            );
            
         });
        $(".typing-originalPrice").on("keyup", function () {
            var currency_input = $(this).val();
            $("#originalPrice-convert").html(
                new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' }).format(currency_input)
            );
        });
    </script>

}
