@model IEnumerable<ProductListViewModel>
@{
    ViewData["title"] = "Manage Products";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex gap-2 mb-4">
            <a asp-action="ManageRating" class="btn btn-success">Feedback</a>
            <a asp-area="Admin" asp-action="Create" asp-controller="ProductManage" class="btn btn-info">Create Product</a>
            <button type="button" class="btn btn-danger" id="btnDeleteSelected">Delete Selected</button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-lg-2 col-md-3">
                <label class="form-label fw-semibold">
                    Show Entries
                </label>
                <select id="pageSize" class="form-select">
                    <option value="10">10 entries</option>
                    <option value="20">20 entries</option>
                    <option value="35">35 entries</option>
                    <option value="50">50 entries</option>
                </select>
            </div>

            <div class="col-lg-10 col-md-9">
                <label class="form-label fw-semibold">
                    Visible Columns
                </label>
                <select id="columnSelector" class="form-select" multiple>
                    <option value="box" selected>Select to delete</option>
                    <option value="stt" selected>Stt</option>
                    <option value="image" selected>Image</option>
                    <option value="id" selected>Id</option>
                    <option value="productname" selected>Product Name</option>
                    <option value="originalprice" selected>Original Price</option>
                    <option value="price" selected>Price</option>
                    <option value="stock" selected>Stock</option>
                    <option value="brand" selected>Brand</option>
                    <option value="category" selected>Category</option>
                    <option value="averagepoint">Average Point</option>
                    <option value="quantitysold">Quantity Sold</option>
                    <option value="wishlistcount">Wishlist Count</option>
                    <option value="action" selected>Action</option>
                </select>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-3">
                <label class="form-label fw-semibold">
                    Search Product
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fa fa-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Search product..." name="search" value="@ViewBag.Search" id="searchInput">
                </div>
            </div>
            <div class="col-lg-3">
                <label class="form-label fw-semibold">
                    Brand
                </label>
                <select class="form-select" asp-items="ViewBag.Brands" id="brand_by">
                    <option value="">All Brands</option>
                </select>
            </div>

            <div class="col-lg-3">
                <label class="form-label fw-semibold">
                    Category
                </label>
                <select class="form-select" asp-items="ViewBag.Categories" id="category_by">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-lg-3">
                <input type="checkbox" class="btn-check" id="IsSale" name="IsSale" value="true" @(ViewBag.IsSale ? "checked" : "")>
                <label class="btn btn-sync-style w-50" for="IsSale"><i class="fas fa-tag"></i> Sale</label>
            </div>

        </div>
    </div>
</div>

<div class="table-responsive my-3">
    <div id="productRowContainer">
        <partial name="_ProductListPartial" model="Model" />
    </div>
</div>



<div class="modal fade" id="mainModal">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/multiple-select/multiple-select.min.css" />
    <script src="~/lib/multiple-select//multiple-select.min.js"></script>
    <script>
        $("#columnSelector").multipleSelect({
            selectAll: false,
            keepOpen: false,
            isOpen: false,
        });
    </script>
    <script>
        let tablefilter;
        function initDataTable() {
            if ($.fn.DataTable.isDataTable('#table-product-filter')) {
                $('#table-product-filter').DataTable().destroy();
            }

            tablefilter = new DataTable('#table-product-filter', {
                stateSave: false,
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'copy',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                extend: 'csv',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                extend: 'excel',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                extend: 'pdf',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                extend: 'print',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            }
                        ]
                    }
                },
                paging: false,
                searching: false,
                ordering: false,
                info: false,
                autoWidth: false
            });

            updateColumnVisibility();
        }

        $(document).ready(function () {
            initDataTable();
        });
    </script>

    <script>
        $(document).ready(function () {
            const defaultColumns = [
                'box',
                'stt',
                'image',
                'id',
                'productname',
                'originalprice',
                'price',
                'stock',
                'brand',
                'category',
                'action'
            ];

            $('#columnSelector').val(defaultColumns);
            $('#columnSelector').multipleSelect('setSelects', defaultColumns);
            updateColumnVisibility();
        });


        const columnMap = {
            box: 0,
            stt: 1,
            image: 2,
            id: 3,
            productname: 4,
            originalprice: 5,
            price: 6,
            stock: 7,
            brand: 8,
            category: 9,
            averagepoint: 10,
            quantitysold: 11,
            wishlistcount: 12,
            action: 13
        };

        function updateColumnVisibility() {
            let selectedColumns = $('#columnSelector').val() || [];
            Object.keys(columnMap).forEach(function (columnName) {
                let index = columnMap[columnName];
                tablefilter.column(index).visible(selectedColumns.includes(columnName));
            });
        }

        $('#columnSelector').change(function () {
            updateColumnVisibility();
        });

        $(document).ready(function () {
            updateColumnVisibility();
        });

    </script>

    <script>
        $(document).ready(function () {
        let currentSortColumn = "Id";
        let currentSortOrder = "desc";

            function updateSortIcons() {
                $('.sort-column').removeClass('active');
                $('.sort-column .sort-icon').html(
                    '<i class="fas fa-caret-down text-muted"></i>'
                );
                let current = $('.sort-column[data-column="' + currentSortColumn + '"]');
                current.addClass('active');

                if (currentSortOrder === 'asc') {
                    current.find('.sort-icon').html(
                        '<i class="fas fa-caret-up text-warning"></i>'
                    );
                }
                else {
                    current.find('.sort-icon').html(
                        '<i class="fas fa-caret-down text-warning"></i>'
                    );
                }
            }

            function loadData(page = 1) {
                var search = $('#searchInput').val();
                var brand = $('#brand_by').val();
                var category = $('#category_by').val();
                var pageSize = $('#pageSize').val();
                var isSale = $('#IsSale').is(':checked');

                $.ajax({
                    url: '@Url.Action("Index", "ProductManage")',
                    type: 'GET',
                    data: {
                        p: page,
                        pagesSize: pageSize,
                        search: search,
                        brand_by: brand,
                        category_by: category,
                        isSale: isSale,
                        sortColumn: currentSortColumn,
                        sortOrder: currentSortOrder,

                    },
                    success: function (result) {
                        $('#productRowContainer').html(result);
                        initDataTable();
                        updateSortIcons();
                    }
                });
            }

            $('#brand_by').on('change', function () {
                loadData(1);
            });
            $('#category_by').on('change', function () {
                loadData(1);
            });
            $('#IsSale').on('change', function () {
                loadData(1);
            });

            let searchTimer;
            $(document).on("input", "input[name='search']", function () {
                let val = $(this).val();
                clearTimeout(searchTimer);
                if (val === "") {
                     loadData(1);
                } else {
                    searchTimer = setTimeout(function() {
                         loadData(1);
                    }, 500);
                }
            });

            $('#pageSize').change(function () {
                loadData(1);
            });

            $(document).on('click', '#productRowContainer .pagination a', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');
                var page = new URLSearchParams(url.split('?')[1]).get('p');
                loadData(page);
            });

            $(document).on('click', '.sort-column', function (e) {
                e.preventDefault();
                let column = $(this).data('column');
                if (currentSortColumn === column) {
                    currentSortOrder =
                        currentSortOrder === 'asc'
                            ? 'desc'
                            : 'asc';
                }
                else {
                    currentSortColumn = column;
                    currentSortOrder = 'asc';
                }
                loadData(1);
            });

            updateSortIcons();
        });
    </script>


    <script>
            $('#btnDeleteSelected').click(function () {
            var selectedIds = [];
            $('input[name="IdProductsToDelete"]:checked').each(function () {
                selectedIds.push(parseInt($(this).val()));
            });

            if (selectedIds.length === 0) {
                alert("Please select at least one product.");
                return;
            }

            $.ajax({
                url: '/Admin/ProductManage/DeleteMultiProductPopup',
                type: 'GET',
                data: { IdProductsToDelete: selectedIds },
                traditional: true,
                success: function (data) {
                    $('#mainModal .modal-content').html(data);
                    $('#mainModal').modal('show');
                }
            });
        });
    </script>

    <script src="~/custom/js/popup.js"></script>
}









