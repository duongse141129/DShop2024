@model IEnumerable<AssignmentModel>
@{
    ViewData["title"] = "Assignment Page";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="body">
    <div class="container-calendar">
        <div class="left">
            <div class="calendar">
                <div class="month">
                    <i class="fas fa-angle-left prev"></i>
                    <div class="date">december 2015</div>
                    <i class="fas fa-angle-right next"></i>
                </div>
                <div class="weekdays">
                    <div>Sun</div>
                    <div>Mon</div>
                    <div>Tue</div>
                    <div>Wed</div>
                    <div>Thu</div>
                    <div>Fri</div>
                    <div>Sat</div>
                </div>
                <div class="days"></div>
                <div class="goto-today">
                    <div class="goto">
                        <input type="text" placeholder="mm/yyyy" class="date-input" />
                        <button class="goto-btn">Go</button>
                    </div>
                    <button class="today-btn">Today</button>
                </div>
            </div>
        </div>
        <div class="right">
            <div class="today-date">
                <div class="event-day">wed</div>
                <div class="event-date">12th december 2022</div>
            </div>
            <div class="events"></div>
        </div>
        <button class="add-event"
                onclick="openCreateAssignment()">
            <i class="fas fa-plus"></i>
        </button>

    </div>
</div>


<div class="modal fade" id="mainModal">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/custom/js/popup.js"></script>
    <link href="~/custom/Css/calendar.css" rel="stylesheet">
    <script src="~/custom/js/calendar.js"></script>

    <link href="~/lib/clockpicker/jquery-clockpicker.min.css" rel="stylesheet" />
    <script src="~/lib/clockpicker/jquery-clockpicker.min.js"></script>
    <link href="~/lib/clockpicker/bootstrap-clockpicker.min.css" rel="stylesheet" />
    <script src="~/lib/clockpicker/bootstrap-clockpicker.min.js"></script>

}
