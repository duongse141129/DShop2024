@using DShop2024.Areas.Admin.Models.Task
@model CreateAssignmentRequest
﻿@{
    ViewData["Title"] = "Create assignment";
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title text-primary">@ViewData["Title"]</h5>
    <button class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="model-body">
    <form id="formData">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <input type="hidden"  name="StartDate" value="@ViewBag.DatePick" />
            <input type="hidden"  name="EndDate" value="@ViewBag.DatePickEnd" />
            <strong>Date @ViewBag.SelectedDates</strong>
        </div>

        <div class="form-group">
            <div class="row">
                <div class="col-sm-6">
                    <label asp-for="TimeFrom" class="control-label"></label>
                    <div class="input-group clockpicker">
                        <span></span>
                        <input type="text" name="TimeFrom" class="form-control" value="7:00">
                        <span class="input-group-addon">
                            <span class="glyphicon glyphicon-time"></span>
                        </span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label asp-for="TimeTo" class="control-label"></label>
                    <div class="input-group clockpicker">
                        <span></span>
                        <input type="text" name="TimeTo" class="form-control" value="8:00">
                        <span class="input-group-addon">
                            <span class="glyphicon glyphicon-time"></span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="AssignmentDetails" class="control-label"></label>
            <textarea asp-for="AssignmentDetails" class="form-control" rows="5"></textarea>
            <span asp-validation-for="AssignmentDetails" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Task</label>
            <select asp-for="TaskId" class="form-control" asp-items="ViewBag.Tasks">
                <option value="">--Choose a task</option>
            </select>
            <span asp-validation-for="TaskId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Employee</label>

                <div class="employee-select-container" id="employeeSelect">
                    <div class="select-trigger">
                        <img alt="" id="selected-img">
                        <span id="selected-text">Select an option</span>
                        <div class="arrow"></div>
                    </div>
                    <ul class="options-list">
                        @foreach (var item in ViewBag.PickEmployees as IEnumerable<AppUserModel>)
                        {
                            <li data-value="@item.Id" data-img="/media/avatar/@item.Avatar">
                                <img src="~/media/avatar/@item.Avatar" alt="@item.UserName">
                                <span>@item.UserName</span>
                            </li>
                        }
                    </ul>
                </div>
            <input type="hidden" id="hidden-input" asp-for="EmployeeUserID">
            <span asp-validation-for="EmployeeUserID" class="text-danger"></span>

        </div>

 

        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>


    </form>
</div>

<link href="~/custom/Css/selectListImage.css" rel="stylesheet">
<script src="~/custom/js/selectListImage.js"></script>

<script>
    $("#formData").submit(function (e) {
        e.preventDefault();
        $.ajax({
            method: "POST",
            url: "@Url.Action("Create", "Assignment", new { area = "Admin" })",
            data: $(this).serialize(),
                success: function (result) {
                    if (result.success) {
                        Swal.fire(
                                {
                                      position: "top-end",
                                      icon: "success",
                                      title: result.message,
                                      showConfirmButton: false,
                                      timer: 500
                                }
                        );
                        loadTasks();
                    } else {
                            Swal.fire({
                              icon: "error",
                              title: "Oops...",
                              text: result.message
                            });
                    }
            }
        });
    });
</script>
<script type="text/javascript">
    $('.clockpicker').clockpicker({
        placement: 'bottom',
        align: 'left',
        autoclose: true,
        donetext: 'Done'
    });

</script>
<script>
    $(document).ready(function () {
        if ($.validator) {
            $.validator.setDefaults({
                ignore: []
            });
        }
    });
</script>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
