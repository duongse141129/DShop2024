﻿@{
    ViewData["Title"] = "Delete all assignments";
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title text-primary">@ViewData["Title"]</h5>
    <button class="btn-close" data-bs-dismiss="modal"></button>
</div>
<form id="formData">
    <div class="model-body">
 
            <div class="form-group">
                <input type="hidden" name="StartDate" value="@ViewBag.DatePick" />
                <input type="hidden" name="EndDate" value="@ViewBag.DatePickEnd" />
                <strong></strong>
            </div>
            <div class="form-group">
                <p class="text-black">Are you sure you want to delete all assigned tasks for the <strong> @ViewBag.SelectedDates</strong>?</p>
            </div>
 
    </div>
    <div class="modal-footer">
        <button class="btn btn-danger" >Delete</button>
    </div>
</form>
<script>
    $("#formData").submit(function (e) {
        e.preventDefault();
        $.ajax({
            method: "POST",
            url: "@Url.Action("DeleteAllConfirm", "Assignment", new { area = "Admin" })",
            data: $(this).serialize(),
                success: function (result) {
                    if (result.success) {
                        Swal.fire(
                                {
                                      position: "top-end",
                                      icon: "success",
                                      title: result.message,
                                      showConfirmButton: false,
                                      timer: 500
                                }
                        );
                        loadTasks();
                    } else {
                            Swal.fire({
                              icon: "error",
                              title: "Oops...",
                              text: result.message
                            });
                    }
            }
        });
    });
</script>