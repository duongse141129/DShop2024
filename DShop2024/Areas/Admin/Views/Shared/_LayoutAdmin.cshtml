    <script>
        $(function () {

            var message = '@TempData[DShopConst.TEMPDATA_SUCCESS]';
            if (message != '') {
                Swal.fire({
                    title: message,
                    icon: "success",
                    draggable: true
                });
            }
            var messageFail = '@TempData[DShopConst.TEMPDATA_ERROR]';
            if (messageFail != '') {
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: messageFail
                });
            }
        });
    </script>

