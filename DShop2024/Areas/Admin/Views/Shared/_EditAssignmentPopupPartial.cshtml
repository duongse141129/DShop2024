@using DShop2024.Areas.Admin.Models.Task
@model EditAssignmentRequest
﻿@{
    ViewData["Title"] = "Edit assignment";
    Layout = null;
}

<div class="modal-header">
    <h5 class="text-primary">@ViewData["Title"]</h5>
    <button class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form id="formData" >
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Date" />
    <input type="hidden" asp-for="Status" />

    <div class="form-group">
        <div class="row">
            <div class="col-sm-6">
                <label class="control-label">TimeFrom</label>
                <div class="input-group clockpicker">
                    <span></span>
                    <input type="text" name="TimeFrom" class="form-control" value="@Model.TimeTo.ToString(@"hh\:mm")">
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-time"></span>
                    </span>
                </div>
            </div>
            <div class="col-sm-6">
                <label asp-for="TimeTo" class="control-label"></label>
                <div class="input-group clockpicker">
                    <span></span>
                    <input type="text" name="TimeTo" class="form-control" value="@Model.TimeFrom.ToString(@"hh\:mm")">
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-time"></span>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="AssignmentDetails" class="control-label"></label>
        <textarea asp-for="AssignmentDetails" class="form-control" rows="5"></textarea>
        <span asp-validation-for="AssignmentDetails" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Task</label>
        <select asp-for="TaskID" class="form-control" asp-items="ViewBag.Tasks">
            <option value="">--Choose a task</option>
        </select>
        <span asp-validation-for="TaskID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Employee</label>
        <select asp-for="EmployeeUserID" class="form-control" asp-items="ViewBag.Employees">
            <option value="">--Choose a employee</option>
        </select>
        <span asp-validation-for="EmployeeUserID" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Edit" class="btn btn-primary" />
    </div>
</form>
<script>
    $("#formData").submit(function (e) {
        e.preventDefault();
        $.ajax({
            method: "POST",
            url: "@Url.Action("Edit", "Assignment", new { area = "Admin" })",
            data: $(this).serialize(),
                success: function (result) {
                    if (result.success) {
                        Swal.fire(
                                {
                                      position: "top-end",
                                      icon: "success",
                                      title: result.message,
                                      showConfirmButton: false,
                                      timer: 500
                                }
                        );
                          var dateString =  $('#Date').val();
                          setActiveDay(dateString);
                    } else {
                            Swal.fire({
                              icon: "error",
                              title: "Oops...",
                              text: result.message
                            });
                    }
            }
        });
    });
</script>
<script type="text/javascript">
    $('.clockpicker').clockpicker({
        placement: 'bottom',
        align: 'left',
        autoclose: true,
        donetext: 'Done'
    });

</script>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
