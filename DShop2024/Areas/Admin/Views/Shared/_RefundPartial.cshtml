@using DShop2024.Areas.Admin.Models.Refund
@model UpdateRefundRequest
﻿@{
    ViewData["Title"] = "Refund PopUp";
    Layout = null;
}

    <div class="modal-header">
    <h5 class="modal-title">@ViewData["Title"]</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
    </div>
<form id="formData" method="post" asp-area="Admin" asp-controller="Order"  asp-action="RefundOder" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger" ></div>
    <input type="hidden" asp-for="Id" />
    <div class="modal-body">
        <div class="form-group">
            <label>Order Code</label>
            <input asp-for="OrderCode" readonly class="form-control" />
        </div>
        <div class="form-group">
            <label>Amount</label>
            <input class="form-control" value="@Model.Amount.ToString("#,##0 VND")" readonly />
            <input type="hidden" asp-for="Amount" />
        </div>
        <div class="form-group">
            <label>Reason</label>
            <input asp-for="Reason" readonly class="form-control" />
        </div>
        <div class="form-group">
            <label>Create Date</label>
            <input class="form-control" value="@Model.CreateDate.ToString("MM/dd/yyyy h:mm tt")" readonly />
            <input type="hidden" asp-for="CreateDate" />
        </div>
        <div class="form-group">
            <label>Transaction Id</label>
            <input asp-for="TransactionId" class="form-control" />
            <span asp-validation-for="TransactionId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="TransactionContent" class="form-label"></label>
            <textarea asp-for="TransactionContent" class="form-control" rows="5"></textarea>
            <span asp-validation-for="TransactionContent" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Payment menthod</label>
            <select asp-for="PaymentId" class="form-control" asp-items="ViewBag.Payments">
            </select>
            <span asp-validation-for="PaymentId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>Image</label>
            <input asp-for="ImageUpload" type="file" class="form-control" />
            <span asp-validation-for="ImageUpload" class="text-danger"></span>
        </div>
        <div>
            <img id="imgpreview" class="pt-2" />
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Refund</button>
    </div>
</form>
<script>
    $("#ImageUpload").change(function () {
        readURL(this);
    });
</script>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}