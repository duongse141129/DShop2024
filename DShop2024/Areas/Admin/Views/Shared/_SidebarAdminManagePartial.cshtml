
<div class="sidebar" data-background-color="dark">
    <div class="sidebar-logo">
        <!-- Logo Header -->
        <div class="logo-header" data-background-color="purple">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="logo" >
                @await Component.InvokeAsync("LogoShop")
            </a>
            <div class="nav-toggle">
                <button class="btn btn-toggle toggle-sidebar">
                    <i class="gg-menu-right"></i>
                </button>
                <button class="btn btn-toggle sidenav-toggler">
                    <i class="gg-menu-left"></i>
                </button>
            </div>
            <button class="topbar-toggler more">
                <i class="gg-more-vertical-alt"></i>
            </button>
        </div>
        <!-- End Logo Header -->
    </div>
    <div class="sidebar-wrapper scrollbar scrollbar-inner">
        <div class="sidebar-content">
            <ul class="nav nav-secondary">
                <li class="nav-item @( ViewBag.sidebar == "dashboard" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fas fa-chart-bar"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" >
                        <i class="fas fa-home"></i>
                        <p>Home</p>
                    </a>
                </li>
                
                <li class="nav-section">
                    <span class="sidebar-mini-icon">
                        <i class="fa fa-ellipsis-h"></i>
                    </span>
                    <h4 class="text-section">Components</h4>
                </li>

                <li class="nav-item @( ViewBag.sidebar == "brand" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#brand">
                        <i class="fas fa-layer-group"></i>
                        <p>Brand</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="brand">
                        <ul class="nav nav-collapse">
                            <li>
                                <a asp-area="Admin" asp-controller="BrandManage" asp-action="Index">
                                    <span class="sub-item">Manage Brands</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="BrandManage" asp-action="Create">
                                        <span class="sub-item">Create Brand</span>
                                    </a>
                                </li>
                            }
              
                        </ul>
                    </div>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "category" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#category">
                        <i class="fas fa-archive"></i>
                        <p>Category</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="category">
                        <ul class="nav nav-collapse">
                            <li>
                                <a asp-area="Admin" asp-controller="CategoryManage" asp-action="Index">
                                    <span class="sub-item">Manage Categories</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="CategoryManage" asp-action="Create">
                                        <span class="sub-item">Create Category</span>
                                    </a>
                                </li>
                            }
           
                        </ul>
                    </div>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "product" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#product">
                        <i class="fas fa-boxes"></i>
                        <p>Product</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="product">
                        <ul class="nav nav-collapse">
                            <li>
                                <a asp-area="Admin" asp-controller="ProductManage" asp-action="Index">
                                    <span class="sub-item">Manage Products</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="ProductManage" asp-action="Create">
                                        <span class="sub-item">Create Product</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "order" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <i class="fas fa-cart-plus"></i>
                        <p>Order</p>
                    </a>
                </li>

                @if (User.IsInRole(RoleName.Administrator))
                {
                    <li class="nav-item  @( ViewBag.sidebar == "user" ? "active" : "")">
                        <a data-bs-toggle="collapse" href="#user">
                            <i class="fas fa-address-card"></i>
                            <p>User</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse" id="user">
                            <ul class="nav nav-collapse">
                                <li>
                                    <a asp-area="Admin" asp-controller="User" asp-action="Index">
                                        <span class="sub-item">Manage Users</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-area="Admin" asp-controller="User" asp-action="Create">
                                        <span class="sub-item">Create User</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item  @( ViewBag.sidebar == "role" ? "active" : "")">
                        <a data-bs-toggle="collapse" href="#role">
                            <i class="fas fa-user-tag"></i>
                            <p>Role</p>
                            <span class="caret"></span>
                        </a>
                        <div class="collapse" id="role">
                            <ul class="nav nav-collapse">
                                <li>
                                    <a asp-area="Admin" asp-controller="Role" asp-action="Index">
                                        <span class="sub-item">Manage Roles</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-area="Admin" asp-controller="Role" asp-action="Create">
                                        <span class="sub-item">Create Roles</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                }


                <li class="nav-item  @( ViewBag.sidebar == "shipping" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Shipping" asp-action="Index">
                        <i class="fas fa-shipping-fast"></i>
                        <p>Shipping</p>                 
                    </a>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "coupon" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#coupon">
                        <i class="fas fa-money-check-alt"></i>
                        <p>Coupon</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="coupon">
                        <ul class="nav nav-collapse">
                            <li>
                                <a asp-area="Admin" asp-controller="Coupon" asp-action="Index">
                                    <span class="sub-item">Manage Coupons</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="Coupon" asp-action="Create">
                                        <span class="sub-item">Create Coupons</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "slider" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#slider">
                        <i class="far fa-image"></i>
                        <p>Slider</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="slider">
                        <ul class="nav nav-collapse">
                            <li>
                                <a asp-area="Admin" asp-controller="Slider" asp-action="Index">
                                    <span class="sub-item">Manage Sliders</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="Slider" asp-action="Create">
                                        <span class="sub-item">Create Sliders</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "promotion" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Promotion" asp-action="Index">
                        <i class="far fa-file-alt"></i>
                        <p>Promotion</p>
                        <span class="caret"></span>
                    </a>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "faq" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#faq">
                        <i class="fas fa-question-circle"></i>
                        <p>FAQ</p>
                        <span class="caret"></span>
                    </a>
                    <div class="collapse" id="faq">
                        <ul class="nav nav-collapse">
                            <li>
                                <a asp-area="Admin" asp-controller="FAQ" asp-action="Index">
                                    <span class="sub-item">Manage FAQs</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleName.Administrator))
                            {
                                <li>
                                    <a asp-area="Admin" asp-controller="FAQ" asp-action="Create">
                                        <span class="sub-item">Create FAQs</span>
                                    </a>
                                </li>
                            }  
                        </ul>
                    </div>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "contact" ? "active" : "")">
                    <a  asp-area="Admin" asp-controller="Contact" asp-action="Index">
                        <i class="fas fa-list"></i>
                        <p>Contact</p>
                    </a>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "chat" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Chat" asp-action="Index">
                        <i class="fab fa-weixin"></i>
                        <p>Chat</p>
                    </a>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "information" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="Information" asp-action="Index">
                        <i class="fas fa-store-alt"></i>
                        <p>Information Shop</p>
                    </a>
                </li>

                <li class="nav-item  @( ViewBag.sidebar == "stockIn" ? "active" : "")">
                    <a  asp-area="Admin" asp-controller="Stock" asp-action="Index">
                        <i class="fas fa-exchange-alt"></i>
                        <p>Stock</p>
                    </a>
                </li>

                <li class="nav-item ">
                    <a target="_blank" class="dropdown-item" asp-action="Index" asp-controller="FileManager" asp-area="Files">
                        <i class="fas fa-file-alt"></i>
                        <p>Manage files</p>
                    </a>
                </li>

            </ul>
        </div>
    </div>
</div>
