@model AssignmentModel
﻿@{
    ViewData["Title"] = "Remove Feedback";
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title text-primary">@ViewData["Title"]</h5>
    <button class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <input type="hidden" id="Date" asp-for="@Model.AssignedDate" />
    <p class="text-black">Are you sure you want to delete this assignment <strong>@Model.Task.Name</strong>?</p>
    <div class="fw-bold">
        @Model.AssignmentDetails
    </div>
</div>
<div class="modal-footer">
    <button class="btn btn-danger" onclick="confirmDelete(@Model.Id)">Delete</button>
</div>



<script>
    function confirmDelete(Id) {
        $.post("@Url.Action("DeleteConfirm","Assignment")", { Id: Id }, function (result) {
            if (result.success) {
                    Swal.fire(
                            {
                                  position: "top-end",
                                  icon: "success",
                                  title: result.message,
                                  showConfirmButton: false,
                                  timer: 500
                            }
                    );
                    var dateString =  $('#Date').val();
                    setActiveDay(dateString);
            }
            else{
                    Swal.fire({
                      icon: "error",
                      title: "Oops...",
                      text: result.message
                    });
            }
        });
    }
</script>
