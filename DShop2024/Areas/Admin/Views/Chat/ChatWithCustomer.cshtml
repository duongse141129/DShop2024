@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUserModel> UserManager
@model IEnumerable<DShop2024.ViewModels.MessageViewModel>
@{
    ViewData["Title"] = "Chat with customer";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<section>
    <div class="container py-5">
        <div class="scroll-container p-3" data-bs-spy="scroll" id="messagesList_@ViewBag.receiverName">
            @foreach (var item in Model)
            {
                @if (item.Receiver == @ViewBag.receiver)
                {
                    <div class="styletime-toreciever">
                        <p class="sptime">[@item.RoleName] @item.UserName</p>
                        <p class="sptime">___</p>
                        <p class="sptime">@item.Timestamp</p>
                    </div>
                    <div class="stylecontent-toreciever">
                        <img src="~/media/avatar/@item.Avatar"
                             alt="avatar 1" class="message-img">
                        <div>
                            <p class="spcontent-toreciever">
                                @item.ContentMessage
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="styletime-customer">
                        <p class="sptime">@item.Timestamp</p>
                        <p class="sptime">___</p>
                        <p class="sptime">[@item.RoleName] @item.UserName</p>
                    </div>
                    <div class="stylecontent-customer">
                        <div>
                            <p class="spcontent-customer">
                                @item.ContentMessage
                            </p>
                        </div>
                        <img src="~/media/avatar/@item.Avatar"
                             alt="avatar 1" class="message-img">
                    </div>
                }
            }
        </div>
        <div class="row p-1">
            <div class="col-1">User</div>
            <div class="col-5"><input name="userInput" type="text" id="userInput" value="@UserManager.GetUserName(User)" disabled /></div>
            <input name="receiver" id="receiver" type="hidden" value="@ViewBag.receiver" />
        </div>
        <div class="row p-1">
            <div class="col-1">Message</div>
            <div class="col-5"><input name="messageInput" class="w-100" type="text" id="messageInput" maxlength="300" /></div>
        </div>
        <div class="row p-1">
            <div class="col-6 text-end">
                <input type="submit" class="sendMessageButton" id="sendMessageButton" value="Send Message" />
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chat.js"></script>
    <script>
        $(document).ready(function () {
            $('.sendMessageButton').click(function () {
                var messageInput = $('#messageInput').val();
                var receiver = $('#receiver').val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SendMessage", "Chat")",
                    data: { receiver: receiver, messageInput: messageInput },

                    success: function (result) {
                        if (result.success) {
                             $('#messageInput').val("");
                        }

                    }
                });
            });
        });
    </script>
}