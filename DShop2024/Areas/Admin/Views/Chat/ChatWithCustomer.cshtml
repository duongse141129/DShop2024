@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUserModel> UserManager
@model IEnumerable<DShop2024.ViewModels.MessageViewModel>
@{
    ViewData["Title"] = "Chat with customer";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<section>
    <div class="container py-5" >
        <div class="card py-5 px-5">

    
        <div class="row">
            <div class="col-md-4">
                <h5>Customer: @ViewBag.receiverName</h5>
                <img src="~/media/avatar/@ViewBag.receiverAvatar"  class="img-fluid" style="height:100px"/>
            </div>
        </div>
        <div class="scroll-container p-3" data-bs-spy="scroll" id="messagesList_@ViewBag.receiverName">
            @foreach (var item in Model)
            {
                @if (item.Receiver == @ViewBag.receiver)
                {
                    <div class="styletime-toreciever">
                        <p class="sptime">[@item.RoleName] @item.UserName</p>
                        <p class="sptime">___</p>
                        <p class="sptime">@item.Timestamp</p>
                    </div>
                    <div class="stylecontent-toreciever">
                        <img src="~/media/avatar/@item.Avatar"
                             alt="avatar 1" class="message-img">
                        <div>
                            <p class="spcontent-toreciever">
                                @Html.Raw(item.ContentMessage)
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="styletime-customer">
                        <p class="sptime">@item.Timestamp</p>
                        <p class="sptime">___</p>
                        <p class="sptime">[@item.RoleName] @item.UserName</p>
                    </div>
                    <div class="stylecontent-customer">
                        <div>
                            <p class="spcontent-customer">
                                @Html.Raw(item.ContentMessage)
                            </p>
                        </div>
                        <img src="~/media/avatar/@item.Avatar"
                             alt="avatar 1" class="message-img">
                    </div>
                }
            }
        </div>

            <div class="chat-container border rounded p-3 bg-light shadow-sm" style="max-width: 500px;">
                <div class="mb-3">
                    <label class="form-label text-muted small">User:</label>
                    <input class="form-control" type="text" value="@UserManager.GetUserName(User)" disabled />
                </div>

                <div class="mb-3">
                    <form asp-action="SendMessage" asp-controller="Chat" asp-area="Admin" method="post" id="messageForm">
                        <div class="input-group">
                            <input type="text" class="form-control" id="messageInput" name="messageInput" placeholder="Type a message..." maxlength="300" />
                            <input name="receiverId" id="receiverMessageId" type="hidden" value="@ViewBag.receiver" />
                            <button type="submit" class="btn btn-success sendMessageButton" id="sendMessageButton">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <form asp-action="Upload" asp-controller="Message" method="post" enctype="multipart/form-data" id="uploadform">
                        <input name="receiverId" id="receiverId" type="hidden" value="@ViewBag.receiver" />
                        <label for="uploadfile" class="btn btn-outline-primary btn-sm">
                            <i class="far fa-image"></i> Add Image
                        </label>
                        <input type="file" id="uploadfile" name="file" accept=".jpg,.png,.jpeg" class="d-none" />
                        <small id="num-of-files" class="text-muted ms-2"></small>
                    </form>

                </div>
            </div>
            <div class="mt-5">
                <a asp-action="Index">Back to List</a>
            </div>


        </div>
    </div>
</section>


@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chat.js"></script>

    <script>
        $(document).ready(function () {
            $('#messageForm').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SendMessage", "Chat", new { area = "Admin" })",
                    data: $(this).serialize(),
                    success: function (result) {
                        if (result.success) {
                            $('#messageInput').val("");
                        }
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            var form = document.getElementById("uploadform");
            $('#uploadfile').change(function () {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Upload", "Chat")",
                    data: new FormData(form),
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        if (result.success) {
                            $('#uploadfile').val("");
                        }
                    }
                });
            });
        });
    </script>
}