
@model IEnumerable<AppUserModel>

@{
    ViewData["title"] = "List Chatting Customer ";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<h1 class="text-primary">@ViewData["title"]</h1>

<div class="row py-5">
    <div class="col-md-4">
        <form asp-action="SearchUserName" asp-controller="Chat">
            <nav class="navbar navbar-header-right navbar-expand-lg navbar-form nav-search p-0 d-none d-lg-flex">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <button type="submit" class="btn btn-search pe-1">
                            <i class="fa fa-search search-icon"></i>
                        </button>
                    </div>
                    <input type="text" placeholder="Search customer name" class="form-control" name="userName" value="@( ViewBag.searchUserName != "" ? ViewBag.searchUserName  : "" )">
                </div>
            </nav>
        </form>
    </div>

</div>

<div class="row">
    <div class="col-md-6">
        <table class="table">
            <thead>
                <tr>
                    <th>User Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="col-sm-12">
                                @item.UserName
                            </div>
                            <div class="col-sm-12">
                                <img src="~/media/avatar/@item.Avatar" width="100" height="100" />
                            </div>

                        </td>
                        <td>
                            <a id="chat_@item.UserName" class="btn btn-success btn-sm sendMessageButton" asp-action="ChatWithCustomer" asp-controller="Chat" asp-route-customerId="@item.Id">
                                Chat
                                <span class="badge badge-light spancustomer" id="spanuser_@item.UserName">New message</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chatnoti.js"></script>
    <script>
        $(document).ready(function () {
            $('.sendMessageButton').click(function () {
                $(".spancustomer").hide();
            });
        });

    </script>
}