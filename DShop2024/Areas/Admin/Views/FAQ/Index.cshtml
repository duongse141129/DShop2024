@model IEnumerable<DShop2024.Models.FAQModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover" id="myTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Question)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Answer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Question)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Answer)
            </td>
            <td>
                <div class="btn-group-2">
                        <a class="btn btn-sm-2 btn-warning"  asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm-2 btn-danger confirmDeletion" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </div>
            
            </td>
        </tr>
}
    </tbody>
</table>
