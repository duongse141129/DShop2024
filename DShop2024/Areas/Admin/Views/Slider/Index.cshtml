@model IEnumerable<DShop2024.Models.BannerModel>

@{
    ViewData["title"] = "Manage Banner";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}


<h1 class="text-primary">@ViewData["title"]</h1>
<div class="col-sm-4 py-3">
    <a class="btn btn-primary" asp-action="Create">Create New Banner</a>
</div>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BannerName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Image)
            </th>


            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.BannerName)
                </td>
                <td>
                    @Html.Raw(@item.Description)
                </td>
                <td>
                    <img src="~/media/banners/@item.Image" width="350" height="180" />
                </td>

                <td>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-danger confirmDeletion" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
