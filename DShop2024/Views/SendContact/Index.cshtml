@model DShop2024.Models.ContactModel

@{
    ViewData["Title"] = "Send contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section >
    <div class="container p-5 my-5 border ws">
        <ul>
            <li class="nav-item topbar-icon dropdown hidden-caret d-flex d-lg-none">
                @await Component.InvokeAsync("Contact")
            </li>
        </ul>

        <div class="row">
            <div class="col-md-12">
                <h2>Frequently Asked Questions</h2>

                @foreach (var item in ViewBag.FAQs as IEnumerable<FAQModel>)
                {
                    <div class="mt-2">
                        <p>
                            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample_@item.Id" aria-expanded="false" aria-controls="collapseExample_@item.Id">
                                @item.Question
                            </button>
                        </p>
                        <div class="collapse" id="collapseExample_@item.Id">
                            <div class="card card-body">
                                @item.Answer
                            </div>
                        </div>
                    </div>
           

                }
    
        <br/>

            </div>
            <div class="col-md-8">
                <h1>Send contact</h1>
                <hr />
                    <div class="form-group">
                        <label>Subject</label>
                        <select asp-for="Subject" class="form-control" asp-items="ViewBag.Subjects">
                                <option>select a subject</option>
                        </select>
                        <span asp-validation-for="Subject" class="text-danger" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Message" class="control-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <div class="form-group pt-2">
                        <input type="submit" class="btn btn-primary sendContactButton" id="sendContactButton" value="Send contact" />
                    </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.sendContactButton').click(function () {
                var messageInput = $('#Message').val();
                var subjectInput = $('#Subject').val();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("Send", "SendContact")",
                    data: { message: messageInput, subject: subjectInput },
                    success: function (result) {
                        if (result.success) {
                            Swal.fire(result.noti);
                        }
                        else {
                            Swal.fire(result.noti);
                        }

                    }
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
