@model DShop2024.Models.ContactModel

@{
    ViewData["Title"] = "Send contact";
}


<div class="row">
    <div class="col-md-9">

       
        <div id="accordion">
            <h2>Frequently Asked Questions</h2>
            @foreach (var item in ViewBag.FAQs as IEnumerable<DShop2024.Models.FAQModel>)
            {
                <p>
                    <a class="btn btn-primary" data-toggle="collapse" href="#collapseExample_@item.Id" role="button" aria-expanded="false" aria-controls="collapseExample">
                        @item.Question
                    </a>
                </p>
                <div class="collapse" id="collapseExample_@item.Id">
                    <div class="card card-body">
                        @item.Answer
                    </div>
                </div>
            }      
        </div>
        <br/>
        <h1>Send contact</h1>
        <hr />

        <form asp-action="Send" asp-controller="SendContact" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Subject" class="control-label"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Message" class="control-label"></label>
                <textarea asp-for="Message" class="form-control" rows="10"  ></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Send" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
