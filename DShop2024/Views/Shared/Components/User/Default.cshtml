@using DShop2024.Areas.Admin.Models.User
@model UserWithRoleViewModel

<a class="dropdown-toggle profile-pic"
   data-bs-toggle="dropdown"
   href="#"
   aria-expanded="false">
    <div class="avatar-sm">
        <img src="~/media/avatar/@Model.User.Avatar" alt="avatar" class="avatar-img rounded-circle">
    </div>
    <span class="profile-username">
        <span class="op-7">Hi, </span>
        <span class="fw-bold"><strong>@Model.RoleName</strong> @Model.User.UserName</span>
    </span>
</a>
<ul class="dropdown-menu dropdown-user animated fadeIn">
    <div class="dropdown-user-scroll scrollbar-outer">
    <li>
        <div class="user-box">
            <div class="avatar-lg">
                <img src="~/media/avatar/@Model.User.Avatar"  class="avatar-img rounded">
            </div>
            <div class="u-text">
                <h4>@Model.User.UserName</h4>
                <p class="text-muted">@Model.User.Email</p>
                <a class="btn btn-xs btn-secondary btn-sm" asp-area="Identity" asp-controller="Manage" asp-action="EditProfile" title="Manage">
                    View Profile
                </a>
            </div>
        </div>
    </li>
    <li>
        <div class="dropdown-divider"></div>
        <form asp-area="Identity" asp-controller="Account" asp-action="LogOff" method="post" id="logoutForm" class="navbar-right">
            <button title="Logoff" type="submit" class="dropdown-item">
                <i class="fas fa-sign-out-alt">Logout</i>
            </button>
        </form>
    </li>
    </div>
</ul>