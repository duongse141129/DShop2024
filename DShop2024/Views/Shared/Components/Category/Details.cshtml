
@model IEnumerable<CategoryModel>



<ul class="list-unstyled fruite-categorie list-group category-list">
    <li>
        <a asp-action="Index" asp-controller="ShopProducts" asp-route-CategorySlug="">
            <div class="d-flex justify-content-between fruite-name list-group-item ">
               ALL
            </div>
        </a>
    </li>
    @foreach (var item in Model)
    {
        <li>
            <a asp-action="Index" asp-controller="ShopProducts" asp-route-CategorySlug="@item.Slug">
                <div class="d-flex justify-content-between fruite-name list-group-item ">
                    @item.CategoryName
                </div>
            </a>
        </li>
    }
</ul>
