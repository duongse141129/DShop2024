@model IEnumerable<CategoryModel>

<ul class="list-unstyled fruite-categorie list-group">
    <li>
        <div class="d-flex justify-content-between fruite-name list-group-item @( ViewBag.CategorySlug == "" ? "active" : "")">
            <a asp-action="Index" asp-controller="ShopProducts" asp-route-CategorySlug="">ALL</a>
        </div>
    </li>
    @foreach (var item in Model)
    {
        <li>
            <div class="d-flex justify-content-between fruite-name list-group-item @( ViewBag.CategorySlug == item.Slug ? "active" : "")">
                <a asp-action="Index" asp-controller="ShopProducts" asp-route-CategorySlug="@item.Slug">@item.CategoryName</a>
            </div>
        </li>
    }
</ul>



