@model IEnumerable<CategoryModel>


<div class="panel panel-default">
	<div class="panel-heading">
		<h4 class="panel-title"><a asp-action="Index" asp-controller="Product" asp-route-CategorySlug="">ALL</a></h4>
	</div>
</div>

@foreach(var item in Model)
{
	<div class="panel panel-default">
		<div class="panel-heading">
			<h4 class="panel-title"><a asp-action="Index" asp-controller="Product" asp-route-CategorySlug="@item.Slug">@item.CategoryName</a></h4>
		</div>
	</div>
}