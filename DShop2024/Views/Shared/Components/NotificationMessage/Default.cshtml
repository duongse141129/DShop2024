@using DShop2024.ViewModels
@model IEnumerable<MessageViewModel>

 <div id="notiComponent">

    <a class="nav-link dropdown-toggle"
       href="#"
       id="messageDropdown"
       role="button"
       data-bs-toggle="dropdown"
       aria-haspopup="true"
       aria-expanded="false">
        <i class="fa fa-envelope"></i>
        @if (Model.Count(x => x.IsRead != true) > 0)
        {
            <span id="countNotiMessage" class="notification">@Model.Count(x => x.IsRead != true)</span>
        }
        else 
        {
            <span id="countNotiMessage" ></span>
        }


    </a>
    <ul class="dropdown-menu messages-notif-box animated fadeIn"
        aria-labelledby="messageDropdown">
        <li>
            <div class="dropdown-title d-flex justify-content-between align-items-center">
                Messages
                <a id="readAllMessage"  class="small">Mark all as read</a>
            </div>
        </li>
        <li>
            <div class="message-notif-scroll scrollbar-outer">
                <div id="listNotiMessage" class="notif-center">
                    @foreach (var item in Model)
                    {
                        if (item.IsRead != true)
                        {
                            <a id="notiMessage_@item.UserName"  asp-area="Admin" asp-controller="Chat" asp-action="ChatWithCustomer" asp-route-customerId="@item.UserId">
                                <div class="notif-img">
                                    <img src="~/media/avatar/@item.Avatar"
                                         alt="Img Profile" />
                                </div>
                                <div class="notif-content">
                                    <span class="subject"><strong>@item.UserName</strong></span>
                                    <span id="notiContentMessage_@item.UserName" class="block">
                                        @( item.IsImage == true ? "send a image." : item.ContentMessage)
                                    </span>             

                                    <span id="notiTimespan_@item.UserName" class="time">@item.Timestamp</span>
                                </div>
                            </a>
                        }
                    }          
                </div>
            </div>
        </li>
        <li>
            <a class="see-all" asp-area="Admin" asp-controller="Chat" asp-action="Index">
                See all messages<i class="fa fa-angle-right"></i>
            </a>
        </li>
    </ul>

</div>

