@model IEnumerable<ProductViewModel>

@if(Model.Count() > 0)
{
    <div class="col-lg-12">
        <h3 class="fw-bold text-primary mb-4">
            <i class="bi bi-fire"></i> Sale Products
        </h3>
        @foreach (var item in Model)
        {
            <div class="card border-0 shadow-sm mb-3 sale-product-card">
                <div class="card-body p-3">
                    <a asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@item.Id">

                        <div class="row g-3 align-items-center">
                            <div class="col-4">
                                <div class="position-relative">
                                    <img src="~/media/products/@item.MainImage"
                                         class="sale-product-img" style="width: 100%; height: 100%; object-fit: cover;">
                                    <span class="badge bg-danger position-absolute top-0 start-0">
                                        SALE
                                    </span>
                                </div>
                            </div>
                            <div class="col-8">
                                <h6 class="fw-bold mb-2 product-title">
                                    @item.ProductName
                                </h6>
                                <div class="rating-stars">
                                    <i class="@( item.AveragePoint >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                                    <i class="@( item.AveragePoint >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                                    <i class="@( item.AveragePoint >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                                    <i class="@( item.AveragePoint >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                                    <i class="@( item.AveragePoint == 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="text-muted text-decoration-line-through">
                                        @item.Price.ToString("#,##0")
                                    </span>
                                    <span class="badge rounded-pill bg-danger-subtle text-danger">
                                        @item.DiscountPercent% OFF
                                    </span>
                                </div>
                                <div class="text-danger fw-bold fs-5">
                                    @item.SalePrice?.ToString("#,##0 VND")
                                </div>

                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>
}


