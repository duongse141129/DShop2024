@model IEnumerable<CouponModel>
<h2 class="section-title pb-5">Coupons</h2>
<div class="page">

    <div class="coupon-grid" id="couponGrid">
        @foreach (var item in Model)
        {
            @if (item.Promotion.CategoryCouponName == DShopConst.FREE_SHIPPING)
            {
                <div class="coupon ship">
                    <div class="coupon-stub"><i class="fas fa-truck"></i></div>
                    <div class="coupon-body">
                        <div class="coupon-top">
                            <div class="coupon-title-promotion">Free shipping</div>
                            <button class="code-chip" data-code="@item.CouponCode" title="Copy code">
                                <span class="chip-icon"><i class="fas fa-copy"></i></span>
                                <span class="chip-text">@item.CouponCode</span>
                            </button>
                        </div>
                        @if (item.MinimumAmount == 0)
                        {
                            <div class="coupon-meta">Expires <b>@item.DateExpired.ToString("MMM d,yyyy")</b></div>
                        }
                        else
                        {
                            <div class="coupon-meta">Min <b>@item.MinimumAmount.ToString("#,##0 VND")</b> <span class="dot">·</span>  Expires <b>@item.DateExpired.ToString("MMM d,yyyy")</b></div>
                        }
      
                        <div class="coupon-desc has-more">@item.Description</div>
                    </div>
                </div>
            }
            else if (item.Promotion.CategoryCouponName == DShopConst.PERCENTAGE_DISCOUNT)
            {
                <div class="coupon pct">
                    <div class="coupon-stub"><div class="val">@item.Value%</div><div class="unit">off</div></div>
                    <div class="coupon-body">
                        <div class="coupon-top">
                            <div class="coupon-title-promotion">Up to @item.Value% off</div>
                            <button class="code-chip" data-code="@item.CouponCode" title="Copy code">
                                <span class="chip-icon"><i class="fas fa-copy"></i></span>
                                <span class="chip-text">@item.CouponCode</span>
                            </button>
                        </div>
                        @if (item.MinimumAmount == 0)
                        {
                            <div class="coupon-meta">Expires <b>@item.DateExpired.ToString("MMM d,yyyy")</b></div>
                        }
                        else
                        {
                            <div class="coupon-meta">Min <b>@item.MinimumAmount.ToString("#,##0 VND")</b> <span class="dot">·</span>  Expires <b>@item.DateExpired.ToString("MMM d,yyyy")</b></div>
                        }
                        <div class="coupon-desc has-more">@item.Description</div>
                    </div>
                </div>
            }
            else if (item.Promotion.CategoryCouponName == DShopConst.SUB_SUMTOTAL_DISCOUNT)
            {
                <div class="coupon direct">
                    <div class="coupon-stub"><div class="val">@((item.Value / 1000).ToString("0.#"))K</div><div class="unit"> off</div></div>
                    <div class="coupon-body">
                        <div class="coupon-top">
                            <div class="coupon-title-promotion">@item.Value.ToString("#,##0 VND") off</div>
                            <button class="code-chip" data-code="@item.CouponCode" title="Copy code">
                                <span class="chip-icon"><i class="fas fa-copy"></i></span>
                                <span class="chip-text">@item.CouponCode</span>
                            </button>
                        </div>
                        @if (item.MinimumAmount == 0)
                        {
                            <div class="coupon-meta">Expires <b>@item.DateExpired.ToString("MMM d,yyyy")</b></div>
                        }
                        else
                        {
                            <div class="coupon-meta">Min <b>@item.MinimumAmount.ToString("#,##0 VND")</b> <span class="dot">·</span>  Expires <b>@item.DateExpired.ToString("MMM d,yyyy")</b></div>
                        }
                        <div class="coupon-desc has-more">@item.Description</div>
                    </div>
                </div>
            }
        }
    </div>
</div>