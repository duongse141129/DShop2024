@using DShop2024.ViewModels
@model IEnumerable<ProductViewModel>


<div class="row">
    <div class="col-md-12">

        <div class="section-header d-flex flex-wrap justify-content-between my-5">

            <h2 class="section-title">Best selling products</h2>

            <div class="d-flex align-items-center">
                <a asp-area="" asp-action="Index" asp-controller="ShopProducts" class="btn-link text-decoration-none">View All Products →</a>
                <div class="swiper-buttons">
                    <button class="swiper-prev bestseller-products-carousel-prev btn btn-yellow">❮</button>
                    <button class="swiper-next bestseller-products-carousel-next btn btn-yellow">❯</button>
                </div>
            </div>
        </div>

    </div>
</div>
<div class="row">
    <div class="col-md-12">

        <div class="bestseller-products-carousel swiper">
            <div class="swiper-wrapper">
                @foreach (var item in Model)
                {
                    <div class="product-item swiper-slide add-quantity-productid-cart">
                        <a data-product_id="@item.Id" class="btn-compare add-btn-compare">
                            <i class="fas fa-retweet"></i>
                        </a>
                        <a data-product_id="@item.Id" class="btn-wishlist add-btn-wishlist">
                            <i class="far fa-heart"></i>
                        </a>
                        <figure>
                            <a asp-area="" asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@item.Id" title="@item.ProductName">
                                <img src="~/media/products/@item.MainImage" class="img-fluid product-mainImage" alt="@item.ProductName">
                            </a>
                        </figure>
                        <h3>@item.ProductName</h3>
                        <div class="qty"> <span>Sold: </span><span class="rating"> @item.QuantitySold</span></div>
                        <div class="price-container">
                            @if (item.IsOnSale)
                            {
                                <span class="original-price">@item.Price.ToString("#,##0")</span>
                                <span class="badge badge-danger text-white bg-danger">@item.DiscountPercent% off</span>
                                <span class="price text-danger">@item.SalePrice?.ToString("#,##0 VND")</span>

                            }
                            else
                            {
                                <span class="price">@item.Price.ToString("#,##0 VND")</span>
                            }
                        </div>
                        <div class="brand-product">@item.BrandName</div>
                        <div class="category-product">@item.CategoryName</div>

                        <div class="d-flex align-items-center justify-content-between">
                            <div class="input-group product-qty">
                                <span class="input-group-btn">
                                    <button type="button" class="quantity-left-minus btn btn-danger btn-number">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </span>
                                <input type="text" class="quantity-input" value="1">
                                <span class="input-group-btn">
                                    <button type="button" class="quantity-right-plus btn btn-success btn-number">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </span>
                            </div>
                        </div>
                        <button class="btn btn-primary add-to-cart-quantity" data-product-id="@item.Id">
                            <i class="fas fa-cart-plus"></i> Add to Cart
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>





