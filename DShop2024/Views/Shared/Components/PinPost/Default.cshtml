@using DShop2024.Models.Blog
@model IEnumerable<PostModel>

<div class="post-wrapper" id="sliderpost">
    @foreach (var item in Model)
    {
        <div class="card cardPost">
            <img class="card-img-top" src="~/media/post/@item.Image" alt="...">
            <div class="card-body">
                <div class="small text-muted">@item.DateUpdated.ToString("MM/dd/yyyy h:mm tt")</div>
                <h2 class="card-title">@item.Title</h2>
                <div>
                    Subject:
                    <strong class="text-danger">
                        @string.Join(", ", item.PostSubjects.Select(pc => pc.Subject.Title))
                    </strong>
                </div>
                <p class="card-text">@item.ShortDescription</p>
                <a class="btn btn-info" asp-action="Detail" asp-controller="ViewPost" asp-area="Blog" asp-route-postslug="@item.Slug">Read more →</a>
            </div>
        </div>
    }
</div>