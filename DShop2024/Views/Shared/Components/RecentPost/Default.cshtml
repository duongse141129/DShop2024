@using DShop2024.Models.Blog
@model IEnumerable<PostViewModel>


        <div class="row">
            <div class="section-header d-flex align-items-center justify-content-between my-5">
                <h2 class="section-title">Our Recent Blog</h2>
                <div class="btn-wrap align-right">
                    <a asp-area="Blog" asp-controller="ViewPost" asp-action="Index" class="d-flex align-items-center nav-link">Read All Blogs →</a>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <article class="post-item card border-0 shadow-sm p-3">
                        <div class="image-holder zoom-effect">
                                <img src="~/media/post/@item.Image" alt="post" class="card-img-top">
                        </div>
                        <div class="card-body">
                            <div class="post-meta d-flex text-uppercase gap-3 my-2 align-items-center">
                        <div class="meta-date">
                            <i class="far fa-clock"></i> @item.DateUpdated.ToString("MM/dd/yyyy h:mm tt")
                        </div>
                            </div>
                            <div>
                                Subject:
                                <strong class="text-danger">
                                    @item.Subjects
                                </strong>
                            </div>
                            <div class="post-header">
                                <h3 class="post-title">
                                        @item.Title
                                </h3>
                                <p>@item.ShortDescription</p>
                            </div>

                             <div class="d-flex justify-content-between align-items-center mt-3">
                                <a class="btn btn-info blog-readmore" asp-action="Detail" asp-controller="ViewPost" asp-area="Blog" asp-route-postslug="@item.Slug">Read more →</a>
                                <div class="blog-stats">
                                    <span class="like">
                                        <i class="fas fa-thumbs-up"></i>@item.CountLikes
                                    </span>

                                    <span class="comment">
                                        <i class="far fa-comment"></i>@item.CountComments
                                    </span>
                                </div>
                            </div>

                        </div>
                    </article>
                </div>
            }
       
        </div>
