@using DShop2024.Models.Blog
@model IEnumerable<PostModel>


        <div class="row">
            <div class="section-header d-flex align-items-center justify-content-between my-5">
                <h2 class="section-title">Our Recent Blog</h2>
                <div class="btn-wrap align-right">
                    <a asp-area="Blog" asp-controller="ViewPost" asp-action="Index" class="d-flex align-items-center nav-link">Read All Blogs →</a>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <article class="post-item card border-0 shadow-sm p-3">
                        <div class="image-holder zoom-effect">
                                <img src="~/media/post/@item.Image" alt="post" class="card-img-top">
                        </div>
                        <div class="card-body">
                            <div class="post-meta d-flex text-uppercase gap-3 my-2 align-items-center">
                        <div class="meta-date">
                            <i class="far fa-clock"></i> @item.DateUpdated.ToString("MM/dd/yyyy h:mm tt")
                        </div>
                            </div>
                            <div>
                                Subject:
                                <strong class="text-danger">
                                    @string.Join(", ", item.PostSubjects.Select(pc => pc.Subject.Title))
                                </strong>
                            </div>
                            <div class="post-header">
                                <h3 class="post-title">
                                        @item.Title
                                </h3>
                                <p>@item.ShortDescription</p>
                            </div>
                            <a class="btn btn-info" asp-action="Detail" asp-controller="ViewPost" asp-area="Blog" asp-route-postslug="@item.Slug">Read more →</a>
                        </div>
                    </article>
                </div>
            }
       
        </div>
