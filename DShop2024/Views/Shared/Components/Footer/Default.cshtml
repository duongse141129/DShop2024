@using DShop2024.ViewModels
@model FooterViewModel

<div class="footer-social-section py-4 mb-4">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-4">
            <div class="social-card h-100 d-flex flex-column justify-content-center">
                <h1 class="shop-logo mb-2">
                    <i class="fas fa-store"></i> @Model.informationShop.ShopName
                </h1>
                <p class="text-muted mb-0">
                    Discover backpacks that combine comfort, functionality, and modern style for every occasion.
                </p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="social-card h-100">
                <div class="social-title">
                    <i class="fab fa-facebook text-primary"></i>
                    Follow us on Facebook
                </div>
                @Html.Raw(Model.informationShop.PluginFacebook)
            </div>
        </div>
        <div class="col-lg-4">
            <div class="social-card h-100 text-center d-flex flex-column justify-content-center">
                <div class="social-title mb-4">
                    <i class="fab fa-youtube text-danger"></i>
                    Subscribe our channel
                </div>
                <div>
                    @Html.Raw(Model.informationShop.PluginYoutube)
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row g-5">
    <div class="col-lg-3 col-md-6">
        <div class="footer-item">
            <h4 class="text-primary mb-3">Description</h4>
            <p class="mb-4">
                @Html.Raw(Model.informationShop.Description)
            </p>
            <a asp-action="AboutUs" asp-controller="Home" class="btn border-secondary py-2 px-4 rounded-pill text-primary">Read More</a>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="d-flex flex-column footer-item">
            <h4 class="text-primary  mb-3">Shop Information</h4>
            <a class="linkFooter" asp-action="AboutUs" asp-controller="Home">About Us</a>
            <a class="linkFooter" asp-action="Index" asp-controller="SendContact">Contact Us</a>
            <a class="linkFooter" asp-action="Index" asp-controller="SendContact">FAQs</a>
            <a class="linkFooter" asp-action="Index" asp-controller="Message">Chat</a>
            <a class="linkFooter" asp-action="Index" asp-controller="ViewPost" asp-area="Blog">Blog</a>
            <a class="linkFooter" asp-action="AboutUs" asp-controller="Home">Branches</a>
            <a class="linkFooter" asp-action="Privacy" asp-controller="Home">Privacy Policy</a>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="d-flex flex-column text-start footer-item">
            <h4 class="text-primary mb-3">Account</h4>
            <a class="linkFooter" asp-area="Identity" asp-controller="Manage" asp-action="EditProfile">My Account</a>
            <a class="linkFooter" asp-action="Index" asp-controller="ShopProducts">Shop Products</a>
            <a class="linkFooter" asp-action="Index" asp-controller="Cart">Shopping Cart</a>
            <a class="linkFooter" asp-action="Index" asp-controller="CheckOut">Check Out</a>
            <a class="linkFooter" asp-action="WishList" asp-controller="Home">Wishlist</a>
            <a class="linkFooter" asp-action="Compare" asp-controller="Home">Compare</a>
            <a class="linkFooter" asp-action="Index" asp-controller="Order">Order History</a>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="footer-item">
            <h4 class="text-primary mb-3">Contact</h4>
            <p>Email: @Model.informationShop.Email</p>
            <p>Phone: @Model.informationShop.Phone</p>
            <p>Payment Accepted</p>
            @foreach (var item in Model.payments)
            {
                <img class="img-fluid" src="~/media/payment/@item" height="50" width="50" alt="" />
            }
        </div>
    </div>
</div>
