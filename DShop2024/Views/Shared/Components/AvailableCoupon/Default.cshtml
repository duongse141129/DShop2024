@model IEnumerable<CouponModel>


<div class="row">
    <div class="col-md-12">
        <h2 class="section-title">Available Coupons</h2>
        <div class="section-header d-flex flex-wrap flex-wrap justify-content-between mb-5">
            <div class="slider-container-coupon">
                <button class="nav-coupon left" onclick="slideLeftCoupon()">&#10094;</button>
                <div class="slidercoupon gap-3">
                    @foreach (var item in Model)
                    {
                        <div class="card available-coupon-card h-100">
                            <div class="card-body d-flex flex-column">

                                @if (item.Promotion.CategoryCouponName == DShopConst.FREE_SHIPPING)
                                {
                                    <h5 class="available-coupon-title">FREE SHIPPING</h5>
                                }

                                @if (item.Promotion.CategoryCouponName == DShopConst.PERCENTAGE_DISCOUNT)
                                {
                                    <h5 class="available-coupon-title">@item.Value %</h5>
                                }

                                @if (item.Promotion.CategoryCouponName == DShopConst.SUB_SUMTOTAL_DISCOUNT)
                                {
                                    <h5 class="available-coupon-title">@item.Value.ToString("#,##0 VND")</h5>
                                }

                                <div class="available-coupon-info">
                                    <div><strong>Quantity:</strong> @item.Quantity</div>
                                    <div><strong>Expired:</strong> @item.DateExpired.ToString("MM/dd/yyyy")</div>
                                    @if (item.MinimumAmount > 0)
                                    {
                                        <div class="available-coupon-minimum">
                                            <strong>Min:</strong>
                                            @item.MinimumAmount.ToString("#,##0 VND")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="available-coupon-minimum empty"></div>
                                    }
                                </div>

                                <div class="available-coupon-footer">
                                    <span class="available-coupon-code">
                                        @item.CouponCode
                                    </span>
                                    <button class="copy-data available-coupon-save-btn"
                                            data-copy="@item.CouponCode">
                                        Save
                                    </button>
                                </div>

                            </div>
                        </div>
                    }
                </div>
                <button class="nav-coupon right" onclick="slideRightCoupon()">&#10095;</button>
            </div>
        </div>
    </div>
</div>


