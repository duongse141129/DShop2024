@using DShop2024.ViewModels
@model IEnumerable<ProductViewModel>


<div class="recommended_items">
	<h2 class="title text-center">Best Rating Products</h2>

	<div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
		<div class="carousel-inner">
			<div class="item active">

					@foreach (var item in Model)
					{
						<div class="col-sm-4">
							<div class="product-image-wrapper">
								<div class="single-products">

									<div class="productinfo text-center">
										<a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id">
											<img src="~/media/products/@item.Image" alt="@item.ProductName" width="100%" />
											<h2>@item.Price.ToString("#,##0 VND")</h2>
											<p>@item.ProductName</p>
											<p>Category: @item.CategoryName</p>
											<p>Brand: @item.BrandName</p>
											<p>@item.AveragePoint</p>
										</a>
										<div class="row">
											<div class="rating-area">
												<ul class="ratings">
													<li>
														<i class="@( @item.AveragePoint >= 1 ? "fa fa-star color" :  "fa fa-star")"></i>
														<i class="@( @item.AveragePoint >= 2 ? "fa fa-star color" :  "fa fa-star")"></i>
														<i class="@( @item.AveragePoint >= 3 ? "fa fa-star color" :  "fa fa-star")"></i>
														<i class="@( @item.AveragePoint >= 4 ? "fa fa-star color" :  "fa fa-star")"></i>
														<i class="@( @item.AveragePoint >= 5 ? "fa fa-star color" :  "fa fa-star")"></i>
													</li>
												</ul>
											</div>
										</div>
										@if (item.Stock > 0)
										{

											<button class="btn btn-default add-to-cart" data-product_id="@item.Id"><i class="fa fa-shopping-cart"></i>Add to Cart</button>
										}
										else
										{
											<button class="btn btn-default add-to-cart"><i class="fa fa-shopping-cart"></i>Out Of Order</button>
										}
									</div>
								<div class="choose">
									@if (User.Identity?.IsAuthenticated ?? false)
									{
										<ul class="nav nav-pills nav-justified">
											<li>
												<button class="btn btn-danger add-btn-wishlist" data-product_id="@item.Id">Add to Wishlist</button>
											</li>
											<li>
												<button class="btn btn-info add-btn-compare" data-product_id="@item.Id">Add to Compare</button>
											</li>
										</ul>
									}
								</div>

	

								</div>
							</div>
						</div>
					}

			</div>
		</div>

	</div>
</div>