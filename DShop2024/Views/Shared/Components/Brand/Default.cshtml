@using DShop2024.ViewModels
@model IEnumerable<BrandViewModel>

<ul class="list-unstyled fruite-categorie list-group">
    <li>
        <div class="d-flex justify-content-between fruite-name list-group-item @( ViewBag.BrandSlug == "" ? "active" : "")">
            <a asp-action="Index" asp-controller="ShopProducts" asp-route-BrandSlug="">ALL</a>
        </div>
    </li>
    @foreach (var item in Model)
    {
        <li>
            <div class="d-flex justify-content-between fruite-name list-group-item @(ViewBag.BrandSlug == item.Slug ? "active" : "") ">
                <a asp-action="Index" asp-controller="ShopProducts" asp-route-BrandSlug="@item.Slug"> @item.BrandName</a>
                <span>@item.CountProduct</span>
            </div>
        </li>
    }
</ul>



