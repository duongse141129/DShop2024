@using DShop2024.ViewModels
@model IEnumerable<BrandViewModel>


<div class="brands-name">
	<ul class="nav nav-pills nav-stacked">
		<li>
			<a asp-action="Index" asp-controller="Product" asp-route-BrandSlug="">ALL</a>
		</li> 

	</ul>
</div>

@foreach (var item in Model)
{
	<div class="brands-name">
		<ul class="nav nav-pills nav-stacked">
			<li>			
				<a asp-action="Index" asp-controller="Product" asp-route-BrandSlug="@item.Slug"> <span class="pull-right">@item.CountProduct</span>@item.BrandName</a>
			</li>


		</ul>
	</div>
}