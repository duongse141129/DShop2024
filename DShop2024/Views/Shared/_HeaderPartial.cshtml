<div class="container-fluid fixed-top">
    <div class="container topbar bg-primary d-none d-lg-block">
        <div class="d-flex justify-content-between">
            <div class="top-info ps-2">
                @if (User.IsInRole(RoleName.Administrator) || User.IsInRole(RoleName.Employee))
                {
                    <small class="me-3"><i class="fas fa-boxes me-2 text-white"></i><a class="text-white" asp-area="Admin" asp-controller="ProductManage" asp-action="Index">Manage Page</a></small>
                }
            </div>
            <div class="top-link pe-2">
                <a asp-area="" asp-action="Index" asp-controller="SendContact" class="text-white"><small class="text-white mx-2">Contact</small>/</a>
                <a asp-area="" asp-action="AboutUs" asp-controller="Home" class="text-white"><small class="text-white ms-2">About Us</small>/</a>
                <a asp-area="" asp-action="Privacy" asp-controller="Home" class="text-white"><small class="text-white mx-2">Privacy Policy</small></a>
            </div>
        </div>
    </div>
    <div class="container px-0">
        <nav class="navbar navbar-light bg-white navbar-expand-xl">
            @await Component.InvokeAsync("LogoShop")
            <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars text-primary"></span>
            </button>
            <div class="collapse navbar-collapse bg-white" id="navbarCollapse">
                <div class="navbar-nav mx-auto">
                    <a class="nav-item nav-link @( ViewBag.sidebar == Menu.Home.Home ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i>Home</a>
                    <a class="nav-item nav-link @( ViewBag.sidebar == Menu.Home.Shop ? "active" : "")" asp-area="" asp-action="Index" asp-controller="ShopProducts"><i class="fas fa-th-list"></i>Shop</a>
                    <a class="nav-item nav-link @( ViewBag.sidebar == Menu.Home.Blog ? "active" : "")" asp-area="Blog" asp-action="Index" asp-controller="ViewPost"><i class="fab fa-blogger"></i>Blog</a>
                    <a class="nav-item nav-link @( ViewBag.sidebar == Menu.Home.Chat ? "active" : "")" asp-area="" asp-action="Index" asp-controller="Message"><i class="far fa-comments"></i>Chat</a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle show" data-bs-toggle="dropdown" aria-expanded="true">Pages</a>
                        <div class="dropdown-menu m-0 bg-secondary rounded-0 show" data-bs-popper="none">
                            <a class="dropdown-item" asp-area="" asp-action="WishList" asp-controller="Home"><i class="far fa-heart"></i> Wishlist</a>
                            <a class="dropdown-item" asp-area="" asp-action="Compare" asp-controller="Home"><i class="fa fa-crosshairs"></i> Compare</a>
                            <a class="dropdown-item" asp-area="" asp-action="Index" asp-controller="Order"><i class="fas fa-history"></i> History Shopping</a>
                        </div>
                    </div>
                </div>
                <div class="d-flex m-3 me-0">
                    <button class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fas fa-search text-primary"></i></button>
                    @await Component.InvokeAsync("Cart")
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </div>
</div>

<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content rounded-0">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Search by product name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="" asp-action="Index" asp-controller="ShopProducts">
                <div class="modal-body d-flex align-items-center">
                    <div class="input-group w-75 mx-auto d-flex">
                        <input name="searchName" type="search" class="form-control p-3" placeholder="keywords" aria-describedby="search-icon-1">
                        <button id="search-icon-1" class="input-group-text p-3"><i class="fa fa-search"></i> </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="hero-header">
</div>
