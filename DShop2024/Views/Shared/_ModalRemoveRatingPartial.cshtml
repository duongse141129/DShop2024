@model RatingModel
﻿@{
    ViewData["Title"] = "Remove Feedback";
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title">@ViewData["Title"]</h5>
    <button class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <p>Are you sure you want to delete this feedback <strong>@Model.Id</strong>?</p>
</div>

<div class="modal-footer">
    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button class="btn btn-danger" onclick="confirmDelete(@Model.Id)">Delete</button>
</div>

<script>
    function confirmDelete(Id) {
        $.post("/Admin/ProductManage/RemoveRating", { Id: Id }, function (result) {
            if (result.success) {
                    Swal.fire(
                            {
                                  position: "top-end",
                                  icon: "success",
                                  title: result.message,
                                  showConfirmButton: false,
                                  timer: 500
                            }
                    ).then(function(){
                             location.reload();
                    });
            }
            else{
                    Swal.fire({
                      icon: "error",
                      title: "Oops...",
                      text: result.message
                    });
            }
        });
    }
</script>