﻿@using Microsoft.AspNetCore.Identity
@using DShop2024.Models

@inject SignInManager<AppUserModel> SignInManager
@inject UserManager<AppUserModel> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form asp-area="Identity" asp-controller="Account" asp-action="LogOff" method="post" id="logoutForm" class="navbar-right">
        <a class="my-auto" asp-area="Identity" asp-controller="Manage" asp-action="EditProfile" title="Manage" id="user-name-login">
            @await Component.InvokeAsync("Avatar")
            @UserManager.GetUserName(User)
        </a>
        <button title="Logoff" type="submit" class="my-auto">
            <i class="fas fa-sign-out-alt">Logout</i>
        </button>
    </form>
}
else
{
    <a title="Login" class="my-auto" asp-area="Identity" asp-controller="Account" asp-action="Login">
        <i class="fa fa-lock"></i>Login
    </a>
}