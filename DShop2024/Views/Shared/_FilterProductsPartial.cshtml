
<input type="hidden" name="CategorySlug" value="@( ViewBag.CategorySlug!= "" ? ViewBag.CategorySlug  : "" )">
<input type="hidden" name="BrandSlug" value="@( ViewBag.BrandSlug!= "" ? ViewBag.BrandSlug  : "" )">

<div class="row g-4">
	<div class="col-xl-3">
		<div class="input-group w-100 mx-auto d-flex">
			<input type="search" class="form-control p-3" placeholder="keywords" aria-describedby="search-icon-1" name="searchName" value="@( ViewBag.searchName!= "" ? ViewBag.searchName  : "" )">
			<button type="submit"><span id="search-icon-1" class="input-group-text p-3"><i class="fa fa-search"></i></span></button>
		</div>
	</div>
	<div class="col-6">
		<div class="row">
			<div class="col-sm-6">
				<p>Laptop pocket(INCH)</p>
				@foreach (var item in ViewBag.laptopPocketTypes)
				{
					<input type="radio" id="@item" name="laptopPocket" value="@item" @(ViewBag.laptopPocket == item ? "checked" : "") />
					@if (item == "")
					{
						<label for="@item">None</label>
					}
					else
					{
						<label for="@item">@item</label>
					}
				}
			</div>
			<div class="col-md-4">
				<input id="waterResistance" type="checkbox" name="waterResistance" @(ViewBag.waterResistance != "" ? "checked" : "") />
				<label for="waterResistance">WaterResistance</label><br>
				<input id="USBChargingPort" type="checkbox" name="USBChargingPort" @(ViewBag.USBChargingPort != "" ? "checked" : "") />
				<label for="USBChargingPort">USBChargingPort</label><br>
			</div>
		</div>
		<div class="row">
			<div class="col-md-5">
				<input type="hidden" name="startprice" id="startprice" >
				<input type="hidden" name="endPrice" id="endPrice" >
				<p>
					<input type="text" name="amount" id="amount" readonly="" style="border:0; color:#f6931f; font-weight:bold;" width="400">
				</p>
				<div id="slider-range"></div>
				<button type="submit" name="locgia" class="btn btn-danger btn-locgia">Filter</button>

			</div>
		</div>
	</div>

	<div class="col-xl-3">
		<div class="bg-white ps-3 py-3 rounded d-flex justify-content-between mb-4">
			<label for="fruits">Sort:</label>
			<select id="fruits"  class="border-0 form-select-sm bg-light me-3" name="sortBy" asp-items="ViewBag.sortBy">
				<option></option>
			</select>
		</div>
	</div>
</div>

