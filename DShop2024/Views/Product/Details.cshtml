@using DShop2024.ViewModels
@model ProductDetailViewModel
@{
	ViewData["Title"] = "Detail";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
	<div class="col-sm-3">
		@Html.Partial("_SidebarPartial")
	</div>

	<div class="col-sm-9 padding-right">
		<div class="product-details">
			<!--product-details-->
			<div class="col-sm-5">
				<div class="view-product">
					<img src="~/media/products/@Model.ProductDetail.Image" alt="" />
					<h3>ZOOM</h3>
				</div>
				<div id="similar-product" class="carousel slide" data-ride="carousel">

					<!-- Wrapper for slides -->
					<div class="carousel-inner">
						<div class="item">
							<a href=""><img src="images/product-details/similar1.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar2.jpg" alt=""></a>
							<a href=""><img src="images/product-details/similar3.jpg" alt=""></a>
						</div>
						

					</div>

					<!-- Controls -->
					<a class="left item-control" href="#similar-product" data-slide="prev">
						<i class="fa fa-angle-left"></i>
					</a>
					<a class="right item-control" href="#similar-product" data-slide="next">
						<i class="fa fa-angle-right"></i>
					</a>
				</div>

			</div>
			<div class="col-sm-7">
				<div class="product-information">
					<!--/product-information-->
					
					<h2>@Model.ProductDetail.ProductName</h2>
					
				
					<span>
						<span>@Model.ProductDetail.Price.ToString("#,##0 VND")</span>
						<label>Quantity:</label>
						<input type="text" value="1" />
						@if (Model.ProductDetail.Stock > 0)
						{
							<button type="button" class="btn btn-fefault cart">
								<i class="fa fa-shopping-cart"></i>
								Add to cart
							</button>
						}
						else
						{
							<button type="button" class="btn-outline-dark cart">
								<i class="fa fa-shopping-cart"></i>
								Out Of Order
							</button>
						}

					</span>
					<p><b>Availability:</b> In Stock</p>
					<p><b>Condition:</b> New</p>
					<p><b>Dimension (CM): </b>@Model.ProductDetail.Dimension</p>
					<p><b>Capacity (L): </b> @Model.ProductDetail.Capacity</p>
					<p><b>Weight (KG): </b> @Model.ProductDetail.Weight</p>
					<p><b>Material: </b> @Model.ProductDetail.Material</p>
					<p><b>Compartment: </b> @Model.ProductDetail.Compartment</p>
					@if(Model.ProductDetail.LaptopPocket != null)
					{
						<p><b>Laptop Pocket: </b> @Model.ProductDetail.LaptopPocket</p>
					}
					
					@if (Model.ProductDetail.WaterResistance == true)
					{
						<p><b>Water Resistance</b></p>
					}
					@if (Model.ProductDetail.USBChargingPort == true)
					{
						<p><b>USB Charging Port</b> </p>
					}

					<p><b>Brand:</b>@Model.ProductDetail.Brand.BrandName </p>
					<p><b>Category:</b>@Model.ProductDetail.Category.CategoryName </p>
					<a href=""><img src="images/product-details/share.png" class="share img-responsive" alt="" /></a>
				</div><!--/product-information-->
			</div>
		</div><!--/product-details-->

		<div class="category-tab shop-details-tab">
			<!--category-tab-->
			<div class="col-sm-12">
				<ul class="nav nav-tabs">
					<li class="active"><a href="#details" data-toggle="tab">Details</a></li>
					<li><a href="#companyprofile" data-toggle="tab">Company Profile</a></li>
					<li><a href="#tag" data-toggle="tab">Tag</a></li>
					<li ><a href="#reviews" data-toggle="tab">Reviews (5)</a></li>
				</ul>
			</div>
			<div class="tab-content">
				<div class="tab-pane fade active in" id="details">
					
					@Html.Raw(@Model.ProductDetail.Description);
				</div>

				<div class="tab-pane fade" id="companyprofile">
					<h4>@Model.ProductDetail.Brand.BrandName</h4>
					<p>@Html.Raw(@Model.ProductDetail.Brand.Description);</p>
			
				</div>

				<div class="tab-pane fade" id="tag">
					<h4>@Model.ProductDetail.Category.CategoryName</h4>
					<p>@Html.Raw(@Model.ProductDetail.Category.Description);</p>
				</div>

	

			</div>
		</div><!--/category-tab-->

		<hr/>
		<h2 class="title text-center">Review product</h2>
			<div class="container border border-primary" id="reviews">
				<div class="col-sm-12">

				<h4>Average Point: @Model.Point</h4>
				<h4>List feedback</h4>
					@foreach (var item in Model.listRating)
					{
						<div class="response-area">
							<ul class="media-list">
								<li class="media">
									<a class="pull-left" href="#">
										<img class="media-object" src="~/media/avatar/@item.User.Avatar" alt="">
									</a>
									<div class="media-body">
										<ul class="sinlge-post-meta">
											<li><i class="fa fa-user"></i>@item.User.UserName</li>
											<li><i class="fa fa-clock-o"></i>@item.RatingDateTime?.ToShortTimeString()</li>
											<li><i class="fa fa-calendar"></i>@item.RatingDateTime?.ToShortDateString()</li>
										</ul>
										<p>@item.Star</p>
										<p>@item.Comment</p>
									</div>
								</li>
							</ul>
						</div><!--/Response-area-->
						<br />
					}
				@if (ViewBag.pagingmodel != null)
				{
					<partial name="_PagingXTL" model="@ViewBag.pagingmodel" />
				}
			
					<h4>Your feekback</h4>
					@if (Model.IsOrder)
					{

						if (Model.Feedback.Id != 0)
						{
							<p><b>Your Review</b></p>

							<div class="response-area">
								<ul class="media-list">
									<li class="media">
										<a class="pull-left" href="#">
										<img class="media-object" src="~/media/avatar/@Model.Feedback.User.Avatar" alt="">
										</a>
										<div class="media-body">
											<ul class="sinlge-post-meta">
												<li><i class="fa fa-user"></i>@Model.Feedback.User.UserName</li>
												<li><i class="fa fa-clock-o"></i>@Model.Feedback.RatingDateTime?.ToShortTimeString()</li>
												<li><i class="fa fa-calendar"></i>@Model.Feedback.RatingDateTime?.ToShortDateString()</li>
											</ul>
											<p>@Model.Feedback.Star</p>
											<p>@Model.Feedback.Comment</p>
										</div>
									</li>
								</ul>
							</div>

							<br /> 


						}
						else
						{


							<p><b>Write Your Review</b></p>
							<form autocomplete="off" asp-controller="Product" asp-action="CommentProduct" method="post">
								<span>
									<input type="hidden" name="ProductId" asp-for="@Model.Feedback.ProductId" value="@Model.ProductDetail.Id" />
									<input name="Star" asp-for="@Model.Feedback.Star" type="number" min="1" max="5" step="1" value="5" />
								</span>
								<textarea asp-for="@Model.Feedback.Comment" name="Comment" placeholder="Enter your review"></textarea>
								<span asp-validation-for="@Model.Feedback.Comment" class="text-danger"></span>
								<b>Rating: </b> <img src="images/product-details/rating.png" alt="" />
								<button type="submit" class="btn btn-default pull-right">
									Submit
								</button>
							</form> 

						}
					}
					else
					{
						<p>You have not purchased this product yet. </p>
					}





				</div>
			</div>
	
		


		<div class="recommended_items">
			<!--recommended_items-->
			<h2 class="title text-center">recommended items</h2>

			<div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
				<div class="carousel-inner">
					<div class="item active">
						@foreach (var relatedProducts in ViewBag.relatedProducts as IEnumerable<ProductModel>)
						{
							<div class="col-sm-4">
								<div class="product-image-wrapper">
									<div class="single-products">

										<div class="productinfo text-center">
											<a asp-action="Details" asp-controller="Product" asp-route-Id="@relatedProducts.Id">
												<img src="~/media/products/@relatedProducts.Image" alt="@relatedProducts.ProductName" width="100%" />
												<h2>$@relatedProducts.Price.ToString("#,##0 VND")</h2>
												<p>@relatedProducts.ProductName</p>
												<p>Category: @relatedProducts.Category.CategoryName</p>
												<p>Brand: @relatedProducts.Brand.BrandName</p>
											</a>
										</div>

									</div>
									<div class="choose">
										<ul class="nav nav-pills nav-justified">
											<li><a href="#"><i class="fa fa-plus-square"></i>Add to wishlist</a></li>
											<li><a href="#"><i class="fa fa-plus-square"></i>Add to compare</a></li>
										</ul>
									</div>
								</div>
							</div>
						}

					</div>
				</div>

			</div>
		</div><!--/recommended_items-->

		


		<br/>
		<hr/>
		<br/>
	 	<div class="recommended_items">
			<!--Products you recently viewed-->
			<h2 class="title text-center">Recently viewed products </h2>

			<div id="recommended-item-carousel" class="carousel slide" data-ride="carousel">
				<div class="carousel-inner">
					<div class="item active">
						@foreach (var relatedProducts in ViewBag.recentlyViewedProducts as IEnumerable<ProductModel>)
						{
							<div class="col-sm-4">
								<div class="product-image-wrapper">
									<div class="single-products">

										<div class="productinfo text-center">
											<a asp-action="Details" asp-controller="Product" asp-route-Id="@relatedProducts.Id">
												<img src="~/media/products/@relatedProducts.Image" alt="@relatedProducts.ProductName" width="100%" />
												<h2>$@relatedProducts.Price.ToString("#,##0 VND")</h2>
												<p>@relatedProducts.ProductName</p>
												<p>Category: @relatedProducts.Category.CategoryName</p>
												<p>Brand: @relatedProducts.Brand.BrandName</p>
											</a>
										</div>

									</div>
									<div class="choose">
										<ul class="nav nav-pills nav-justified">
											<li><a href="#"><i class="fa fa-plus-square"></i>Add to wishlist</a></li>
											<li><a href="#"><i class="fa fa-plus-square"></i>Add to compare</a></li>
										</ul>
									</div>
								</div>
							</div>
						}

					</div>
				</div>

			</div>
		</div><!--Products you recently viewed end--> 

	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
