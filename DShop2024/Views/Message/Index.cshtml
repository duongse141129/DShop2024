@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/chat.js"></script>
    <script src="~/js/chatnotification.js"></script>
    <script>
        $(document).ready(function () {
            $('.sendMessageButton').click(function () {
                //var messageInput = $(this).data("userInput");
                var messageInput = $('#messageInput').val();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SendMessage", "Message")",
                    data: { messageInput: messageInput },

                    success: function (result) {
                        if (result.success) {
                            loadNotifiMessage();
                        }
                        else {
                            
                        }

                    }
                });
            });
        });
    </script>
    <script>
        function loadNotifiMessage() {
            $('#notiComponent').load("/AjaxContent/ReloadNotificationMessage");
        }
    </script>
}