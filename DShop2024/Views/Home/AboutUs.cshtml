@model InformationShopModel
@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Contact Start -->
<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-4">
                <div class="col-12">
                    <div class="text-center mx-auto" style="max-width: 700px;">
                        <h1 class="text-primary">@Model.ShopName</h1>
                        <p><img src="~/media/Logo/@Model.LogoImg" width="200" height="120" /></p>
                        <p class="mb-4">@Html.Raw(Model.Description)</p>
                    </div>
                </div>
                <div class="col-12">
                    <div class="h-100 text-center rounded">
                        @Html.Raw(Model.Map)
                    </div>
                </div>
                <div class="col-lg-7">
                    <h5>Contact information</h5>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-map-marker-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Address</h4>
                            <p class="mb-2">@Model.Address</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-envelope fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Mail Us</h4>
                            <p class="mb-2">@Model.Email</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded bg-white">
                        <i class="fa fa-phone-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Hotline</h4>
                            <p class="mb-2">@Model.Phone</p>
                        </div>
                    </div>

               
                </div>
                <div class="col-lg-5">
                    <h5>Social media</h5>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fab fa-facebook-square fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Facebook</h4>
                            <p class="mb-2">@Html.Raw(Model.PluginFacebook)</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fab fa-youtube fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Youtube</h4>
                            <p class="mb-2">@Html.Raw(Model.PluginYoutube)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->

<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">



        </div>
    </div>
</div>
