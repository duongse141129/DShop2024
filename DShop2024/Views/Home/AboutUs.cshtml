@model InformationShopAndBranchesVM
@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Contact Start -->
<div class="container-fluid contact py-5 bg-white">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-4">
                <div class="col-12">
                    <div class="text-center mx-auto" style="max-width: 700px;">
                        <h1 class="text-primary">@Model.InformationShop.ShopName</h1>
                        <p><img src="~/media/Logo/@Model.InformationShop.LogoImg" width="200" height="120" /></p>
                        <p class="mb-4">@Html.Raw(Model.InformationShop.Description)</p>
                    </div>
                </div>
                <div class="col-lg-7">
                    <h5>Contact information</h5>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-map-marker-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Address</h4>
                            @foreach (var item in Model.Branches)
                            {
                                <p class="mb-2">@item.Address</p>
                            }
                        
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-envelope fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Mail Us</h4>
                            <p class="mb-2">@Model.InformationShop.Email</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded bg-white">
                        <i class="fa fa-phone-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Hotline</h4>
                            <p class="mb-2">@Model.InformationShop.Phone</p>
                        </div>
                    </div>

               
                </div>
                <div class="col-lg-5">
                    <h5>Social media</h5>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fab fa-facebook-square fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Facebook</h4>
                            <p class="mb-2">@Html.Raw(Model.InformationShop.PluginFacebook)</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fab fa-youtube fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Youtube</h4>
                            <p class="mb-2">@Html.Raw(Model.InformationShop.PluginYoutube)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row py-5">
                <h3>All Branches</h3>
                @foreach (var item in Model.Branches)
                {
                    <div class="col-sm-4">
                        <p><strong>@item.Name</strong></p>
                        <p>@item.Address</p>
                    </div>
                    <div class="col-sm-8">
                        @Html.Raw(item.MapEmbed)
                    </div>
                }
            </div>


            <div class="row py-5">
                <div class="col-sm-12">
                    <button class="btn btn-primary btn-lg" onclick="findNearestBranch()">Find nearest branch</button>
                    <div id="result" class="py-5"></div>
                    <div id="map"></div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- Contact End -->


@section Scripts{
    <script>
        function findNearestBranch() {
            if (!navigator.geolocation) {
                alert("Geolocation is not supported by your browser");
                return;
            }

            navigator.geolocation.getCurrentPosition(
                position => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;


                    fetch('@Url.Action("Nearest", "Branch", new { area = "" })', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            latitude: lat,
                            longitude: lng
                        })
                    })
                    .then(res => res.json())
                    .then(data => {
                        document.getElementById("result").innerHTML = `
                            <h3>Nearest Branch</h3>
                            <p><strong>${data.name}</strong></p>
                            <p>${data.address}</p>
                            <p>Distance: ${data.distance.toFixed(2)} km</p>
                        `;
                        document.getElementById("map").innerHTML = data.mapEmbed;

                    });
                },
                error => {
                    alert("Location permission denied.");
                }
            );
        }
    </script>
}
