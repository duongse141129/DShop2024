@using DShop2024.ViewModels
@model IEnumerable<ProductViewModel>

@{
	ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 mb-5" style="background-image: url('~home/images/background-pattern.jpg');background-repeat: no-repeat;background-size: cover;">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="banner-blocks">

                    <div class="banner-ad large bg-info block-1">

                        <div class="swiper main-swiper">
                            <div class="swiper-wrapper">
                                @foreach (var item in ViewBag.Banners as IEnumerable<BannerModel>)
                                {
                                    <div class="swiper-slide">
                                        <div class="row banner-content p-5">
                                            <h3 class="banner-title text-primary">@item.BannerName</h3>
                                            <img src="~/media/banners/@item.Image" class="img-fluid">
                                        </div>
                                    </div>
                                }                             
                            </div>

                            <div class="swiper-pagination"></div>

                        </div>
                    </div>

                    <div class="banner-ad bg-success-subtle block-2" style="background:url('~home/images/ad-image-1.png') no-repeat;background-position: right bottom">
                        <div class="row banner-content p-5">

                            <div class="content-wrapper col-md-5">
                                <h3 class="banner-title">Categories</h3>
                               

                                <a asp-area="" asp-action="Index" asp-controller="ShopProducts" class="d-flex align-items-center nav-link">Shop Collection <svg width="24" height="24"><use xlink:href="#arrow-right"></use></svg></a>
                            </div>
                            <div class="img-wrapper col-md-7">
                              
                                <img src="~/media/home/categoriesvsbag3.png" class="img-fluid" />
                            </div>

                        </div>
                    </div>

                    <div class="banner-ad bg-danger block-3" style="background:url('~home/images/ad-image-2.png') no-repeat;background-position: right bottom">
                        <div class="row banner-content p-5">

                            <div class="content-wrapper col-md-5">
                                <h3 class="item-title">Brands</h3>                          
                                <a asp-area="" asp-action="Index" asp-controller="ShopProducts" class="d-flex align-items-center nav-link">Shop Collection <svg width="24" height="24"><use xlink:href="#arrow-right"></use></svg></a>
                              
                            </div>
                            <div class="img-wrapper col-md-7">
                                <img src="~/media/home/backpackvsbrands.jpg" class="img-fluid" />
                            </div>  

                        </div>
                    </div> 

                </div>
                <!-- / Banner Blocks -->

            </div>
        </div>
    </div>
</section>

<section class="py-5 overflow-hidden">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="section-header d-flex flex-wrap justify-content-between mb-5">
                    <h2 class="section-title">Categories</h2>

                    <div class="d-flex align-items-center">
                        <a asp-area="" asp-action="Index" asp-controller="ShopProducts" class="btn-link text-decoration-none">View All Categories →</a>
                        <div class="swiper-buttons">
                            <button class="swiper-prev category-carousel-prev btn btn-yellow">❮</button>
                            <button class="swiper-next category-carousel-next btn btn-yellow">❯</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="row">
            <div class="col-md-12">

                <div class="category-carousel swiper">
                    <div class="swiper-wrapper">
                        @foreach (var item in ViewBag.Categories as IEnumerable<CategoryModel>)
                        {
                            <a asp-area="" asp-action="Index" asp-controller="ShopProducts" asp-route-CategorySlug="@item.Slug" class="nav-link category-item swiper-slide">
                                <img src="~/media/categories/@item.Image" alt="Category Thumbnail" width="100" height="100">
                                <h3 class="category-title">@item.CategoryName</h3>
                            </a>
                        }
                      
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>


<section class="py-5 overflow-hidden">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">

                <div class="section-header d-flex flex-wrap flex-wrap justify-content-between mb-5">

                    <h2 class="section-title"> Brands</h2>

                    <div class="d-flex align-items-center">
                        <a asp-area="" asp-action="Index" asp-controller="ShopProducts" class="btn-link text-decoration-none">View All Brands →</a>
                        <div class="swiper-buttons">
                            <button class="swiper-prev brand-carousel-prev btn btn-yellow">❮</button>
                            <button class="swiper-next brand-carousel-next btn btn-yellow">❯</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="row">
            <div class="col-md-12">

                <div class="brand-carousel swiper">
                    <div class="swiper-wrapper">
                        @foreach (var item in ViewBag.Brands as IEnumerable<BrandModel>)
                        {
                            <a asp-area="" asp-action="Index" asp-controller="ShopProducts" asp-route-BrandSlug="@item.Slug" class="nav-link category-item swiper-slide">
                            <div class="swiper-slide">
                                <div class="card mb-3 p-3 rounded-4 shadow border-0">
                                    <div class="row g-0">
                                        <div class="col-md-4">
                                        <img src="~/media/brands/@item.Image"  alt="Card title" height="100" width="100">
                                        </div>
                                        <div class="col-md-8">
                                            <div class="card-body py-0">
                                                <p class="text-muted mb-0"></p>
                                                <h4 class="card-title">@item.BrandName</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </a>
                        }
                       
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>


<section class="py-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="bootstrap-tabs product-tabs">
                    <div class="tabs-header d-flex justify-content-between border-bottom my-5">
                        <h3>Just Arrived Products</h3>
                    </div>
                    <div class="tab-content" id="nav-tabContent">
                        <div class="tab-pane fade show active" id="nav-all" role="tabpanel" aria-labelledby="nav-all-tab">

                            <div class="product-grid row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5">
                                @foreach (var item in Model)
                                {
                                    <div class="col">
                                        <div class="product-item">
                                            @if (User.Identity?.IsAuthenticated ?? false)
                                            {
                                                <a data-product_id="@item.Id" class="btn-compare add-btn-compare">
                                                    <i class="fas fa-retweet"></i>
                                                </a>
                                                <a data-product_id="@item.Id" class="btn-wishlist add-btn-wishlist">
                                                    <i class="far fa-heart"></i>
                                                </a>
                                            }                                     
                                            <figure>
                                                <a asp-area="" asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@item.Id" title="Product Title">
                                                    <img src="~/media/products/@item.Image" class="img-fluid">
                                                </a>
                                            </figure>
                                            <h3>@item.ProductName</h3>
                                            <span class="qty">Point</span><span class="rating"> @item.AveragePoint.ToString("#.##")</span>
                                            <div class="d-flex mb-2">
                                                <i class="fa fa-star @( item.AveragePoint >= 1 ? "text-primary " :  "")"></i>
                                                <i class="fa fa-star @( item.AveragePoint >= 2 ? "text-primary " :  "")"></i>
                                                <i class="fa fa-star @( item.AveragePoint >= 3 ? "text-primary " :  "")"></i>
                                                <i class="fa fa-star @( item.AveragePoint >= 4 ? "text-primary " :  "")"></i>
                                                <i class="fa fa-star @( item.AveragePoint >= 5 ? "text-primary " :  "")"></i>
                                            </div>
                                            <span class="price">@item.Price.ToString("#,##0 VND")</span>
                                            <span class="qty">@item.BrandName</span><br/>
                                            <span class="qty">@item.CategoryName</span>
                                            <div class="d-flex align-items-center justify-content-between">
                                                @if (item.Stock > 0)
                                                {
                                                    <button class="btn btn-primary add-to-cart" data-product_id="@item.Id">Add to Cart</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-primary add-to-cart">Out Of Order</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <!-- / product-grid -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<partial name="_HomePartial" />

@section Scripts {
	<script>
		$(document).ready(function () {
			$('.add-to-cart').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCart", "Cart")",
					data: { Id: Id },
					success: function (result) {
                        if (result.success) {
                            loadQuantityCart();
							Swal.fire("Add to cart successful");
                        } 
                        else {
                            Swal.fire(result.message);
                        }

					}
				});
			});
		});
	</script>
	
	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
                        if (result.success) {
							Swal.fire("Add to wishlist successful");
						}
						else {
                            Swal.fire(result.message);
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
                        if (result.success) {
                            Swal.fire("Add to compare successful");
						}
						else {
                            Swal.fire(result.message);
						}

					}
				});
			});
		});
	</script>
    <script>
        function loadQuantityCart() {
            $('#cartQuantity').load("/AjaxContent/QuantityCart");
        }
    </script>
}

