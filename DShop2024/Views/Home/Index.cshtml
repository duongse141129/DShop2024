@using DShop2024.EnumData
@model IEnumerable<ProductModel>

@{
	ViewData["Title"] = "Home Page";
}

<partial name="_SliderPartial" /> 
<div class="col-sm-3">
	<partial name="_SidebarPartial" />
</div> 

<div class="col-sm-9 padding-right">

	<form asp-action="Index" asp-controller="Home">
		<partial name="_FilterProductsPartial" />
	</form>

	<div class="features_items">
		<!--features_items-->
		<h2 class="title text-center">Features Items</h2>
		@foreach (var item in Model)
		{
		<div class="col-sm-4">
			<div class="product-image-wrapper">
				<div class="single-products">
				
						<div class="productinfo text-center">
							<a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id">
								<img src="~/media/products/@item.Image" alt="@item.ProductName" width="100%" height="200px"/>
								<h2>@item.Price.ToString("#,##0 VND")</h2>
								<p>@item.ProductName</p>
								<p>Category: @item.Category.CategoryName</p>
								<p>Brand: @item.Brand.BrandName</p>
							</a>
							@if(item.Stock > 0)
							{
								@* <a class="btn btn-default" asp-action="AddToCart" asp-controller="Cart" asp-route-Id="@item.Id"><i class="fa fa-shopping-cart"></i>Add to cart</a>  *@
								<button class="btn btn-default add-to-cart" data-product_id="@item.Id"><i class="fa fa-shopping-cart"></i>Add to Cart</button> 
							}
							else
							{
								<button class="btn btn-default add-to-cart"><i class="fa fa-shopping-cart"></i>Out Of Order</button>
							}

						</div>
					
				</div>
					
						
					
					<div class="choose">
						@if (User.Identity?.IsAuthenticated ?? false )
						{
							<ul class="nav nav-pills nav-justified">
								<li>
									<button class="btn btn-danger add-btn-wishlist" data-product_id="@item.Id">Add to Wishlist</button>
								</li>
								<li>
									<button class="btn btn-info add-btn-compare" data-product_id="@item.Id">Add to Compare</button>
								</li>
							</ul>
						}
				</div>
			</div>
		</div>
		}
	</div><!--features_items-->
	<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />

	<partial name="_HomePartial" />
</div>




@section Scripts {
	<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
	<script src="https://code.jquery.com/ui/1.14.1/jquery-ui.js"></script>
	<script>

		$(document).ready(function () {
			$(function () {
				$("#slider-range").slider({
					range: true,
					step: 50000,
					min: 100000,
					max: 5000000,
					// values: [100000, 300000],
					values: [@(ViewBag.startprice != "" ? ViewBag.startprice : 100000) , @(ViewBag.endPrice != "" ? ViewBag.endPrice : 800000)],
					slide: function (event, ui) {
						$("#amount").val(
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[0])
							+ " - " +
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[1]));
					}
				});
				$("#amount").val(
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 0))
					+ " - " +
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 1)));
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});

			$('.btn-locgia').on('click', function () {
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});
		});
	</script>
	<script>
		$(document).ready(function () {
			$('.add-to-cart').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCart", "Cart")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire("Add to cart successful");
						}

					}
				});
			});
		});
	</script>
	
	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire("Add to wishlist successful");
						}
						else {
							Swal.fire("Add to wishlist fail duplicate product");
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result) {
							
							Swal.fire("Add to compare successful");
						}
						else {
							Swal.fire("Add to compare fail duplicate or maximum 5 product");
						}

					}
				});
			});
		});
	</script>
}

					