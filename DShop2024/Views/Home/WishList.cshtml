@using DShop2024.ViewModels
@model IEnumerable<ProductViewModel>
@{
    ViewData["title"] = "Wishlist Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container-fluid bg-light  py-5">

@if(Model.Count() == 0)
{
    <h4>List wish list is empty</h4>
}
else
{

    <h4>List Compare Product </h4>
            <a asp-action="DeleteAllWishList" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home">Clear all</a>
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col">Stt</th>
                <th scope="col">Image</th>
                <th scope="col">Product Name</th>
                <th scope="col">Rating Point</th>
                <th scope="col">Brand</th>
                <th scope="col">Category</th>
                <th scope="col">Price</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
        @{
            int i = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@i</th>
                <td><img src="~/media/products/@item.MainImage" width="120" height="100" /></td>
                <td>
                    <a class="btn-link" asp-area="" asp-controller="ShopProducts" asp-action="Details" asp-route-Id="@item.Id">@item.ProductName</a>
                </td>
                <td>
                                <span class="rating"> @item.AveragePoint.ToString("#.##")</span>
                                <div class="d-flex mb-2">
                                    <i class="fa fa-star @( item.AveragePoint >= 1 ? "text-primary " :  "")"></i>
                                    <i class="fa fa-star @( item.AveragePoint >= 2 ? "text-primary " :  "")"></i>
                                    <i class="fa fa-star @( item.AveragePoint >= 3 ? "text-primary " :  "")"></i>
                                    <i class="fa fa-star @( item.AveragePoint >= 4 ? "text-primary " :  "")"></i>
                                    <i class="fa fa-star @( item.AveragePoint >= 5 ? "text-primary " :  "")"></i>
                                </div>
                </td>
                <td>@item.BrandName</td>
                <td>@item.CategoryName</td>
                <td>@item.Price.ToString("#,##0 VND")</td>
                <td>

                    <a asp-action="DeleteWishList" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home" asp-route-Id="@item.Id">Delete</a>
                </td>

            </tr>
            i++;
        }

        </tbody>

    </table>
            <partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
}
    </div>

</section>