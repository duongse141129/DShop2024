@model IEnumerable<DShop2024.Models.ProductModel>
@{
    ViewData["title"] = "Wishlist Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container-fluid bg-light  py-5">

@if(Model.Count() == 0)
{
    <h4>List compare is empty</h4>
}
else
{

    <h4>List Compare Product </h4>
            <a asp-action="DeleteAllWishList" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home">Clear all</a>
    <table class="table table-hover" id="myTable">
        <thead>
            <tr>
                <th scope="col">Stt</th>
                <th scope="col">Image</th>
                <th scope="col">Product Name</th>
                <th scope="col">Brand</th>
                <th scope="col">Category</th>
                <th scope="col">Price</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
        @{
            int i = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <th scope="row">@i</th>
                <td><img src="~/media/products/@item.MainImage" width="120" height="100" /></td>
                <td>@item.ProductName</td>
                <td>@item.Brand.BrandName</td>
                <td>@item.Category.CategoryName</td>
                <td>@item.Price.ToString("#,##0 VND")</td>
                <td>

                    <a asp-action="DeleteWishList" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home" asp-route-Id="@item.Id">Delete</a>
                </td>

            </tr>


            i++;

        }

        </tbody>

    </table>

}
    </div>

</section>