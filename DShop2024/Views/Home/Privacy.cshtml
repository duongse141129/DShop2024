@model IEnumerable<PolicyModel>
@{
    ViewData["Title"] = "Privacy Policy";
}


<section>
    <div class="container p-5 my-5 border ws">
        <h1>@ViewData["Title"]</h1>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        @foreach (var item in Model)
                        {
                            <h5 class="card-title">@item.Title</h5>
                            <p>@item.Description</p>
                            <br/>
                        }
                    </div>
                </div>
            </div>
    
        </div>
    </div>
</section>