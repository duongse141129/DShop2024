@using DShop2024.ViewModels
@model CartItemViewModel
@{
	ViewData["Title"] = "Checkout Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="pt-2 my-3">
    <div class="container-fluid py-5 ws">
          @await Component.InvokeAsync("AvailableCoupon")
    </div>
</section>


<div class="container-fluid py-5">
    <div class="container py-5 ws">
        <div class="p-5 rounded ws">
            <h1 class="mb-4">@ViewData["Title"]</h1>
      
                <div class="row g-5">
                    <div class="col-md-12 col-lg-6 col-xl-7">
                        <div class="mt-5">
                            <h3>Coupon</h3>
                        </div>
                        <div class="row">
                           <div class="col-md-12 col-lg-8">
                                <div class="form-item w-100">
                                <input type="text" class="form-control" id="coupon-value" placeholder="Coupon Code">
                                </div>
                            </div>
                            <div class="col-md-12 col-lg-4">
                                <div class="form-item w-100">
                                <button class="btn btn-primary rounded-pill" id="btn-apply-coupon" type="button">Apply Coupon</button>
                                </div>
                            </div>
                            <div class="col-md-12">
                                @foreach (var item in @Model.CouponsApply)
                                {
                                    <span class="text text-success">@item.CouponCode - @item.Description</span> <br />
                                }
                            </div>
                        </div>

                        <div class="mt-5">
                            <h3>Infomation Delivery</h3>
                        </div>
                        <div class="form-check mb-2">
                            <input type="checkbox" name="usemyinfo" class="form-check-input" id="usemyinfo" asp-for="@Model.InfoDelivery.IsUseMyInfo">
                            <label class="form-check-label" for="usemyinfo">   Use my information</label>
                        </div>
                        <div class="form-item">
                            <label class="form-label my-3">Province or City</label>
                            <select class="form-control css_select" id="tinh" name="tinh" title="Chọn Tỉnh Thành">
                                <option value="">Tỉnh Thành</option>
                            </select>
                        </div>

                        <div class="form-item">
                            <label class="form-label my-3">District</label>
                            <select class="form-control css_select" id="quan" name="quan" title="Chọn Quận Huyện">
                                <option value="">Quận Huyện</option>
                            </select>
                        </div>

                        <div class="form-item">
                            <label class="form-label my-3">Ward</label>
                            <select class="form-control css_select" id="phuong" name="phuong" title="Chọn Phường Xã">
                                <option value="">Phường Xã</option>
                            </select>
                        </div>

                        <div class="form-item">
                            <label asp-for="@Model.InfoDelivery.Street" class="form-label my-3"></label>
                            <input name="Street" id="Street" class="form-control" />
                        </div>

                        <div class="form-item">
                            <label asp-for="@Model.InfoDelivery.PhoneDelivery" name="PhoneDelivery" class="form-label my-3"></label>
                            <input name="PhoneDelivery" id="PhoneDelivery" class="form-control" />

                        </div>
                        <div class="form-item">
                            <label asp-for="@Model.InfoDelivery.Consignee" name="Consignee" class="form-label my-3"></label>
                            <input name="Consignee" id="Consignee" class="form-control" />

                        </div>
                        <div class="mt-5">
                            <button type="button" class="btn btn-primary btn-add-shipping">Shipping cost</button>
                        </div>
                        @if(!String.IsNullOrEmpty(Model.InfoDelivery.Street))
                        {
                            <div class="mt-5">
                                <h2>Confirm delivery information</h2>
                                <p>Consignee: @Model.InfoDelivery.Consignee</p>
                                <p>PhoneDelivery: @Model.InfoDelivery.PhoneDelivery </p>
                                <p>Adress: @Model.InfoDelivery.Street _ @Model.InfoDelivery.phuong _ @Model.InfoDelivery.quan _ @Model.InfoDelivery.tinh</p>
                            </div>
                        }

                         
                    </div>
                    <div class="col-md-12 col-lg-6 col-xl-5">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th scope="col">Products</th>
                                        <th scope="col">Name</th>
                                        <th scope="col">Price</th>
                                        <th scope="col">Quantity</th>
                                        <th scope="col">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        <tr>
                                            <th scope="row">
                                                <div class="d-flex align-items-center mt-2">
                                                    <img src="~/media/products/@item.Image" class="img-fluid rounded-circle" style="width: 90px; height: 90px;" alt="">
                                                </div>
                                            </th>
                                            <td class="py-5">@item.ProductName</td>
                                            <td class="py-5">@item.Price.ToString("#,##0 VND")</td>
                                            <td class="py-5">@item.Quantity</td>
                                            <td class="py-5">@item.Total.ToString("#,##0 VND")</td>
                                        </tr>
                                    }
                                    <tr>
                                        <th scope="row">
                                        </th>
                                        <td class="py-5"></td>
                                        <td class="py-5"></td>
                                        <td class="py-5">
                                            <p class="mb-0 text-dark py-3">Subtotal</p>
                                        </td>
                                        <td class="py-5">
                                            <div class="py-3 border-bottom border-top">
                                                <p class="mb-0 text-dark">@Model.SumPriceItemsCart.ToString("#,##0 VND")</p>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row">
                                        </th>
                                        <td class="py-5">
                                            <p class="mb-0 text-dark py-3">Coupon</p>
                                        </td>
                                        <td class="py-5"></td>
                                        <td class="py-5"></td>
                                        <td class="py-5">
                                            <div class="py-3 border-bottom border-top">
                                                    <p class="mb-0 text-dark">- @Model.SumCouponValue.ToString("#,##0 VND")</p>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th scope="row">
                                        </th>
                                        <td class="py-5">
                                            <p class="mb-0 text-dark text-uppercase py-3">Shipping</p>
                                        </td>
                                        <td class="py-5"></td>
                                        <td class="py-5"></td>
                                        <td class="py-5">
                                            <div class="py-3 border-bottom border-top">
                                                <p class="mb-0 text-dark">+ @Model.InfoDelivery.ShippingCost.ToString("#,##0 VND")</p>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th scope="row">
                                        </th>
                                        <td class="py-5">
                                            <p class="mb-0 text-dark text-uppercase py-3">TOTAL</p>
                                        </td>
                                        <td class="py-5"></td>
                                        <td class="py-5"></td>
                                        <td class="py-5">
                                            <div class="py-3 border-bottom border-top">
                                                <p class="mb-0 text-dark">@Model.GrandTotal.ToString("#,##0 VND")</p>
                                            </div>
                                        </td>
                                    </tr>

     
                                </tbody>
                            </table>
                        </div>  
                        <form method="POST" asp-action="CheckOut" asp-controller="CheckOut">
                            <div class="row g-4 text-center align-items-center justify-content-center border-bottom py-3">
                                <div class="col-12">
                                    <td class="py-5">
                                        <h3 class="mb-0 text-dark py-2">Payment method</h3>
                                    </td>
                                    @foreach (var item in Model.Payments)
                                    {                                      
                                        <div class="form-check text-start my-3">
                                            <input type="radio" class="form-check-input bg-primary border-0" id="payment_@item.PaymentName" name="payment" value="@item.PaymentName" @( item.PaymentName == PaymentEnumData.COD ? "checked" : "") >
                                            <img src="~/media/payment/@item.Logo"  width="50"/>
                                            <label class="form-check-label" for="payment_@item.PaymentName">@item.PaymentName</label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                                <button type="submit" class="btn btn-primary border-secondary py-3 px-4 text-uppercase w-100">Place Order</button>
                            </div>

                        </form>
                    </div>
                </div>
        
        </div>
    </div>
</div>



@section Scripts {
    <link href="~/custom/css/couponSlider.css" rel="stylesheet" />
    <script src="~/custom/js/couponSlider.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#usemyinfo").change(function () {
            if($(this).prop("checked")){
                $(this).val(true);
            }else{
                $(this).val(false);
            }
                var checkInfo = $("#usemyinfo").val();
                $.ajax({
                type: "POST",
                url: "@Url.Action("UseMyInformation", "Cart")",
                data: { checkInfo: checkInfo },
                success: function (result) {
                        if (result.success) {      
                             Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							}).then(function(){
                                 location.reload();
                            });
                        } else {
                              Swal.fire({
							  icon: "error",
				              title: "Oops...",
                              text: result.message
							}).then(function(){
                                 location.reload();
                            });
                        }
                    }
                });

        });

    </script>

    <script>
        $("#btn-apply-coupon").click(function () {
            var couponCode = $("#coupon-value").val();
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetCoupon", "Cart")",
                data: { couponCode: couponCode },
                success: function (result) {
                    if (result.success) {     
                        	Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							}).then(function(){
                                 location.reload();
                            });

                    } else {
                        Swal.fire(result.message);
                    }
                }
            });
        });

    </script>
    <script>
        $(document).ready(function () {
            $(".btn-add-shipping").click(function () {
                var tinh = $('#tinh').find('option:selected').text();
                var quan = $('#quan').find('option:selected').text();
                var phuong = $('#phuong').find('option:selected').text();
                var street = $('#Street').val();
                var phonedelevery = $('#PhoneDelivery').val();
                var consignee = $('#Consignee').val();
                // var price = $('#price-shippng').val();
                if (tinh == 'Tỉnh Thành' || quan == 'Quận Huyện' || phuong == 'Phường Xã' || street == '' || phonedelevery == '' || consignee == '') {
                    Swal.fire("Please input all value");
                } else {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("GetShipping", "Cart")",
                        data: { tinh: tinh, quan: quan, phuong: phuong, street: street, PhoneDelivery: phonedelevery, consignee: consignee },
                        success: function (result) {
                            if (result.success) {
                                 Swal.fire({
							      position: "top-end",
							      icon: "success",
							      title: result.message,
							      showConfirmButton: false,
							      timer: 500
							    }).then(function(){
                                     location.reload();
                                });

                            } else {
                                Swal.fire(result.message);
                            }

                        }
                    });
                }
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            //Lấy tỉnh thành
            $.getJSON('https://esgoo.net/api-tinhthanh/1/0.htm', function (data_tinh) {
                if (data_tinh.error == 0) {
                    $.each(data_tinh.data, function (key_tinh, val_tinh) {
                        $("#tinh").append('<option value="' + val_tinh.id + '">' + val_tinh.full_name + '</option>');
                    });
                    $("#tinh").change(function (e) {
                        var idtinh = $(this).val();
                        //Lấy quận huyện
                        $.getJSON('https://esgoo.net/api-tinhthanh/2/' + idtinh + '.htm', function (data_quan) {
                            if (data_quan.error == 0) {
                                $("#quan").html('<option value="0">Quận Huyện</option>');
                                $("#phuong").html('<option value="0">Phường Xã</option>');
                                $.each(data_quan.data, function (key_quan, val_quan) {
                                    $("#quan").append('<option value="' + val_quan.id + '">' + val_quan.full_name + '</option>');
                                });
                                //Lấy phường xã
                                $("#quan").change(function (e) {
                                    var idquan = $(this).val();
                                    $.getJSON('https://esgoo.net/api-tinhthanh/3/' + idquan + '.htm', function (data_phuong) {
                                        if (data_phuong.error == 0) {
                                            $("#phuong").html('<option value="0">Phường Xã</option>');
                                            $.each(data_phuong.data, function (key_phuong, val_phuong) {
                                                $("#phuong").append('<option value="' + val_phuong.id + '">' + val_phuong.full_name + '</option>');
                                            });
                                        }
                                    });
                                });

                            }
                        });
                    });

                }
            });
        });
    </script>

    <script>
        $('.copy-data').on('click', async function () {
          const text = $(this).data('copy') + '';
          const btn = this;

          if (navigator.clipboard?.writeText) {
            try {
              await navigator.clipboard.writeText(text);
              $(btn).text('Copied ✓').prop('disabled', true);
              setTimeout(() => $(btn).text('Save').prop('disabled', false), 1500);
              return;
            } catch (e) {
            }
          }
          const $temp = $('<textarea>').css({position: 'absolute', left: '-9999px'}).val(text).appendTo('body');
          $temp.select();
          try { document.execCommand('copy'); $(btn).text('Copied ✓').prop('disabled', true); }
          catch (e) { alert('Copy failed.'); }
          $temp.remove();
          setTimeout(() => $(btn).text('Save').prop('disabled', false), 1500);
        });
    </script>

}
