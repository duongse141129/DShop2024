@model IEnumerable<OrderViewModel>
@{
    ViewData["title"] = "History shopping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid contact py-5 bg-white rounded">
 
        <div class="table-head-bg-secondary">
            <h1>@ViewData["title"]</h1>
            @if (Model.Count() > 0)
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Order code</th>
                            <th scope="col">Order Date</th>
                            <th scope="col">Payment</th>
                            <th scope="col">Payment Status</th>
                            <th scope="col">GrandTotal</th>
                            <th scope="col">Status</th>
                            <th scope="col">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th>@item.OrderCode</th>
                                <td>@item.CreatedDate.ToString("MM/dd/yyyy h:mm tt")</td>
                                <td>@item.PaymentName</td>
                                <td>
                                    <span class="payment-status-@((OrderEnumData.PaymentStatusOrder)item.PaymentStatus)">
                                        @((OrderEnumData.PaymentStatusOrder)item.PaymentStatus)
                                    </span>
                                </td>
                                <td>@item.GrandTotal.ToString("#,##0 VND")</td>
                                <td>
                                    @if(item.IsReturn)
                                    {
                                        @if (item.IsFullReturn)
                                        {
                                            <span class="order-fullly-returned">@OrderEnumData.FULLY_RETURNED</span>
                                        }
                                        else
                                        {
                                            <span class="order-partially-returned">@OrderEnumData.PARTIALLY_RETURNED</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text status-order-@((OrderEnumData.StatusOrder)item.Status)"> @((OrderEnumData.StatusOrder)item.Status) </span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-md btn-info text-white" asp-action="Details" asp-controller="Order" asp-area="" asp-route-id="@item.Id">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
            }
            else
            {
                <h2>
                    You have never bought anything at the shop.
                </h2>
            }
        </div>
    
</div>

