@model OrderViewModel
@{
    ViewData["title"] = "Order detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <h1>@ViewData["title"]</h1>
            <hr>
            <section class="py-3 py-md-5 ">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 col-lg-9 col-xl-8 col-xxl-7">
                            <div class="row gy-3 mb-3">
                                <div class="col-md-12">
                                    <h2 class="text-uppercase text-endx m-0">Invoice: @Model.OrderCode</h2>
                                </div>
                                <div class="col-md-12">
                                    @if (Model.Status == 0)
                                    {
                                        <h4 class="text-danger">Invoice has been cancelled</h4>
                                    }
                                    else
                                    {
                                        <div class="track">
                                            <div class="step @(Model.Status >= 1 ? "active" : "")"> <span class="icon"> <i class="fa fa-check"></i> </span> <span class="text">Order confirmed</span> </div>
                                            <div class="step @(Model.Status >= 2 ? "active" : "")"> <span class="icon"> <i class="fa fa-user"></i> </span> <span class="text"> Picked by courier</span> </div>
                                            <div class="step @(Model.Status >= 3 ? "active" : "")"> <span class="icon"> <i class="fa fa-truck"></i> </span> <span class="text"> On the way </span> </div>
                                            <div class="step @(Model.Status == 4 ? "active" : "")"> <span class="icon"> <i class="fa fa-box"></i> </span> <span class="text">Ready for pickup</span> </div>
                                        </div>
                                    }

                                    <hr>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-sm-6">
                                    <address>
                                        <strong>@Model.CreatedDate.ToLongDateString()</strong><br>
                                        @Model.CreatedDate.ToLongTimeString()<br>
                                        Payment method: @Model.PaymentName<br>
                                    </address>
                                    <h4>Bill To</h4>
                                    <address>
                                        <strong>@Model.CustomerName</strong><br>
                                        Email: @Model.CustomerEmail<br>
                                        Consignee: @Model.Consignee<br>
                                        Address: @Model.AddressDelivery<br>
                                        Phone: @Model.PhoneDelivery
                                    </address>
                                </div>
                                <div class="col-sm-6">
                                    <h4>Coupon Apply</h4>
                                    @if (Model.OrderCoupons.Count > 0)
                                    {
                                        @foreach (var coupon in Model.OrderCoupons)
                                        {
                                            <b>@coupon.Coupon.CouponCode</b> 
                                        }
                                    }
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-12">
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="text-uppercase">Stt</th>
                                                    <th scope="col" class="text-uppercase">Product Name</th>
                                                    <th scope="col" class="text-uppercase">Quantity</th>
                                                    <th scope="col" class="text-uppercase text-end">Price</th>
                                                    <th scope="col" class="text-uppercase text-end">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody class="table-group-divider">
                                                @{
                                                    int i = 1;
                                                }
                                                @foreach (var od in Model.OrderDetails)
                                                {
                                                    <tr>
                                                        <td scope="row">@i</td>
                                                        <td>
                                                            <a class="btn-link" asp-area="" asp-controller="ShopProducts" asp-action="Details" asp-route-Id="@od.ProductId">@od.ProductName</a>
                                                            <img src="~/media/products/@od.MainImage" width="120" height="100" />
                                                        </td>
                                                        <td>@od.Quantity</td>
                                                        <td class="text-end">@od.Price.ToString("#,##0 VND")</td>
                                                        @{
                                                            var subsum = od.Quantity * od.Price;
                                                        }
                                                        <td class="text-end">@subsum.ToString("#,##0 VND")</td>
                                                    </tr>
                                                    i++;
                                                }

                                                <tr>
                                                    <td></td>
                                                    <td colspan="3" class="text-end">Subtotal</td>
                                                    <td class="text-end">@Model.OrderDetails.Sum(od => od.Quantity * od.Price).ToString("#,##0 VND")</td>
                                                </tr>
                                                <tr>
                                                    <td></td>
                                                    <td colspan="3" class="text-end">coupon</td>
                                                    <td class="text-end">- @Model.ValueCoupon.ToString("#,##0 VND")</td>
                                                </tr>
                                                <tr>
                                                    <td></td>
                                                    <td colspan="3" class="text-end">Shipping Cost</td>
                                                    <td class="text-end">+ @Model.ShippingCost.ToString("#,##0 VND")</td>
                                                </tr>
                                                <tr>
                                                    <td></td>
                                                    <th scope="row" colspan="3" class="text-uppercase text-end">Total</th>
                                                    <td class="text-end">@Model.GrandTotal.ToString("#,##0 VND")</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>


                    </div>
                    @if (Model.Status == 1)
                    {
                        <div class="row">
                            <div class="col-md-4">
                                <a class="btn btn-danger btn-md confirmDeletion" asp-action="CancelOrder" asp-controller="Order" asp-area="" asp-route-id="@Model.Id">Cancel order</a>
                            </div>
                        </div>
                    }
                    @if (Model.AllowReturn == true && Model.IsReturn == false)
                    {
                        <div class="row mx-5">
                            <div class="col-md-4">
                                <button class="btn btn-sm btn-info"
                                        onclick="openModal('/Order/GetPopUpReturn?Id=@Model.Id')">
                                    <i class="fa fa-reply"></i>
                                    Return
                                </button>
                            </div>
                        </div>

                    }
                </div>
            </section>
            <hr>
            <div class="mt-3">
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="mainModal">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/custom/js/popup.js"></script>
}



