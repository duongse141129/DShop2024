	<script>
		$(document).on("click", ".add-to-cart-quantity", function () {

			const productId = $(this).data("product-id");
			const quantity = $(this)
				.closest(".product-item")
				.find(".quantity-input")
				.val();

			$.ajax({
				type: "POST",
				url: "@Url.Action("AddQuantityToCart", "Cart")",
				data: {
					productId: productId,
					quantity: quantity
				},
				success: function (result) {
					if (result.success) {
						Swal.fire({
							position: "top-end",
							icon: "success",
							title: result.message,
							showConfirmButton: false,
							timer: 800
						});
						loadQuantityCart();
					} else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
					}
				}
			});
		});
	</script>


	<script>
		$(document).ready(function () {
			$(function () {
				$("#slider-range").slider({
					range: true,
					step: 50000,
					min: 0,
					max: 2000000,
					// values: [100000, 300000],
					values: [@(ViewBag.startprice != "" ? ViewBag.startprice : 50000) , @(ViewBag.endPrice != "" ? ViewBag.endPrice : 800000)],
					slide: function (event, ui) {
						$("#amount").val(
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[0])
							+ " - " +
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[1]));
					}
				});
				$("#amount").val(
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 0))
					+ " - " +
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 1)));
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});

			$('.btn-locgia').on('click', function () {
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>
	<script>
		function loadQuantityCart() {
			$('#cartQuantity').load("/AjaxContent/QuantityCart");
		}
	</script>

}