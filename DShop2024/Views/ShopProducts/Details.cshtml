@using DShop2024.ViewModels
@model ProductDetailViewModel
@{
	ViewData["Title"] = "Detail";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="py-5">
<!-- Single Product Start -->
<div class="container-fluid bg-light py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
             <div class="col-lg-4 col-xl-3">
                 <partial name="_SidebarPartial" />             
             </div>
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">
                  
                    <div class="col-lg-7">
                            <div id="content-wrapper">
                                <div class="column">
									<img id=featured src="~/media/products/@Model.ProductDetail.MainImage" class="img-fluid rounded">

                                    <div id="slide-wrapper">
                                        <img id="slideLeft" class="arrow" src="~/img/arrow-left.png">

                                        <div id="slider">
                                            <img class="thumbnail active" src="~/media/products/@Model.ProductDetail.MainImage">
											@foreach (var item in Model.ExistingImages)
											{
												<img class="thumbnail" src="~/@item" class="img-fluid rounded">
											}
                                        </div>

                                        <img id="slideRight" class="arrow" src="~/img/arrow-right.png">
                                    </div>
                                </div>

                            </div>
   
						<div class="py-2">
								@if (User.Identity?.IsAuthenticated ?? false)
								{
									<ul class="nav nav-pills nav-justified">
										<li>
											@if (!Model.IsInWishlist)
											{
												<button class="btn btn-danger add-btn-detail-wishlist" data-product_id="@Model.ProductDetail.Id"><i class="far fa-heart"></i>Add to Wishlist</button>
											}

										</li>
										<li>
											@if (!Model.IsInCompare)
											{
												<button class="btn btn-info add-btn-detail-compare" data-product_id="@Model.ProductDetail.Id">	<i class="fas fa-retweet"></i>Add to Compare</button>
											}


										</li>
									</ul>
								}
						</div>


					</div>
                    <div class="col-lg-5">
                        <h2 class="fw-bold mb-3">@Model.ProductDetail.ProductName</h2>
                            <p class="mb-3"> <b>Category:</b> @Model.ProductDetail.Category.CategoryName</p>
                            <p class="mb-3"> <b>Brand:</b> @Model.ProductDetail.Brand.BrandName</p>

						<h5 class="fw-bold mb-3">@Model.ProductDetail.Price.ToString("#,##0 VND")</h5>

                        <div class="d-flex mb-2">
								<p class="mb-0 me-3"> <b>Point:</b> @Model.Point.ToString("#.##") </p>
                             <i class="@( Model.Point >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point == 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                        </div>
                            <p><b>Dimension (CM): </b>@Model.ProductDetail.Dimension</p>
                            <p><b>Capacity (L): </b> @Model.ProductDetail.Capacity</p>
                            <p><b>Weight (KG): </b> @Model.ProductDetail.Weight</p>
                            <p><b>Material: </b> @Model.ProductDetail.Material</p>
                            <p><b>Main Pockets: </b> @Model.ProductDetail.MainPocket</p>
                            @if (Model.ProductDetail.LaptopPocket != null)
                            {
                                <p><b>Laptop Pocket: </b> @Model.ProductDetail.LaptopPocket</p>
                            }

                            @if (Model.ProductDetail.WaterResistance == true)
                            {
                                <p><b>Water Resistance</b></p>
                            }
                            @if (Model.ProductDetail.USBChargingPort == true)
                            {
                                <p><b>USB Charging Port</b> </p>
                            }
							<form asp-area="" asp-action="AddQuantityToCart" asp-controller="Cart" method="post" id="form-detail-@Model.ProductDetail.Id">
								<div class="d-flex align-items-center justify-content-between">
									<input type="hidden" class="form-control input-number" name="productId" value="@Model.ProductDetail.Id">
									<div class="input-group product-qty">
										<span class="input-group-btn" >
											<button type="button" class="quantity-left-minus btn btn-number buttonQuantityMinus" data-type="minus">
												<i class="fas fa-minus"></i>
											</button>
										</span>
										<input type="text" id="quantity" name="quantity" class="input-number quantityDetail" value="1" min="1" step="1">
										<span class="input-group-btn">
											<button type="button" class="quantity-right-plus btn btn-number buttonQuantityPlus" data-type="plus">
												<i class="fas fa-plus"></i>
											</button>
										</span>
									</div>
								</div>
							</form>
							<button class="btn btn-primary btn-md add-to-cart-quantity mt-2" id="detail-@Model.ProductDetail.Id">
								<i class="fas fa-cart-plus"></i> Add to Cart
							</button>

                    </div>
                    <div class="card col-lg-12">
                        <nav>
                            <div class="nav nav-tabs mb-3">
                                <button class="nav-link active border-white border-bottom-0" type="button" role="tab"
                                        id="nav-about-tab" data-bs-toggle="tab" data-bs-target="#nav-about"
                                        aria-controls="nav-about" aria-selected="true">
                                    Description
                                </button>
                                    <button class="nav-link border-white border-bottom-0" type="button" role="tab"
                                            id="nav-category-tab" data-bs-toggle="tab" data-bs-target="#nav-category"
                                            aria-controls="nav-category" aria-selected="false">
                                        Category
                                    </button>
                                    <button class="nav-link border-white border-bottom-0" type="button" role="tab"
                                            id="nav-brand-tab" data-bs-toggle="tab" data-bs-target="#nav-brand"
                                            aria-controls="nav-brand" aria-selected="false">
                                        Brand
                                    </button>
                            </div>
                        </nav>
                        <div class="tab-content mb-5">
                            <div class="tab-pane active" id="nav-about" role="tabpanel" aria-labelledby="nav-about-tab">
                                    @Html.Raw(@Model.ProductDetail.Description)
                            </div>
                                                      
                                <div class="tab-pane" id="nav-category" role="tabpanel" aria-labelledby="nav-category-tab">
									<h4>@Model.ProductDetail.Brand.BrandName</h4>
									<img src="~/media/brands/@Model.ProductDetail.Brand.Image" width="120" height="100" />
									<p>@Html.Raw(@Model.ProductDetail.Brand.Description)</p>
                                </div>
                   
                                <div class="tab-pane" id="nav-brand" role="tabpanel" aria-labelledby="nav-brand-tab">
									<h4>@Model.ProductDetail.Category.CategoryName</h4>
									<img src="~/media/categories/@Model.ProductDetail.Category.Image" width="120" height="100" />
									<p>@Html.Raw(@Model.ProductDetail.Category.Description)</p>
                                </div>
                        </div>
                    </div>
						<h4>Feedback </h4>
						<span> <strong>Average Point:</strong> @Model.Point </span>
						<div class="response-area">
							<div class="media-list">
								@foreach (var item in Model.listRating)
								{
									<div class="card col-md-8 mt-2">
										<div class="row pb-2 mt-2 me-4 ms-2">
											<div class="col-sm-3 ">
												<img class="media-object" src="~/media/avatar/@item.User.Avatar" width="100" style="height:100px" alt="">
											</div>
											<div class="col-md-9">
												<ul class="sinlge-post-meta">
													<li><i class="fa fa-user"></i>@item.User.UserName</li>
													<li><i class="far fa-clock"></i>@item.RatingDateTime?.ToShortTimeString()</li>
													<li><i class="fa fa-calendar"></i>@item.RatingDateTime?.ToShortDateString()</li>
												</ul>
												<div class="d-flex justify-content-between">
													<div class="d-flex mb-2">
														<i class="@( item.Star >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
														<i class="@( item.Star >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
														<i class="@( item.Star >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
														<i class="@( item.Star >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
														<i class="@( item.Star >= 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
													</div>
												</div>
												<p>@item.Comment</p>
		
											</div>
											@if (item.ReplyMessage != null)
											{
												<div class="row pb-2 ms-2 ws">
													<strong>Response to customer feedback</strong>
													<p>@item.ReplyMessage</p>
												</div>
											}
										</div>
									</div>
								}
							</div>
						</div>
						@if (ViewBag.pagingmodel != null)
						{
							<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
						}
						@if (User.Identity?.IsAuthenticated ?? false)
						{
							<h4>Your feekback</h4>
							@if (Model.IsOrder)
							{
								@if (Model.IsFeedback)
								{
																
								<div class="d-flex">
									<img src="~/media/avatar/@Model.Feedback.User.Avatar" class="img-fluid rounded-circle p-3" style="width: 100px; height: 100px;" alt="">
									<div class="">
										<p class="mb-2" style="font-size: 14px;">@Model.Feedback.RatingDateTime?.ToShortDateString()</p>
										<div class="d-flex justify-content-start">
											<h5>@Model.Feedback.User.UserName</h5>
											<p> Point: @Model.Feedback.Star </p>
											<div class="d-flex mb-3">										
												<i class="@( Model.Feedback.Star >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
											</div>
										</div>
										<p class="text-dark">
											@Model.Feedback.Comment
										</p>
									</div>
								</div>
									<br />
								}
								else
								{
									<form autocomplete="off" asp-action="CommentProduct" asp-controller="Rating" method="post">
										<div asp-validation-summary="ModelOnly" class="text-danger"></div>
										<h4 class="mb-5 fw-bold">Leave a Reply</h4>
										<div class="row g-4">
											<div class="form-group col-sm-6">
												<label>Point</label>
												<input type="hidden" name="ProductId" asp-for="@Model.Feedback.ProductId" value="@Model.ProductDetail.Id" />
												<input name="Star" asp-for="@Model.Feedback.Star" step="1" class="form-control" />
												<span name="Star" data-valmsg-for="Star" data-valmsg-replace="true"  class="text-danger" />
											</div>
											<div class="form-group">
												<label>Comment</label>
												<textarea rows="8" name="Comment" asp-for="@Model.Feedback.Comment" class="form-control"></textarea>
											</div>

											<div class="col-lg-12">
												<div class="d-flex justify-content-between py-3 mb-5">
													<div class="d-flex align-items-center">
													</div>
													<button type="submit" class="btn btn-primary border border-secondary rounded-pill px-4 py-3">
														Submit
													</button>
												</div>
											</div>
										</div>
									</form>
								}
							}
							else
							{
								<p>You have not purchased this product yet.</p>
							}
						}



                </div>
            </div>
          
        </div>
        <h1 class="fw-bold mb-0">Related products</h1>

        <div class="vesitable">
            <div class="owl-carousel vegetable-carousel justify-content-center">
                @if (ViewBag.relatedProducts != null)
                {
					@foreach (var relatedProduct in ViewBag.relatedProducts as IEnumerable<ProductViewModel>)
                    {
                        <div class="border border-primary rounded position-relative vesitable-item">
                            <div class="vesitable-img">
									<a asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@relatedProduct.Id" title="Product Title">
										<img src="~/media/products/@relatedProduct.MainImage" class="img-fluid w-100 rounded-top" alt="" style="height : 300px">
									</a>
                            </div>
                                <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; right: 10px;">@relatedProduct.BrandName</div>
                            <div class="p-4 pb-0 rounded-bottom">
                                <h4>@relatedProduct.ProductName</h4>
									<span class="qty">Point</span><span class="rating"> @relatedProduct.AveragePoint.ToString("#.##")</span>
									<div class="d-flex mb-2">
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 1 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 2 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 3 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 4 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 5 ? "text-primary " :  "")"></i>
									</div>
									<p class="text-dark fs-5 fw-bold">@relatedProduct.Price.ToString("#,##0 VND")</p>
									<form asp-area="" asp-action="AddQuantityToCart" asp-controller="Cart" method="post" id="form-related-@relatedProduct.Id">
										<input type="hidden" class="form-control input-number" name="productId" value="@relatedProduct.Id">
										<input type="hidden" id="quantity" name="quantity" class="input-number" value="1">
									</form>								
										<div class="d-flex justify-content-between flex-lg-wrap my-2">
												<button class="btn btn-primary btn-md add-to-cart-quantity " id="related-@relatedProduct.Id">
													<i class="fas fa-cart-plus"></i> Add to Cart
												</button>
												@if (User.Identity?.IsAuthenticated ?? false)
												{
													<a data-product_id="@relatedProduct.Id" class="btn-compare add-btn-compare relatedCompare">
														<i class="fas fa-retweet"></i>
													</a>
													<a data-product_id="@relatedProduct.Id" class="btn-wishlist add-btn-wishlist relatedWishlist">
														<i class="far fa-heart"></i>
													</a>
												}
										</div>
									

                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <div class="container-fluid ">
			@await Component.InvokeAsync("RecentlyViewedProduct")
    </div>

</div>
<!-- Single Product End -->



</section>


@section Scripts {
	<link href="~/custom/css/gallery.css" rel="stylesheet" />
	<script type="text/javascript" src="~/custom/js/gallery.js"></script>

	<script>
		$(document).ready(function () {
			$('.add-to-cart-quantity').click(function () {
				var formId  ="form-"+ $(this).attr('id');
				console.log(formId);
				var form = document.getElementById(formId);
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddQuantityToCart", "Cart")",
					data: new FormData(form),
					contentType: false,
					processData: false,
					success: function (result) {
						if (result.success) {
						   loadQuantityCart();
						   Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>
	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-detail-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
							$('.add-btn-detail-wishlist').hide();
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}
					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-detail-compare').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
							$('.add-btn-detail-compare').hide();
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}
					}
				});
			});
		});
	</script>

	<script>
		function loadQuantityCart() {
			$('#cartQuantity').load("/AjaxContent/QuantityCart");
		}
	</script>

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
