@using DShop2024.ViewModels
@model ProductDetailViewModel
@{
	ViewData["Title"] = "Detail";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
<!-- Single Product Start -->
<div class="container-fluid bg-light py-5 mt-5">
    <div class="container py-5">
        <div class="row g-4 mb-5">
             <div class="col-lg-4 col-xl-3">
                 <partial name="_SidebarPartial" />             
             </div>
            <div class="col-lg-8 col-xl-9">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="border rounded">
                            <a href="#">
                                <img src="~/media/products/@Model.ProductDetail.Image" class="img-fluid rounded" alt="Image">
                            </a>
                        </div>
						<div class="mt-5 py-5">
								@if (User.Identity?.IsAuthenticated ?? false)
								{
									<ul class="nav nav-pills nav-justified">
										<li>
											@if (!Model.IsInWishlist)
											{
												<button class="btn btn-danger add-btn-detail-wishlist" data-product_id="@Model.ProductDetail.Id"><i class="far fa-heart"></i>Add to Wishlist</button>
											}

										</li>
										<li>
											@if (!Model.IsInCompare)
											{
												<button class="btn btn-info add-btn-detail-compare" data-product_id="@Model.ProductDetail.Id">	<i class="fas fa-retweet"></i>Add to Compare</button>
											}


										</li>
									</ul>
								}
						</div>


					</div>
                    <div class="col-lg-6">
                        <h4 class="fw-bold mb-3">@Model.ProductDetail.ProductName</h4>
                            <p class="mb-3"> <b>Category:</b> @Model.ProductDetail.Category.CategoryName</p>
                            <p class="mb-3"> <b>Brand:</b> @Model.ProductDetail.Brand.BrandName</p>

						<h5 class="fw-bold mb-3">@Model.ProductDetail.Price.ToString("#,##0 VND")</h5>

                        <div class="d-flex mb-2">
								<p class="mb-0 me-3"> <b>Point:</b> @Model.Point </p>
                             <i class="@( Model.Point >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                             <i class="@( Model.Point == 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
                        </div>
                            <p><b>Dimension (CM): </b>@Model.ProductDetail.Dimension</p>
                            <p><b>Capacity (L): </b> @Model.ProductDetail.Capacity</p>
                            <p><b>Weight (KG): </b> @Model.ProductDetail.Weight</p>
                            <p><b>Material: </b> @Model.ProductDetail.Material</p>
                            <p><b>Main Pockets: </b> @Model.ProductDetail.MainPocket</p>
                            @if (Model.ProductDetail.LaptopPocket != null)
                            {
                                <p><b>Laptop Pocket: </b> @Model.ProductDetail.LaptopPocket</p>
                            }

                            @if (Model.ProductDetail.WaterResistance == true)
                            {
                                <p><b>Water Resistance</b></p>
                            }
                            @if (Model.ProductDetail.USBChargingPort == true)
                            {
                                <p><b>USB Charging Port</b> </p>
                            }
                        <div class="input-group quantity mb-5" style="width: 100px;">
                            <div class="input-group-btn">
                                <button class="btn btn-sm btn-minus rounded-circle bg-light border">
                                    <i class="fa fa-minus"></i>
                                </button>
                            </div>
							<input type="text" class="form-control form-control-sm text-center border-0" min="1" value="1" max="10" step="1" readonly >
                            <div class="input-group-btn">
                                <button class="btn btn-sm btn-plus rounded-circle bg-light border">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
							@if (Model.ProductDetail.Stock > 0)
							{

								<button class="btn border border-secondary rounded-pill px-4 py-2 mb-4 text-primary add-to-cart" data-product_id="@Model.ProductDetail.Id"><i class="fa fa-shopping-cart"></i>Add to Cart</button>

							}
							else
							{
								<button type="button" class="btn-outline-dark cart">
									<i class="fa fa-shopping-cart"></i>
									Out Of Order
								</button>
							}
                    </div>
                    <div class="col-lg-12">
                        <nav>
                            <div class="nav nav-tabs mb-3">
                                <button class="nav-link active border-white border-bottom-0" type="button" role="tab"
                                        id="nav-about-tab" data-bs-toggle="tab" data-bs-target="#nav-about"
                                        aria-controls="nav-about" aria-selected="true">
                                    Description
                                </button>
                                    <button class="nav-link border-white border-bottom-0" type="button" role="tab"
                                            id="nav-category-tab" data-bs-toggle="tab" data-bs-target="#nav-category"
                                            aria-controls="nav-category" aria-selected="false">
                                        Category
                                    </button>
                                    <button class="nav-link border-white border-bottom-0" type="button" role="tab"
                                            id="nav-brand-tab" data-bs-toggle="tab" data-bs-target="#nav-brand"
                                            aria-controls="nav-brand" aria-selected="false">
                                        Brand
                                    </button>
                            </div>
                        </nav>
                        <div class="tab-content mb-5">
                            <div class="tab-pane active" id="nav-about" role="tabpanel" aria-labelledby="nav-about-tab">
                                    @Html.Raw(@Model.ProductDetail.Description);
                            </div>
                            
                            


                                <div class="tab-pane" id="nav-category" role="tabpanel" aria-labelledby="nav-category-tab">
									<h4>@Model.ProductDetail.Brand.BrandName</h4>
									<img src="~/media/brands/@Model.ProductDetail.Brand.Image" width="120" height="100" />
									<p>@Html.Raw(@Model.ProductDetail.Brand.Description);</p>
                                </div>
                   

                                <div class="tab-pane" id="nav-brand" role="tabpanel" aria-labelledby="nav-brand-tab">
									<h4>@Model.ProductDetail.Category.CategoryName</h4>
									<img src="~/media/categories/@Model.ProductDetail.Category.Image" width="120" height="100" />
									<p>@Html.Raw(@Model.ProductDetail.Category.Description);</p>
                                </div>
                        </div>
                    </div>
						<h4>List feedback</h4>
						<p> <b>Average Point:</b> @Model.Point </p>
                        <div class="tab-pane" id="nav-mission" role="tabpanel" aria-labelledby="nav-mission-tab">
							@foreach (var item in Model.listRating)
							{
								<div class="d-flex">
									<img src="~/media/avatar/@item.User.Avatar" class="img-fluid rounded-circle p-3" style="width: 100px; height: 100px;" alt="">
									<div class="">
										<p class="mb-2" style="font-size: 14px;">@item.RatingDateTime?.ToShortDateString()</p>
										<h5>@item.User.UserName</h5>
										<p> Point: @item.Star </p>
										<div class="d-flex justify-content-between">
											<div class="d-flex mb-3">
												<i class="@( item.Star >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( item.Star >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( item.Star >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( item.Star >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( item.Star >= 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
											</div>
										</div>
										<p>@Html.Raw(@item.Comment)</p>
									</div>
								</div>
								<br/>
							}
							@if (ViewBag.pagingmodel != null)
							{
								<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
							}
							
                        </div>
						@if (User.Identity?.IsAuthenticated ?? false)
						{
							<h4>Your feekback</h4>
							@if (Model.IsOrder)
							{
								@if (Model.IsFeedback)
								{
									
								
								<div class="d-flex">
									<img src="~/media/avatar/@Model.Feedback.User.Avatar" class="img-fluid rounded-circle p-3" style="width: 100px; height: 100px;" alt="">
									<div class="">
										<p class="mb-2" style="font-size: 14px;">@Model.Feedback.RatingDateTime?.ToShortDateString()</p>
										<div class="d-flex justify-content-between">
											<h5>@Model.Feedback.User.UserName</h5>
											<p> Point: @Model.Feedback.Star </p>
											<div class="d-flex mb-3">										
												<i class="@( Model.Feedback.Star >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
												<i class="@( Model.Feedback.Star >= 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
											</div>
										</div>
										<p class="text-dark">
											@Model.Feedback.Comment
										</p>
									</div>
								</div>
									<br />
								}
								else
								{
									<form autocomplete="off" asp-action="CommentProduct" asp-controller="Rating" method="post">
										<div asp-validation-summary="ModelOnly" class="text-danger"></div>
										<h4 class="mb-5 fw-bold">Leave a Reply</h4>
										<div class="row g-4">
											<div class="col-lg-6">
												<div class="border-bottom rounded">
													<input type="hidden" name="ProductId" asp-for="@Model.Feedback.ProductId" value="@Model.ProductDetail.Id" />
													<input name="Star" asp-for="@Model.Feedback.Star" type="number" min="1" max="5" step="1" value="5" class="form-control border-0 me-4" placeholder="Please rate" />
												</div>
											</div>
	
											<div class="col-lg-12">
												<div class="border-bottom rounded my-4">
													<textarea asp-for="@Model.Feedback.Comment" name="Comment" placeholder="Enter your review" class="form-control border-0" cols="30" rows="8" placeholder="Your Review *" spellcheck="false"></textarea>
													<span asp-validation-for="@Model.Feedback.Comment" class="text-danger"></span>
												</div>
											</div>
											<div class="col-lg-12">
												<div class="d-flex justify-content-between py-3 mb-5">
													<div class="d-flex align-items-center">
													</div>
													<button type="submit" class="btn border border-secondary text-primary rounded-pill px-4 py-3">
														Submit
													</button>
												</div>
											</div>
										</div>
									</form>
								}
							}
							else
							{
								<p>You have not purchased this product yet.</p>
							}
						}



                </div>
            </div>
          
        </div>
        <h1 class="fw-bold mb-0">Related products</h1>


  

        <div class="vesitable">
            <div class="owl-carousel vegetable-carousel justify-content-center">
                @if (ViewBag.relatedProducts != null)
                {
						@foreach (var relatedProduct in ViewBag.relatedProducts as IEnumerable<ProductViewModel>)
                    {
                        <div class="border border-primary rounded position-relative vesitable-item">
                            <div class="vesitable-img">
									<a asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@relatedProduct.Id" title="Product Title">
										<img src="~/media/products/@relatedProduct.Image" class="img-fluid w-100 rounded-top" alt="">
									</a>
                            </div>
                                <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; right: 10px;">@relatedProduct.BrandName</div>
                            <div class="p-4 pb-0 rounded-bottom">
                                <h4>@relatedProduct.ProductName</h4>
									<span class="qty">Point</span><span class="rating"> @relatedProduct.AveragePoint</span>
									<div class="d-flex mb-2">
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 1 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 2 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 3 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 4 ? "text-primary " :  "")"></i>
										<i class="fa fa-star @( relatedProduct.AveragePoint >= 5 ? "text-primary " :  "")"></i>
									</div>
                                <p></p>
                                <div class="d-flex justify-content-between flex-lg-wrap">
                                        <p class="text-dark fs-5 fw-bold">@relatedProduct.Price.ToString("#,##0 VND")</p>
										@if (relatedProduct.Stock > 0)
										{
											<button class="btn border border-secondary rounded-pill px-3 py-1 mb-4 text-primary add-to-cart" data-product_id="@relatedProduct.Id"><i class="fa fa-shopping-bag me-2 text-primary"></i>Add to Cart</button>
							
										}
										else
										{
											<button class="btn btn-primary add-to-cart">Out Of Order</button>
										}
 
	
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>

    <div class="container-fluid ">
        <div class="row">
            <div class="col-md-12">

                <div class="section-header d-flex justify-content-between">

						<h2 class="section-title">Recently Viewed products</h2>

                    <div class="d-flex align-items-center">
                        <div class="swiper-buttons">
                            <button class="swiper-prev products-carousel-prev btn btn-primary">❮</button>
                            <button class="swiper-next products-carousel-next btn btn-primary">❯</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">

                <div class="products-carousel swiper">
                    <div class="swiper-wrapper">
						@foreach (var item in ViewBag.recentlyViewedProducts as IEnumerable<ProductViewModel>)
                        {
                            <div class="product-item swiper-slide">
                                @if (User.Identity?.IsAuthenticated ?? false)
                                {
                                    <a data-product_id="@item.Id" class="btn-compare add-btn-compare">
                                        <i class="fas fa-retweet"></i>
                                    </a>
                                    <a data-product_id="@item.Id" class="btn-wishlist add-btn-wishlist">
                                        <i class="far fa-heart"></i>
                                    </a>
                                }
                                <figure>
									<a asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@item.Id" title="Product Title">
                                        <img src="~/media/products/@item.Image" class="tab-image">
                                    </a>
                                </figure>
                                <h3>@item.ProductName</h3>
								<span class="qty">Point</span><span class="rating"> @item.AveragePoint</span>
								<div class="d-flex mb-2">
									<i class="fa fa-star @( item.AveragePoint >= 1 ? "text-primary " :  "")"></i>
									<i class="fa fa-star @( item.AveragePoint >= 2 ? "text-primary " :  "")"></i>
									<i class="fa fa-star @( item.AveragePoint >= 3 ? "text-primary " :  "")"></i>
									<i class="fa fa-star @( item.AveragePoint >= 4 ? "text-primary " :  "")"></i>
									<i class="fa fa-star @( item.AveragePoint >= 5 ? "text-primary " :  "")"></i>
								</div>
                                <span class="price">@item.Price.ToString("#,##0 VND")</span>
                                <span class="qty">@item.BrandName</span><br />
                                <span class="qty">@item.CategoryName</span>
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="input-group product-qty">
                                        <span class="input-group-btn">
                                            <button type="button" class="quantity-left-minus btn btn-danger btn-number" data-type="minus">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                        </span>
											<input type="text" id="quantity" name="quantity" class="form-control input-number" min="1" value="1" max="10" step="1" readonly>
                                        <span class="input-group-btn">
                                            <button type="button" class="quantity-right-plus btn btn-success btn-number" data-type="plus">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </span>
                                    </div>
                                    @if (item.Stock > 0)
                                    {
                                        <button class="btn btn-primary add-to-cart" data-product_id="@item.Id">Add to Cart</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary add-to-cart">Out Of Order</button>
                                    }
                                </div>
                            </div>
                        }


                    </div>
                </div>
                <!-- / products-carousel -->

            </div>
        </div>
    </div>
</div>
<!-- Single Product End -->



</section>









