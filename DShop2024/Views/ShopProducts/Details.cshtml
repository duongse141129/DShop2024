@using DShop2024.ViewModels
@model ProductDetailViewModel
@{
	ViewData["Title"] = "Detail";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<section class="py-5">
	<!-- Single Product Start -->
	<div class="container-fluid mt-2">
			<div class="container py-5 bg-shop rounded-2">
				<div class="row g-4 mb-5">
					 <div class="col-lg-4 col-xl-3">
						 <partial name="_SidebarPartial" />             
					 </div>
					<div class="col-lg-8 col-xl-9">
						<div class="row g-4">
                  
							<div class="col-lg-7">
									<div id="content-wrapper">
										<div class="column">
											<div class="main-img-container">
												<img id="featured" src="~/media/products/@Model.ProductDetail.MainImage" >
											</div>

											<div id="slide-wrapper">
												<img id="slideLeft" class="arrow" src="~/img/arrow-left.png">

												<div id="slider">
													<img class="thumbnail active" src="~/media/products/@Model.ProductDetail.MainImage">
													@foreach (var item in Model.ExistingImages)
													{
														<img class="thumbnail" src="~/@item" class="img-fluid rounded">
													}
												</div>

												<img id="slideRight" class="arrow" src="~/img/arrow-right.png">
											</div>
										</div>

									</div>
   
								<div class="py-2">
										@if (User.Identity?.IsAuthenticated ?? false)
										{
											<ul class="nav nav-pills nav-justified">
												<li>
													@if (!Model.IsInWishlist)
													{
														<button class="btn btn-danger add-btn-detail-wishlist" data-product_id="@Model.ProductDetail.Id"><i class="far fa-heart"></i>Add to Wishlist</button>
													}

												</li>
												<li>
													@if (!Model.IsInCompare)
													{
														<button class="btn btn-info add-btn-detail-compare" data-product_id="@Model.ProductDetail.Id">	<i class="fas fa-retweet"></i>Add to Compare</button>
													}
												</li>
											</ul>
										}
								</div>


							</div>


						<div class="col-lg-5 product-detail-section">
							<h2 class="fw-bold mb-1">@Model.ProductDetail.ProductName</h2>

							<div class="custom-badge-group">
								<span class="custom-badge">@Model.ProductDetail.Category.CategoryName</span>
								<span class="custom-badge">@Model.ProductDetail.Brand.BrandName</span>
							</div>

							<div class="product-price-row">
								<span class="price-text">@Model.ProductDetail.Price.ToString("#,##0 VND")</span>
								<div class="text-end">
									<div class="rating-stars">
										<i class="@( Model.Point >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
										<i class="@( Model.Point >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
										<i class="@( Model.Point >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
										<i class="@( Model.Point >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
										<i class="@( Model.Point == 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
									</div>
									<small class="text-muted">(@Model.Point.ToString("#.##") points)</small>
								</div>
							</div>

							<hr style="border-top: 1px solid #eee; margin: 20px 0;">

							<div class="specs-grid">
								<div class="spec-item">
									<span class="spec-label">Dimension</span>
									<span class="spec-value">@Model.ProductDetail.Dimension CM</span>
								</div>
								<div class="spec-item">
									<span class="spec-label">Capacity</span>
									<span class="spec-value">@Model.ProductDetail.Capacity L</span>
								</div>
								<div class="spec-item">
									<span class="spec-label">Weight</span>
									<span class="spec-value">@Model.ProductDetail.Weight KG</span>
								</div>
								<div class="spec-item">
									<span class="spec-label">Main Pockets</span>
									<span class="spec-value">@Model.ProductDetail.MainPocket</span>
								</div>
								<div class="spec-item" style="grid-column: span 2;">
									<span class="spec-label fw-bold"><i class="fas fa-layer-group me-1"></i> Material</span>
									<span class="spec-value">@Model.ProductDetail.Material</span>
								</div>
							</div>

							<div class="feature-pills">
								@if (Model.ProductDetail.LaptopPocket != null)
								{
									<div class="feature-pill">
										<i class="fas fa-laptop"></i> @Model.ProductDetail.LaptopPocket" Pocket
									</div>
								}
								@if (Model.ProductDetail.WaterResistance == true)
								{
									<div class="feature-pill">
										<i class="fas fa-tint"></i> Water Resistant
									</div>
								}
								@if (Model.ProductDetail.USBChargingPort == true)
								{
									<div class="feature-pill">
										<i class="fab fa-usb"></i> USB Port
									</div>
								}
							</div>

							<form asp-area="" asp-action="AddQuantityToCart" asp-controller="Cart" method="post" id="form-detail-@Model.ProductDetail.Id">
								<div class="d-flex align-items-center justify-content-between">
									<input type="hidden" class="form-control input-number" name="productId" value="@Model.ProductDetail.Id">
									<div class="product-qty">
										<div class="quantity-box">
											<button type="button" class="quantity-left-minus buttonQuantityMinus "><i class="fas fa-minus"></i></button>
											<input type="text" id="quantity" name="quantity" value="1" class=" quantityDetail quantity-input" readonly>
											<button type="button" class="quantity-right-plus buttonQuantityPlus "><i class="fas fa-plus"></i></button>
										</div>
									</div>
								</div>
							</form>
							<button class="btn-add-cart add-to-cart-quantity-form mt-3" id="detail-@Model.ProductDetail.Id">
								<i class="fas fa-cart-plus"></i> Add to Cart
							</button>

						</div>


						<div class="card col-lg-12 border-0 shadow-sm p-3">

							<nav>
								<div class="nav nav-tabs custom-product-tabs mb-3" role="tablist">
									<button class="nav-link active" type="button" role="tab"
											id="nav-about-tab" data-bs-toggle="tab" data-bs-target="#nav-about">
										Description
									</button>
									<button class="nav-link" type="button" role="tab"
											id="nav-category-tab" data-bs-toggle="tab" data-bs-target="#nav-category">
										Category
									</button>
									<button class="nav-link" type="button" role="tab"
											id="nav-brand-tab" data-bs-toggle="tab" data-bs-target="#nav-brand">
										Brand
									</button>
								</div>
							</nav>

							<div class="tab-content px-2" id="nav-tabContent">
								<div class="tab-pane fade show active" id="nav-about" role="tabpanel" aria-labelledby="nav-about-tab">
									@Html.Raw(@Model.ProductDetail.Description)
								</div>

								<div class="tab-pane fade" id="nav-category" role="tabpanel" aria-labelledby="nav-category-tab">
									<div class="d-flex align-items-center mb-3">
										<img src="~/media/brands/@Model.ProductDetail.Brand.Image" width="80" class="me-3 rounded border" />
										<h4 class="mb-0">@Model.ProductDetail.Brand.BrandName</h4>
									</div>
									<div class="text-muted">@Html.Raw(@Model.ProductDetail.Brand.Description)</div>
								</div>

								<div class="tab-pane fade" id="nav-brand" role="tabpanel" aria-labelledby="nav-brand-tab">
									<div class="d-flex align-items-center mb-3">
										<img src="~/media/categories/@Model.ProductDetail.Category.Image" width="80" class="me-3 rounded border" />
										<h4 class="mb-0">@Model.ProductDetail.Category.CategoryName</h4>
									</div>
									<div class="text-muted">@Html.Raw(@Model.ProductDetail.Category.Description)</div>
								</div>
							</div>
						</div>

							<div class="ratings-container">
							<h1 class="fw-bold mb-0 text-primary">Product ratings and feedbacks</h1>
								<span> <strong>Product rating:</strong> @Model.Point </span>
								<div id="feedback-section-container">
									<partial name="_FeedbackListPartial" model="Model" />
								</div>

								@if (User.Identity?.IsAuthenticated ?? false)
								{
									<h4 class="mt-3">Your feedback</h4>
									@if (Model.IsOrder)
									{
										@if (Model.IsFeedback)
										{
											<div class="card col-md-8 mt-2">
												<div class="row pb-2 mt-2 me-4 ms-2">
													<div class="col-sm-3 ">
														<div class="user-avatar-wrapper">
															<img src="~/media/avatar/@Model.Feedback.User.Avatar" width="100" height="100" alt="Avatar">
														</div>
													</div>
													<div class="col-md-9">
														<ul class="sinlge-post-meta">
															<li><i class="fa fa-user"></i>@Model.Feedback.User.UserName</li>
															<li><i class="far fa-clock"></i>@Model.Feedback.RatingDateTime?.ToShortTimeString()</li>
															<li><i class="fa fa-calendar"></i>@Model.Feedback.RatingDateTime?.ToShortDateString()</li>
														</ul>
														<div class="d-flex justify-content-between">
															<div class="d-flex mb-2">
																<i class="@( Model.Feedback.Star >= 1 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
																<i class="@( Model.Feedback.Star >= 2 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
																<i class="@( Model.Feedback.Star >= 3 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
																<i class="@( Model.Feedback.Star >= 4 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
																<i class="@( Model.Feedback.Star >= 5 ? "fa fa-star text-primary " :  "fa fa-star")"></i>
															</div>
														</div>
														<p>@Model.Feedback.Comment</p>

													</div>
													@if (Model.Feedback.ReplyMessage != null)
													{
														<div class="shop-response">
															<strong><i class="fas fa-reply me-2"></i>Response from Shop</strong>
															<p class="mb-0">@Model.Feedback.ReplyMessage</p>
														</div>
													}
												</div>
											</div>
											<br />
										}
										else
										{

											<div class="feedback-form-card shadow-sm col-sm-10">
												<form autocomplete="off" asp-action="CommentProduct" asp-controller="Rating" method="post">
													<div asp-validation-summary="ModelOnly" class="text-danger"></div>
													<h4 class="mb-4 fw-bold">Leave a Reply</h4>
													<div class="row g-3">
														<div class="col-md-4">
															<div class="form-group">
																<label class="mb-2 fw-bold">Star Rating (1-5)</label>
																<input type="hidden" name="ProductId" asp-for="@Model.Feedback.ProductId" value="@Model.ProductDetail.Id" />
																<input type="number" name="Star" asp-for="@Model.Feedback.Star" min="1" max="5" value="5" class="form-control rounded-pill border-light bg-light" />
															</div>
														</div>
														<div class="col-12">
															<div class="form-group">
																<label class="mb-2 fw-bold">Your Comment</label>
																<textarea rows="4" name="Comment" asp-for="@Model.Feedback.Comment" class="form-control border-light bg-light shadow-none" style="border-radius: 15px;"></textarea>
															</div>
														</div>
														<div class="col-12 text-end">
															<button type="submit" class="btn btn-submit-feedback text-white">
																Submit Feedback <i class="fas fa-paper-plane ms-2"></i>
															</button>
														</div>
													</div>
												</form>
											</div>
										}
									}
									else
									{
										<div class="alert alert-light border shadow-sm rounded-pill px-4">
											<i class="fas fa-info-circle me-2 text-primary"></i> You have not purchased this product yet.
										</div>
									}
								}

							</div>
						</div>
					</div>
          
				</div>
				<h1 class="fw-bold mb-0 text-primary">Related products</h1>

				<div class="vesitable">
					<div class="owl-carousel vegetable-carousel justify-content-center">
						@if (ViewBag.relatedProducts != null)
						{
							@foreach (var relatedProduct in ViewBag.relatedProducts as IEnumerable<ProductViewModel>)
							{
								<div class="border border-primary rounded position-relative vesitable-item">
									<div class="vesitable-img">
											<a asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@relatedProduct.Id" title="Product Title">
												<img src="~/media/products/@relatedProduct.MainImage" class="img-fluid w-100 rounded-top" alt="" style="height : 300px">
											</a>
									</div>
										<div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; right: 10px;">@relatedProduct.BrandName</div>
									<div class="p-4 pb-0 rounded-bottom">
										<h4>@relatedProduct.ProductName</h4>
											<span class="qty">Point</span><span class="rating"> @relatedProduct.AveragePoint.ToString("#.##")</span>
											<div class="d-flex mb-2">
												<i class="fa fa-star @( relatedProduct.AveragePoint >= 1 ? "text-primary " :  "")"></i>
												<i class="fa fa-star @( relatedProduct.AveragePoint >= 2 ? "text-primary " :  "")"></i>
												<i class="fa fa-star @( relatedProduct.AveragePoint >= 3 ? "text-primary " :  "")"></i>
												<i class="fa fa-star @( relatedProduct.AveragePoint >= 4 ? "text-primary " :  "")"></i>
												<i class="fa fa-star @( relatedProduct.AveragePoint >= 5 ? "text-primary " :  "")"></i>
											</div>
											<p class="text-dark fs-5 fw-bold">@relatedProduct.Price.ToString("#,##0 VND")</p>
											<form asp-area="" asp-action="AddQuantityToCart" asp-controller="Cart" method="post" id="form-related-@relatedProduct.Id">
												<input type="hidden" class="form-control input-number" name="productId" value="@relatedProduct.Id">
												<input type="hidden" id="quantity" name="quantity" class="input-number" value="1">
											</form>								
												<div class="d-flex justify-content-between flex-lg-wrap my-2">
														<button class="btn btn-primary btn-md add-to-cart-quantity-form " id="related-@relatedProduct.Id">
															<i class="fas fa-cart-plus"></i> Add to Cart
														</button>
														@if (User.Identity?.IsAuthenticated ?? false)
														{
															<a data-product_id="@relatedProduct.Id" class="btn-compare add-btn-compare relatedCompare">
																<i class="fas fa-retweet"></i>
															</a>
															<a data-product_id="@relatedProduct.Id" class="btn-wishlist add-btn-wishlist relatedWishlist">
																<i class="far fa-heart"></i>
															</a>
														}
												</div>
									

									</div>
								</div>
							}
						}
					</div>
				</div>

   

			<div class="container-fluid">
					@await Component.InvokeAsync("RecentlyViewedProduct")
			</div>
		</div>
	</div>
	<!-- Single Product End -->

</section>


@section Scripts {
	<link href="~/custom/css/gallery.css" rel="stylesheet" />
	<script type="text/javascript" src="~/custom/js/gallery.js"></script>
	<script>
		$(document).on("click", ".add-to-cart-quantity", function () {
			const productId = $(this).data("product-id");
			const quantity = $(this)
				.closest(".product-item")
				.find(".quantity-input")
				.val();

			$.ajax({
				type: "POST",
				url: "@Url.Action("AddQuantityToCart", "Cart")",
				data: {
					productId: productId,
					quantity: quantity
				},
				success: function (result) {
					if (result.success) {
						Swal.fire({
							position: "top-end",
							icon: "success",
							title: result.message,
							showConfirmButton: false,
							timer: 800
						});
						loadQuantityCart();
					} else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
					}
				}
			});
		});
	</script>
	<script>
		$(document).ready(function () {
			$('.add-to-cart-quantity-form').click(function () {
				var formId  ="form-"+ $(this).attr('id');
				console.log(formId);
				var form = document.getElementById(formId);
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddQuantityToCart", "Cart")",
					data: new FormData(form),
					contentType: false,
					processData: false,
					success: function (result) {
						if (result.success) {
						   loadQuantityCart();
						   Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>
	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-detail-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
							$('.add-btn-detail-wishlist').hide();
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}
					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-detail-compare').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
							$('.add-btn-detail-compare').hide();
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}
					}
				});
			});
		});
	</script>

	<script>
		function loadQuantityCart() {
			$('#cartQuantity').load("/AjaxContent/QuantityCart");
		}
	</script>

	<script>
		$(document).on("click", "#feedback-section-container .ajax-pagination a", function (e) {
			e.preventDefault();
			var url = $(this).attr("href");
			if (!url || url === "#") return;
			$.ajax({
				url: url,
				type: 'GET',
				headers: { "X-Requested-With": "XMLHttpRequest" },
				success: function (data) {
					$('#feedback-section-container').html(data);
				},
				error: function () {
					Swal.fire({
						icon: "error",
						title: "Error",
						text: "Could not load feedback. Please try again."
					});
				}
			});
		});
	</script>

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
