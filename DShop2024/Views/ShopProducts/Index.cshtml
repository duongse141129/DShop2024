@model ShopProductViewModel
@{
	ViewData["Title"] = "Shopping Page";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid fruite py-5">
	<div class="container py-5 ws">
		<h1 class="mb-4">@ViewData["Title"] </h1>
		<div class="row g-4">
			<div class="col-lg-12">
				<partial name="_FilterProductsPartial" model="Model" />
				<div class="row g-4">
					<div class="col-lg-3">
						<div id="sidebar-container">
							<div class="row g-4">
								<div class="col-lg-12">
									<div class="mb-3">
										<h4>Brands</h4>
										@await Component.InvokeAsync("Brand", new { selectedBrands = Model.Filter.BrandSlugs })
									</div>
								</div>
								<div class="col-lg-12">
									<div class="mb-3">
										<h4>Categories</h4>
										@await Component.InvokeAsync("Category", new { selectedCategory = Model.Filter.CategorySlug })
									</div>
								</div>
							</div>

						</div>
					</div>

					<div class="col-lg-9">

						<div class="tab-content" id="product-list-container">
							<div class="tab-pane fade show active" id="nav-all" role="tabpanel" aria-labelledby="nav-all-tab">
								<div id="product-list-container">
									<partial name="_ListFilterProductPartial" model="Model" />
								</div>
                            </div>
                        </div>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>
<!-- Fruits Shop End-->
<div class="container-fluid ">
	@await Component.InvokeAsync("FavouriteProduct")
</div>
<div class="container-fluid ">
	@await Component.InvokeAsync("RecentlyViewedProduct")
</div>
<div class="container-fluid " id="recommend-product-placeholder">
	@await Component.InvokeAsync("RecommendProduct")
</div>



@section Scripts {
	<script src="~/lib/jqueryui/jquery-ui.min.js"></script>
	<script src="~/lib/jqueryui/jquery-ui.js"></script>

	<script>

		$(document).ready(function () {
				function filterProducts() {
					$("#StartPrice").val($("#slider-range").slider("values", 0));
					$("#EndPrice").val($("#slider-range").slider("values", 1));
					var formData = $(".input-filter-product, select[name='SortByList']").serializeArray();


					$(".input-filter-product[type='checkbox']").each(function() {
						if (!this.checked) {
							formData.push({ name: this.name, value: "false" });
						}
					});

					$.ajax({
						url: '@Url.Action("Index", "ShopProducts")',
						type: 'GET',
						data: $.param(formData),
						success: function (result) {
							$("#product-list-container .tab-pane").html(result);
						}
					});
				}

			$(document).on("change", ".input-filter-product, select[name='SortByList']", function () {
				filterProducts();
			});

			let timer;
			$("input[name='SearchName']").on("keyup", function () {
				clearTimeout(timer);
				timer = setTimeout(filterProducts, 500);
			});

			$("#slider-range").on("slidestop", function (event, ui) {
				filterProducts();
			});

		});
	</script>
	<script>
		$(document).ready(function () {
			function loadProducts(url, data = null) {
				$.ajax({
					url: url,
					type: 'GET',
					data: data,
					success: function (result) {
						$("#product-list-container .tab-pane").html(result);
					}
				});
			}

			$(document).on("change", ".input-filter-product, select[name='SortByList']", function () {
				var formData = $(".input-filter-product, select[name='SortByList']").serialize();
				loadProducts('@Url.Action("Index", "ShopProducts")', formData);
			});

			$(document).on("click", ".ajax-pagination a", function (e) {
				e.preventDefault(); 
				var url = $(this).attr("href");
				if (url && url !== "#") {
					loadProducts(url);
				}
			});
		});
	</script>
	<script>
		$(document).on("click", ".add-to-cart-quantity", function () {
			const productId = $(this).data("product-id");
			const quantity = $(this)
				.closest(".product-item")
				.find(".quantity-input")
				.val();

			$.ajax({
				type: "POST",
				url: "@Url.Action("AddQuantityToCart", "Cart")",
				data: {
					productId: productId,
					quantity: quantity
				},
				success: function (result) {
					if (result.success) {
						Swal.fire({
							position: "top-end",
							icon: "success",
							title: result.message,
							showConfirmButton: false,
							timer: 800
						});
						loadQuantityCart();
					} else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
					}
				}
			});
		});
	</script>


	<script>
		$(document).ready(function () {
			$(function () {
				$("#slider-range").slider({
					range: true,
					step: 50000,
					min: 0,
					max: 2000000,
					values: [@Model.Filter.StartPrice , @Model.Filter.EndPrice],
					slide: function (event, ui) {
						$("#amount").val(
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[0])
							+ " - " +
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[1]));
					}
				});
				$("#amount").val(
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 0))
					+ " - " +
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 1)));
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});

			$('.btn-locgia').on('click', function () {
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>
	<script>
		function loadQuantityCart() {
			$('#cartQuantity').load("/AjaxContent/QuantityCart");
		}
	</script>

}