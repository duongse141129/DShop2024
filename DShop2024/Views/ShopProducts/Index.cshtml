@using DShop2024.ViewModels
@model IEnumerable<ProductViewModel>
@{
	ViewData["Title"] = "Shopping Page";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Fruits Shop Start-->
<div class="container-fluid fruite py-5">
    <div class="container py-5 ws">
		<h1 class="mb-4">@ViewData["Title"] </h1>
        <div class="row g-4">
            <div class="col-lg-12">
				<form asp-action="Index" asp-controller="ShopProducts">
                    <partial name="_FilterProductsPartial" />
                </form>

                <div class="row g-4">
                    <div class="col-lg-3">
						<partial name="_SidebarPartial" />
                    </div>
                    <div class="col-lg-9">
                        <div class="tab-content" id="nav-tabContent">
                            <div class="tab-pane fade show active" id="nav-all" role="tabpanel" aria-labelledby="nav-all-tab">

                                <div class="product-grid row row-cols-1 row-cols-sm-2 row-cols-md-3 ">
                                    @foreach (var item in Model)
                                    {
                                        <div class="col">
                                            <div class="product-item">
												@if (User.Identity?.IsAuthenticated ?? false)
												{
													<a data-product_id="@item.Id" class="btn-compare add-btn-compare">
														<i class="fas fa-retweet"></i>
													</a>
													<a data-product_id="@item.Id" class="btn-wishlist add-btn-wishlist">
														<i class="far fa-heart"></i>
													</a>
												}
                                                <figure>
													<a asp-action="Details" asp-controller="ShopProducts" asp-route-Id="@item.Id" title="Product Title">

														<img src="~/media/products/@item.MainImage" class="img-fluid product-mainImage" >
                                                    </a>
                                                </figure>
                                                <h3>@item.ProductName</h3>
												<span class="qty">Point</span><span class="rating"> @item.AveragePoint.ToString("#.##")</span>
												<div class="d-flex mb-2">
													<i class="fa fa-star @( item.AveragePoint >= 1 ? "text-primary " :  "")"></i>
													<i class="fa fa-star @( item.AveragePoint >= 2 ? "text-primary " :  "")"></i>
													<i class="fa fa-star @( item.AveragePoint >= 3 ? "text-primary " :  "")"></i>
													<i class="fa fa-star @( item.AveragePoint >= 4 ? "text-primary " :  "")"></i>
													<i class="fa fa-star @( item.AveragePoint >= 5 ? "text-primary " :  "")"></i>
												</div>
                                                <span class="price">@item.Price.ToString("#,##0 VND")</span>
                                                <span class="qty">@item.BrandName</span><br />
                                                <span class="qty">@item.CategoryName</span>
												<form asp-area="" asp-action="AddQuantityToCart" asp-controller="Cart" method="post" id="form-shop-@item.Id">
													<div class="d-flex align-items-center justify-content-between">
														<input type="hidden" class="form-control input-number" name="productId" value="@item.Id">
														<div class="input-group product-qty">
															<span class="input-group-btn">
																<button type="button" class="quantity-left-minus btn btn-danger btn-number" data-type="minus">
																	<i class="fas fa-minus"></i>
																</button>
															</span>
															<input type="text" id="quantity" name="quantity" class="form-control input-number" value="1" min="1" step="1">

															<span class="input-group-btn">
																<button type="button" class="quantity-right-plus btn btn-success btn-number" data-type="plus">
																	<i class="fas fa-plus"></i>
																</button>
															</span>
														</div>
													</div>
												</form>
												<button class="btn btn-primary btn-md add-to-cart-quantity " id="shop-@item.Id">
													<i class="fas fa-cart-plus"></i> Add to Cart
												</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <!-- / product-grid -->
								<partial name="_PagingPartial" model="@ViewBag.pagingmodel" />
                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Fruits Shop End-->
<div class="container-fluid ">
	@await Component.InvokeAsync("FavouriteProduct")
</div>

<div class="container-fluid ">
	@await Component.InvokeAsync("RecommendProduct")
</div>

<div class="container-fluid ">
	@await Component.InvokeAsync("RecentlyViewedProduct")
</div>

@section Scripts {
	<script src="~/lib/jqueryui/jquery-ui.min.js"></script>
    <script src="~/lib/jqueryui/jquery-ui.js"></script>
	<script>
		$(document).ready(function () {
			$('.add-to-cart-quantity').click(function () {
				var formId  ="form-"+ $(this).attr('id');
				console.log(formId);
				var formP = document.getElementById(formId);
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddQuantityToCart", "Cart")",
					data: new FormData(formP),
					contentType: false,
					processData: false,
					success: function (result) {
						if (result.success) {
						   Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
							loadQuantityCart();
						}
						else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$(function () {
				$("#slider-range").slider({
					range: true,
					step: 50000,
					min: 0,
					max: 2000000,
					// values: [100000, 300000],
					values: [@(ViewBag.startprice != "" ? ViewBag.startprice : 50000) , @(ViewBag.endPrice != "" ? ViewBag.endPrice : 800000)],
					slide: function (event, ui) {
						$("#amount").val(
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[0])
							+ " - " +
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[1]));
					}
				});
				$("#amount").val(
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 0))
					+ " - " +
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 1)));
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});

			$('.btn-locgia').on('click', function () {
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>
	<script>
		function loadQuantityCart() {
			$('#cartQuantity').load("/AjaxContent/QuantityCart");
		}
	</script>

}