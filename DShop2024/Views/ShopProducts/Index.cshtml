@model ShopProductViewModel
@{
	ViewData["Title"] = "Shopping Page";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid fruite py-5">
	<div class="container py-5 bg-shop rounded-2">
		<h1 class="mb-4">@ViewData["Title"] </h1>
		<div class="row g-4">
			<div class="col-lg-12">
				<partial name="_FilterProductPartial" model="Model" />
				<div class="row g-4 mt-3">
					<div class="col-lg-3">
						<div id="sidebar-container">
							<div class="sidebar-section">
								<h4>Brands</h4>
									@await Component.InvokeAsync("Brand", new { selectedBrands = Model.Filter.BrandSlugs })
							</div>
							<div class="sidebar-section">
								<h4>Categories</h4>
									@await Component.InvokeAsync("Category", new { selectedCategory = Model.Filter.CategorySlug })
							</div>
						</div>
					</div>

					<div class="col-lg-9">

						<div class="tab-content" id="product-list-container">
							<div class="tab-pane fade show active" id="nav-all" role="tabpanel" aria-labelledby="nav-all-tab">
								<div id="product-list-container">
									<partial name="_ListFilterProductPartial" model="Model" />
								</div>
                            </div>
                        </div>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>
<!-- Fruits Shop End-->
<div class="container-fluid ">
	@await Component.InvokeAsync("FavouriteProduct")
</div>
<div class="container-fluid ">
	@await Component.InvokeAsync("RecentlyViewedProduct")
</div>
<div class="container-fluid " id="recommend-product-placeholder">
	@await Component.InvokeAsync("RecommendProduct")
</div>



@section Scripts {
	<script src="~/lib/jqueryui/jquery-ui.min.js"></script>
	<script src="~/lib/jqueryui/jquery-ui.js"></script>


    <script>
        $(document).ready(function () {           

            function applyFilter(targetUrl = null) {
				$("#StartPrice").val($("#slider-range").slider("values", 0));
				$("#EndPrice").val($("#slider-range").slider("values", 1));

                let url = targetUrl || window.location.pathname;
                
                let formData = $(".input-filter-product, select[name='SortByList']").serialize();

                $.ajax({
                    url: url,
                    type: 'GET',
                    data: formData,
                    beforeSend: function () {
                        $("#product-list-container").css("opacity", "0.5");
                    },
                    success: function (result) {
                        $("#product-list-container").html(result);
                        $("#product-list-container").css("opacity", "1");

                        let newUrl = url + (formData ? "?" + formData : "");
                        window.history.pushState({ path: newUrl }, '', newUrl);
                    },
                    error: function () {
                        alert("Error loading products. Please try again.");
                        $("#product-list-container").css("opacity", "1");
                    }
                });
            }

            $(document).on("change", ".input-filter-product:not([type='text']), select[name='SortByList']", function () {
                applyFilter();
            });

			let searchTimer;
            $(document).on("keyup", "input[name='SearchName']", function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function() {
                    applyFilter();
                }, 500);
            });

			$("#slider-range").on("slidestop", function (event, ui) {
				applyFilter();
			});

            $(document).on("click", ".pagination a", function (e) {
                e.preventDefault();
                let url = $(this).attr("href");
                if (url && url !== "#") {
                    applyFilter(url);
                    
                    $('html, body').animate({ 
                        scrollTop: $("#product-list-container").offset().top - 100 
                    }, 'fast');
                }
            });

            //  Back/Forward buttons
            window.onpopstate = function (e) {
                if (e.state) {
                    location.reload(); 
                }
            };
        });
    </script>

	<script>
		$(document).on("click", ".add-to-cart-quantity", function () {
			const productId = $(this).data("product-id");
			const quantity = $(this)
				.closest(".product-item")
				.find(".quantity-input")
				.val();

			$.ajax({
				type: "POST",
				url: "@Url.Action("AddQuantityToCart", "Cart")",
				data: {
					productId: productId,
					quantity: quantity
				},
				success: function (result) {
					if (result.success) {
						Swal.fire({
							position: "top-end",
							icon: "success",
							title: result.message,
							showConfirmButton: false,
							timer: 800
						});
						loadQuantityCart();
					} else {
						   Swal.fire({
							  icon: "error",
							  title: "Add to cart fail",
							  text: result.message
							});
					}
				}
			});
		});
	</script>


	<script>
		$(document).ready(function () {
			$(function () {
				$("#slider-range").slider({
					range: true,
					step: 50000,
					min: 0,
					max: 3000000,
					values: [@Model.Filter.StartPrice , @Model.Filter.EndPrice],
					slide: function (event, ui) {
						$("#amount").val(
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[0])
							+ " - " +
							new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
								.format(ui.values[1]));
					}
				});
				$("#amount").val(
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 0))
					+ " - " +
					new Intl.NumberFormat('vn-VN', { style: 'currency', currency: 'VND' })
						.format($("#slider-range").slider("values", 1)));
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});

			$('.btn-locgia').on('click', function () {
				$("#startprice").val($("#slider-range").slider("values", 0));
				$("#endPrice").val($("#slider-range").slider("values", 1));
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToWishList", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to wishlist fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				$.ajax({
					type: "POST",
					url: "@Url.Action("AddToCompare", "Home")",
					data: { Id: Id },
					success: function (result) {
						if (result.success) {
							Swal.fire({
							  position: "top-end",
							  icon: "success",
							  title: result.message,
							  showConfirmButton: false,
							  timer: 500
							});
						}
						else {
							Swal.fire({
							  icon: "error",
							  title: "Add to compare fail",
							  text: result.message
							});
						}

					}
				});
			});
		});
	</script>
	<script>
		function loadQuantityCart() {
			$('#cartQuantity').load("/AjaxContent/QuantityCart");
		}
	</script>

}